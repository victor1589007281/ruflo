func repairGoDuplicateTypeDeclsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+([A-Za-z_][A-Za-z0-9_]*) redeclared in this block\s*\n\s+(.+\.go):\d+:\d+:\s+other declaration of ([A-Za-z_][A-Za-z0-9_]*)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type duplicateType struct {
		file string
		line int
		name string
	}
	var duplicates []duplicateType
	for _, m := range matches {
		if m[3] != m[5] {
			continue
		}
		line, _ := strconv.Atoi(m[2])
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || line <= 0 || m[3] == "" {
			continue
		}
		duplicates = append(duplicates, duplicateType{file: file, line: line, name: m[3]})
	}
	if len(duplicates) == 0 {
		return 0
	}
	byFile := map[string][]duplicateType{}
	for _, d := range duplicates {
		byFile[d.file] = append(byFile[d.file], d)
	}
	changed := 0
	var changedFiles []string
	for file, types := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
