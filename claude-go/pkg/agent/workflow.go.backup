		updated := removeTextRanges(data, removals)
		if string(updated) == string(data) {
			continue
		}
		if err := os.WriteFile(file, updated, 0o644); err == nil {
			changed += len(removals)
			changedFiles = append(changedFiles, file)
		}
	}
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func repairGoIfInitUndefinedErrConditionFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+undefined:\s+err\b`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type undefinedErr struct {
		file string
		line int
	}
	var targets []undefinedErr
	for _, m := range matches {
		line, _ := strconv.Atoi(m[2])
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || line <= 0 {
			continue
		}
		targets = append(targets, undefinedErr{file: file, line: line})
	}
	if len(targets) == 0 {
		return 0
	}
	byFile := map[string]map[int]bool{}
	for _, target := range targets {
		if byFile[target.file] == nil {
			byFile[target.file] = map[int]bool{}
		}
		byFile[target.file][target.line] = true
	}
	changed := 0
	var changedFiles []string
	initCond := regexp.MustCompile(`if\s+([^;{}]+,\s*([A-Za-z_][A-Za-z0-9_]*)\s*:=\s*[^;{}]+);\s*err\s*!=\s*nil\s*\{`)
	for file, linesWithErr := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for lineNo := range linesWithErr {
			start := lineNo - 3
			if start < 0 {
				start = 0
			}
			end := lineNo + 2
			if end > len(lines) {
				end = len(lines)
			}
			for i := start; i < end; i++ {
				line := lines[i]
				m := initCond.FindStringSubmatch(line)
				if len(m) < 3 {
					continue
				}
				replacement := "if " + m[1] + "; " + m[2] + " {"
				lines[i] = initCond.ReplaceAllString(line, replacement)
				if lines[i] != line {
					touched = true
				}
			}
		}
		if !touched {
			continue
		}
		updated := strings.Join(lines, "\n")
		if updated == string(data) {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			changedFiles = append(changedFiles, file)
		}
	}
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func repairGoInterfaceSignatureMismatchesFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`wrong type for method\s+([A-Za-z_][A-Za-z0-9_]*)\)\s*\n\s*have\s+([A-Za-z_][A-Za-z0-9_]*)\(([^)]*)\)\s*([^\n]*)\n\s*want\s+([A-Za-z_][A-Za-z0-9_]*)\(([^)]*)\)\s*([^\n]*)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	signatures := map[string]string{}
	for _, m := range matches {
		method := m[1]
		if method == "" || m[2] != method || m[5] != method {
			continue
		}
		result := strings.TrimSpace(m[4])
		sig := method + "(" + strings.TrimSpace(m[3]) + ")"
		if result != "" {
			sig += " " + result
		}
		signatures[method] = sig
	}
	if len(signatures) == 0 {
		return 0
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for i, line := range lines {
			trimmed := strings.TrimSpace(line)
			for method, sig := range signatures {
				if strings.HasPrefix(trimmed, method+"(") {
					lines[i] = leadingWhitespace(line) + sig
					touched = true
				}
			}
		}
		if !touched {
			return nil
		}
		updated := strings.Join(lines, "\n")
		if updated == string(data) {
			return nil
		}
		if err := os.WriteFile(p, []byte(updated), info.Mode()); err == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func repairGoInterfaceMissingMethodsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+[A-Za-z_][A-Za-z0-9_\.]*\.([A-Za-z_][A-Za-z0-9_]*) undefined \(type ([A-Za-z_][A-Za-z0-9_]*) has no field or method ([A-Za-z_][A-Za-z0-9_]*)\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		if m[2] != m[4] {
			continue
		}
		file := resolveGoBuildErrorPath(root, m[1])
		method := m[2]
		typeName := m[3]
		if file == "" || method == "" || typeName == "" {
			continue
		}
		dir := filepath.Dir(file)
		key := dir + "\x00" + typeName + "\x00" + method
		if seen[key] || !goInterfaceExistsInDir(dir, typeName) {
			continue
		}
		seen[key] = true
		if sig := goMethodSignatureInDir(dir, method); sig != "" {
			changed += appendGoMethodToInterfaceInDir(dir, typeName, sig)
		}
	}
	return changed
}

func repairGoInterfaceReturnMissingMethodFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+cannot use .+ \(value of type \*([A-Za-z_][A-Za-z0-9_]*)\) as ([A-Za-z_][A-Za-z0-9_]*) value in return statement: \*[A-Za-z_][A-Za-z0-9_]* does not implement [A-Za-z_][A-Za-z0-9_]* \(missing method ([A-Za-z_][A-Za-z0-9_]*)\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		typeName, ifaceName, method := m[2], m[3], m[4]
		if file == "" || typeName == "" || ifaceName == "" || method == "" {
			continue
		}
		dir := filepath.Dir(file)
		key := dir + "\x00" + typeName + "\x00" + ifaceName + "\x00" + method
		if seen[key] || !goStructExistsInDir(dir, typeName) {
			continue
		}
		seen[key] = true
		if sig := goInterfaceMethodSignatureInDir(dir, ifaceName, method); sig != "" {
			changed += appendGoMethodStubWithSignatureToTypeInDir(dir, typeName, sig)
			continue
		}
		changed += appendGoMethodStubToTypeInDir(dir, typeName, method)
	}
	return changed
}

func repairGoImportedInterfaceReturnMissingMethodFromBuildErrors(root, modulePath, buildErrors string) int {
	if modulePath == "" {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+cannot use .+ \((?:variable|value) of type \*([A-Za-z_][A-Za-z0-9_]*)\) as ([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*) value in return statement: \*[A-Za-z_][A-Za-z0-9_]* does not implement [A-Za-z_][A-Za-z0-9_]*\.[A-Za-z_][A-Za-z0-9_]* \(missing method ([A-Za-z_][A-Za-z0-9_]*)\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		typeName, alias, ifaceName, method := m[2], m[3], m[4], m[5]
		if file == "" || typeName == "" || alias == "" || ifaceName == "" || method == "" {
			continue
		}
		importPath := goImportPathForAlias(file, alias)
		if importPath == "" || !strings.HasPrefix(importPath, modulePath+"/") {
			continue
		}
		rel := strings.TrimPrefix(importPath, modulePath+"/")
		ifaceDir := filepath.Join(root, filepath.FromSlash(rel))
		sig := goInterfaceMethodSignatureInDir(ifaceDir, ifaceName, method)
		if sig == "" {
			continue
		}
		sig = qualifyGoSignatureWithPackageTypes(sig, alias, ifaceDir)
		dir := filepath.Dir(file)
		key := dir + "\x00" + typeName + "\x00" + sig
		if seen[key] || !goStructExistsInDir(dir, typeName) {
			continue
		}
		seen[key] = true
		changed += appendGoMethodStubWithSignatureToTypeInDir(dir, typeName, sig)
	}
	return changed
}

func repairGoImportedInterfaceArgumentMissingMethodFromBuildErrors(root, modulePath, buildErrors string) int {
	if modulePath == "" {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+cannot use .+ \(variable of type \*([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)\) as ([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*) value in argument to [^:]+: \*[A-Za-z_][A-Za-z0-9_]*\.[A-Za-z_][A-Za-z0-9_]* does not implement [A-Za-z_][A-Za-z0-9_]*\.[A-Za-z_][A-Za-z0-9_]* \(missing method ([A-Za-z_][A-Za-z0-9_]*)\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		implAlias, typeName, ifaceAlias, ifaceName, method := m[2], m[3], m[4], m[5], m[6]
		if file == "" || implAlias == "" || typeName == "" || ifaceAlias == "" || ifaceName == "" || method == "" {
			continue
		}
		implDir := goLocalPackageDirForAlias(root, modulePath, file, implAlias)
		ifaceDir := goLocalPackageDirForAlias(root, modulePath, file, ifaceAlias)
		if implDir == "" || ifaceDir == "" {
			continue
		}
		sig := goInterfaceMethodSignatureInDir(ifaceDir, ifaceName, method)
		if sig == "" {
			continue
		}
		sig = qualifyGoSignatureWithPackageTypes(sig, ifaceAlias, ifaceDir)
		key := implDir + "\x00" + typeName + "\x00" + sig
		if seen[key] || !goStructExistsInDir(implDir, typeName) {
			continue
		}
		seen[key] = true
		changed += appendGoMethodStubWithSignatureToTypeInDir(implDir, typeName, sig)
	}
	return changed
}

func repairGoImportedInterfaceMissingMethodsFromBuildErrors(root, modulePath, buildErrors string) int {
	if root == "" || modulePath == "" || !strings.Contains(buildErrors, "has no field or method") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+[A-Za-z_][A-Za-z0-9_\.]*\.([A-Za-z_][A-Za-z0-9_]*) undefined \(type ([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*) has no field or method ([A-Za-z_][A-Za-z0-9_]*)\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		method, alias, typeName, missing := m[2], m[3], m[4], m[5]
		if file == "" || method == "" || method != missing || alias == "" || typeName == "" {
			continue
		}
		importPath := goImportPathForAlias(file, alias)
		if importPath == "" || !strings.HasPrefix(importPath, modulePath+"/") {
			continue
		}
		rel := strings.TrimPrefix(importPath, modulePath+"/")
		dir := filepath.Join(root, filepath.FromSlash(rel))
		key := dir + "\x00" + typeName + "\x00" + method
		if seen[key] || !goInterfaceExistsInDir(dir, typeName) {
			continue
		}
		sig := inferredGoInterfaceMethodSignature(typeName, method)
		if sig == "" {
			continue
		}
		seen[key] = true
		changed += appendGoMethodToInterfaceInDir(dir, typeName, sig)
	}
	return changed
}

func inferredGoInterfaceMethodSignature(typeName, method string) string {
	switch typeName {
	case "TransactionManager":
		switch method {
		case "CurrentTimestamp":
			return "CurrentTimestamp() Timestamp"
		case "IncrementTimestamp":
			return "IncrementTimestamp() Timestamp"
		case "GetLatestVersion":
			return "GetLatestVersion(key Key) (*Record, error)"
		case "ApplyVersion":
			return "ApplyVersion(record *Record) error"
		}
	}
	return ""
}

func goLocalPackageDirForAlias(root, modulePath, file, alias string) string {
	if root == "" || alias == "" {
		return ""
	}
	if importPath := goImportPathForAlias(file, alias); importPath != "" && strings.HasPrefix(importPath, modulePath+"/") {
		return filepath.Join(root, filepath.FromSlash(strings.TrimPrefix(importPath, modulePath+"/")))
	}
	for _, dir := range goDirsByPackageName(root, alias) {
		return dir
	}
	return ""
}

func qualifyGoSignatureWithPackageTypes(signature, alias, dir string) string {
	if signature == "" || alias == "" || dir == "" {
		return signature
	}
	for _, typeName := range goTypeNamesInDir(dir) {
		if typeName == "" || !isExportedGoName(typeName) {
			continue
		}
		re := regexp.MustCompile(`(^|[^A-Za-z0-9_\.])` + regexp.QuoteMeta(typeName) + `\b`)
		signature = re.ReplaceAllString(signature, `${1}`+alias+"."+typeName)
	}
	return signature
}

func goTypeNamesInDir(dir string) []string {
	seen := map[string]bool{}
	for _, file := range goFilesInDir(dir) {
		parsed, parseErr := parser.ParseFile(token.NewFileSet(), file, nil, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.TYPE {
				continue
			}
			for _, spec := range gen.Specs {
				ts, ok := spec.(*ast.TypeSpec)
				if ok && ts.Name != nil && ts.Name.Name != "" {
					seen[ts.Name.Name] = true
				}
			}
		}
	}
	var names []string
	for name := range seen {
		names = append(names, name)
	}
	sort.Strings(names)
	return names
}

func isExportedGoName(name string) bool {
	if name == "" {
		return false
	}
	r := rune(name[0])
	return r >= 'A' && r <= 'Z'
}

func repairGoAliasInterfaceImplementationFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+(?:invalid composite literal type|cannot define new methods on non-local type) ([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	type target struct {
		file  string
		alias string
		name  string
	}
	seen := map[target]bool{}
	var targets []target
	for _, m := range matches {
		targets = append(targets, target{file: resolveGoBuildErrorPath(root, m[1]), alias: m[2], name: m[3]})
	}
	reLocal := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+(?:invalid composite literal type|cannot define new methods on non-local type) ([A-Za-z_][A-Za-z0-9_]*)\b`)
	for _, m := range reLocal.FindAllStringSubmatch(buildErrors, -1) {
		file := resolveGoBuildErrorPath(root, m[1])
		typeName := m[2]
		alias := goAliasImplementationTargetAlias(file, typeName)
		if alias != "" {
			targets = append(targets, target{file: file, alias: alias, name: typeName})
		}
	}
	if len(targets) == 0 {
		return 0
	}
	changed := 0
	for _, t := range targets {
		if t.file == "" || t.alias == "" || t.name == "" || seen[t] {
			continue
		}
		seen[t] = true
		if rewriteGoAliasInterfaceImplementation(t.file, t.alias, t.name) {
			changed++
		}
	}
	return changed
}

func goAliasImplementationTargetAlias(file, typeName string) string {
	if file == "" || typeName == "" {
		return ""
	}
	data, err := os.ReadFile(file)
	if err != nil {
		return ""
	}
	re := regexp.MustCompile(`(?m)^type\s+` + regexp.QuoteMeta(typeName) + `\s*=\s*([A-Za-z_][A-Za-z0-9_]*)\.` + regexp.QuoteMeta(typeName) + `\s*$`)
	if m := re.FindSubmatch(data); len(m) > 1 {
		return string(m[1])
	}
	return ""
}

func rewriteGoAliasInterfaceImplementation(file, alias, typeName string) bool {
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	src := string(data)
	re := regexp.MustCompile(`(?m)^type\s+` + regexp.QuoteMeta(typeName) + `\s*=\s*` + regexp.QuoteMeta(alias) + `\.` + regexp.QuoteMeta(typeName) + `\s*$`)
	loc := re.FindStringIndex(src)
	if loc == nil {
		return false
	}
	fields := inferGoAliasImplementationFields(src, typeName)
	if len(fields) == 0 {
		return false
	}
	replacement := "type " + typeName + " struct {\n" + strings.Join(fields, "\n") + "\n}"
	updated := src[:loc[0]] + replacement + src[loc[1]:]
	if updated == src {
		return false
	}
	if strings.Contains(replacement, "sync.") {
		updated = ensureGoImportInSource(updated, "sync")
	}
	if err := os.WriteFile(file, []byte(updated), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", file).Run()
	return true
}

func repairGoLocalAliasMethodReceiversFromBuildErrors(root, buildErrors string) int {
	reQualified := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+cannot define new methods on non-local type ([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)`)
	reLocal := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+cannot define new methods on non-local type ([A-Za-z_][A-Za-z0-9_]*)\b`)
	type target struct {
		file  string
		alias string
		name  string
	}
	var targets []target
	for _, m := range reQualified.FindAllStringSubmatch(buildErrors, -1) {
		targets = append(targets, target{
			file:  resolveGoBuildErrorPath(root, m[1]),
			alias: m[2],
			name:  m[3],
		})
	}
	for _, m := range reLocal.FindAllStringSubmatch(buildErrors, -1) {
		file := resolveGoBuildErrorPath(root, m[1])
		name := m[2]
		if strings.Contains(name, ".") {
			continue
		}
		if alias := goAliasImplementationTargetAlias(file, name); alias != "" {
			targets = append(targets, target{file: file, alias: alias, name: name})
		}
	}
	changed := 0
	seen := map[target]bool{}
	for _, t := range targets {
		if t.file == "" || t.alias == "" || t.name == "" || seen[t] {
			continue
		}
		seen[t] = true
		if rewriteGoAliasToLocalDefinedType(t.file, t.alias, t.name) {
			changed++
		}
	}
	return changed
}

func rewriteGoAliasToLocalDefinedType(file, alias, typeName string) bool {
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	src := string(data)
	re := regexp.MustCompile(`(?m)^type\s+` + regexp.QuoteMeta(typeName) + `\s*=\s*` + regexp.QuoteMeta(alias) + `\.` + regexp.QuoteMeta(typeName) + `\s*$`)
	updated := re.ReplaceAllString(src, "type "+typeName+" "+alias+"."+typeName)
	if updated == src {
		return false
	}
	if err := os.WriteFile(file, []byte(updated), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", file).Run()
	return true
}

func ensureGoImportInSource(src, importPath string) string {
	if importPath == "" || strings.Contains(src, `"`+importPath+`"`) {
		return src
	}
	reBlock := regexp.MustCompile(`(?m)^import\s*\(\n`)
	if loc := reBlock.FindStringIndex(src); loc != nil {
		return src[:loc[1]] + "\t\"" + importPath + "\"\n" + src[loc[1]:]
	}
	reSingle := regexp.MustCompile(`(?m)^import\s+"([^"]+)"\s*$`)
	if m := reSingle.FindStringSubmatchIndex(src); m != nil {
		existing := src[m[2]:m[3]]
		return src[:m[0]] + "import (\n\t\"" + existing + "\"\n\t\"" + importPath + "\"\n)" + src[m[1]:]
	}
	rePackage := regexp.MustCompile(`(?m)^package\s+[A-Za-z_][A-Za-z0-9_]*\s*$`)
	if loc := rePackage.FindStringIndex(src); loc != nil {
		return src[:loc[1]] + "\n\nimport \"" + importPath + "\"" + src[loc[1]:]
	}
	return src
}

func inferGoAliasImplementationFields(src, typeName string) []string {
	fieldNames := goReceiverFieldNames(src, typeName)
	fieldNames = uniqueTrimmedStrings(append(fieldNames, goCompositeLiteralFieldNames(src, typeName)...))
	if len(fieldNames) == 0 {
		return nil
	}
	var fields []string
	for _, name := range fieldNames {
		if typ := inferGoAliasImplementationFieldType(src, typeName, name); typ != "" {
			fields = append(fields, "\t"+name+" "+typ)
		}
	}
	sort.Strings(fields)
	return fields
}

func goReceiverFieldNames(src, typeName string) []string {
	re := regexp.MustCompile(`(?m)\bfunc\s*\(\s*([A-Za-z_][A-Za-z0-9_]*)\s+\*` + regexp.QuoteMeta(typeName) + `\s*\)[\s\S]*?^}`)
	seen := map[string]bool{}
	for _, m := range re.FindAllStringSubmatch(src, -1) {
		if len(m) < 2 || m[1] == "" {
			continue
		}
		fieldRe := regexp.MustCompile(`\b` + regexp.QuoteMeta(m[1]) + `\.([A-Za-z_][A-Za-z0-9_]*)\b`)
		for _, fm := range fieldRe.FindAllStringSubmatch(m[0], -1) {
			if len(fm) > 1 {
				seen[fm[1]] = true
			}
		}
	}
	var names []string
	for name := range seen {
		names = append(names, name)
	}
	sort.Strings(names)
	return names
}

func goCompositeLiteralFieldNames(src, typeName string) []string {
	re := regexp.MustCompile(`(?:&` + regexp.QuoteMeta(typeName) + `|` + regexp.QuoteMeta(typeName) + `)\s*\{([^}]*)\}`)
	seen := map[string]bool{}
	fieldRe := regexp.MustCompile(`\b([A-Za-z_][A-Za-z0-9_]*)\s*:`)
	for _, m := range re.FindAllStringSubmatch(src, -1) {
		if len(m) < 2 {
			continue
		}
		for _, fm := range fieldRe.FindAllStringSubmatch(m[1], -1) {
			if len(fm) > 1 {
				seen[fm[1]] = true
			}
		}
	}
	var names []string
	for name := range seen {
		names = append(names, name)
	}
	sort.Strings(names)
	return names
}

func inferGoAliasImplementationFieldType(src, typeName, field string) string {
	switch field {
	case "mu", "lock":
		if regexp.MustCompile(`\.` + regexp.QuoteMeta(field) + `\.(RLock|RUnlock)\s*\(`).MatchString(src) {
			return "sync.RWMutex"
		}
		return "sync.Mutex"
	case "closed", "done":
		return "bool"
	case "config":
		return "*storage.EngineConfig"
	case "data":
		return "map[string][]byte"
	case "records":
		if typ := inferGoCompositeMapFieldType(src, typeName, field); typ != "" {
			return typ
		}
		return "map[string]any"
	case "store":
		if typ := inferGoCompositePointerFieldType(src, typeName, field); typ != "" {
			return typ
		}
		return "any"
	case "snapshots":
		return "map[uint64]*snapshot"
	case "nextSnapshotID":
		return "uint64"
	default:
		if strings.HasSuffix(strings.ToLower(field), "id") {
			return "uint64"
		}
		return ""
	}
}

func inferGoCompositeMapFieldType(src, typeName, field string) string {
	re := regexp.MustCompile(regexp.QuoteMeta(field) + `\s*:\s*([A-Za-z_][A-Za-z0-9_]*)`)
	for _, m := range re.FindAllStringSubmatch(src, -1) {
		if len(m) < 2 {
			continue
		}
		varName := m[1]
		assignRe := regexp.MustCompile(regexp.QuoteMeta(varName) + `\s*:=\s*make\((map\[[^\]]+\][A-Za-z0-9_\*\.\[\]]+)`)
		if am := assignRe.FindStringSubmatch(src); len(am) > 1 {
			return am[1]
		}
	}
	makeRe := regexp.MustCompile(regexp.QuoteMeta(field) + `\s*:\s*make\((map\[[^\]]+\][A-Za-z0-9_\*\.\[\]]+)`)
	if m := makeRe.FindStringSubmatch(src); len(m) > 1 {
		return m[1]
	}
	return ""
}

func inferGoCompositePointerFieldType(src, typeName, field string) string {
	re := regexp.MustCompile(regexp.QuoteMeta(field) + `\s*:\s*([A-Za-z_][A-Za-z0-9_]*)`)
	for _, m := range re.FindAllStringSubmatch(src, -1) {
		if len(m) < 2 {
			continue
		}
		varName := m[1]
		if typ := goReceiverLocalStructType(src, varName, typeName); typ != "" {
			return "*" + typ
		}
	}
	return ""
}

func goReceiverLocalStructType(src, receiver, excludeType string) string {
	re := regexp.MustCompile(`\bfunc\s*\(\s*` + regexp.QuoteMeta(receiver) + `\s+\*([A-Za-z_][A-Za-z0-9_]*)\s*\)`)
	for _, m := range re.FindAllStringSubmatch(src, -1) {
		if len(m) > 1 && m[1] != "" && m[1] != excludeType {
			return m[1]
		}
	}
	return ""
}

func repairGoMissingStructFieldsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+[A-Za-z_][A-Za-z0-9_\.]*\.([A-Za-z_][A-Za-z0-9_]*) undefined \(type \*?([A-Za-z_][A-Za-z0-9_]*) has no field or method ([A-Za-z_][A-Za-z0-9_]*)\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		if m[2] != m[4] {
			continue
		}
		file := resolveGoBuildErrorPath(root, m[1])
		field := m[2]
		typeName := m[3]
		if file == "" || field == "" || typeName == "" {
			continue
		}
		dir := filepath.Dir(file)
		key := dir + "\x00" + typeName + "\x00" + field
		if seen[key] || !goStructExistsInDir(dir, typeName) {
			continue
		}
		seen[key] = true
		changed += appendGoFieldToStructInDir(dir, typeName, field, inferredGoFieldType(field))
	}
	return changed
}

func repairGoImportedPackageStructFieldsFromBuildErrors(root, modulePath, buildErrors string) int {
	if modulePath == "" {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+[A-Za-z_][A-Za-z0-9_\.]*\.([A-Za-z_][A-Za-z0-9_]*) undefined \(type \*?([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*) has no field or method ([A-Za-z_][A-Za-z0-9_]*)\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	literalRe := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+unknown field ([A-Za-z_][A-Za-z0-9_]*) in struct literal of type ([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)`)
	literalMatches := literalRe.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 && len(literalMatches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		field, alias, typeName, missing := m[3], m[4], m[5], m[6]
		if file == "" || field == "" || field != missing || alias == "" || typeName == "" {
			continue
		}
		if goSelectorAtLineLooksCall(file, line, field) {
			continue
		}
		importPath := goImportPathForAlias(file, alias)
		if importPath == "" || !strings.HasPrefix(importPath, modulePath+"/") {
			continue
		}
		rel := strings.TrimPrefix(importPath, modulePath+"/")
		dir := filepath.Join(root, filepath.FromSlash(rel))
		key := dir + "\x00" + typeName + "\x00" + field
		if seen[key] || !goStructExistsInDir(dir, typeName) {
			continue
		}
		seen[key] = true
		if goMethodSignatureForTypeInDir(dir, typeName, field) != "" {
			changed += removeGoMethodFromTypeInDir(dir, typeName, field)
		}
		changed += appendGoFieldToStructInDir(dir, typeName, field, inferredGoStructFieldType(typeName, field))
	}
	for _, m := range literalMatches {
		file := resolveGoBuildErrorPath(root, m[1])
		field, alias, typeName := m[2], m[3], m[4]
		if file == "" || field == "" || alias == "" || typeName == "" {
			continue
		}
		importPath := goImportPathForAlias(file, alias)
		if importPath == "" || !strings.HasPrefix(importPath, modulePath+"/") {
			continue
		}
		rel := strings.TrimPrefix(importPath, modulePath+"/")
		dir := filepath.Join(root, filepath.FromSlash(rel))
		key := dir + "\x00" + typeName + "\x00" + field
		if seen[key] || !goStructExistsInDir(dir, typeName) {
			continue
		}
		seen[key] = true
		if goMethodSignatureForTypeInDir(dir, typeName, field) != "" {
			changed += removeGoMethodFromTypeInDir(dir, typeName, field)
		}
		changed += appendGoFieldToStructInDir(dir, typeName, field, inferredGoStructFieldType(typeName, field))
	}
	return changed
}

func goSelectorAtLineLooksCall(file string, line int, selector string) bool {
	if file == "" || line <= 0 || selector == "" {
		return false
	}
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	lines := strings.Split(string(data), "\n")
	idx := line - 1
	if idx < 0 || idx >= len(lines) {
		return false
	}
	return regexp.MustCompile(`\.` + regexp.QuoteMeta(selector) + `\s*\(`).MatchString(lines[idx])
}

func repairGoImportedSelectorAssignmentFieldsFromBuildErrors(root, modulePath, buildErrors string) int {
	if modulePath == "" {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot assign to ([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*) \(neither addressable nor a map index expression\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		varName, field := m[3], m[4]
		if file == "" || line <= 0 || varName == "" || field == "" {
			continue
		}
		alias, typeName := goImportedTypeForVariableAtLine(file, varName, line)
		if alias == "" || typeName == "" {
			continue
		}
		importPath := goImportPathForAlias(file, alias)
		if importPath == "" || !strings.HasPrefix(importPath, modulePath+"/") {
			continue
		}
		rel := strings.TrimPrefix(importPath, modulePath+"/")
		dir := filepath.Join(root, filepath.FromSlash(rel))
		key := dir + "\x00" + typeName + "\x00" + field
		if seen[key] || !goStructExistsInDir(dir, typeName) {
			continue
		}
		seen[key] = true
		if goMethodSignatureForTypeInDir(dir, typeName, field) != "" {
			changed += removeGoMethodFromTypeInDir(dir, typeName, field)
		}
		changed += appendGoFieldToStructInDir(dir, typeName, field, inferredGoStructFieldType(typeName, field))
	}
	return changed
}

func goImportedTypeForVariableAtLine(file, varName string, line int) (string, string) {
	data, err := os.ReadFile(file)
	if err != nil {
		return "", ""
	}
	fset := token.NewFileSet()
	parsed, parseErr := parser.ParseFile(fset, file, data, 0)
	if parseErr != nil {
		return "", ""
	}
	for _, decl := range parsed.Decls {
		fn, ok := decl.(*ast.FuncDecl)
		if !ok || fn.Type == nil {
			continue
		}
		if line < fset.Position(fn.Pos()).Line || line > fset.Position(fn.End()).Line {
			continue
		}
		if fn.Type.Params != nil {
			for _, field := range fn.Type.Params.List {
				for _, name := range field.Names {
					if name != nil && name.Name == varName {
						return goImportedSelectorType(field.Type)
					}
				}
			}
		}
		if fn.Body == nil {
			continue
		}
		var alias, typeName string
		ast.Inspect(fn.Body, func(n ast.Node) bool {
			if alias != "" || n == nil || fset.Position(n.Pos()).Line > line {
				return false
			}
			declStmt, ok := n.(*ast.DeclStmt)
			if !ok {
				return true
			}
			gen, ok := declStmt.Decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.VAR {
				return true
			}
			for _, spec := range gen.Specs {
				vs, ok := spec.(*ast.ValueSpec)
				if !ok || vs.Type == nil {
					continue
				}
				for _, name := range vs.Names {
					if name != nil && name.Name == varName {
						alias, typeName = goImportedSelectorType(vs.Type)
						return false
					}
				}
			}
			return true
		})
		return alias, typeName
	}
	return "", ""
}

func goImportedSelectorType(expr ast.Expr) (string, string) {
	switch t := expr.(type) {
	case *ast.StarExpr:
		return goImportedSelectorType(t.X)
	case *ast.SelectorExpr:
		if id, ok := t.X.(*ast.Ident); ok && t.Sel != nil {
			return id.Name, t.Sel.Name
		}
	}
	return "", ""
}

func repairGoUndefinedFieldTyposFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+[A-Za-z_][A-Za-z0-9_\.]*\.([A-Za-z_][A-Za-z0-9_]*) undefined \(type \*?([A-Za-z_][A-Za-z0-9_]*) has no field or method ([A-Za-z_][A-Za-z0-9_]*)\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type fix struct {
		line int
		bad  string
		good string
	}
	byFile := map[string][]fix{}
	for _, m := range matches {
		if m[3] != m[5] {
			continue
		}
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		bad := m[3]
		typeName := m[4]
		if file == "" || line <= 0 || bad == "" || typeName == "" {
			continue
		}
		fields := goStructFieldNamesInDir(filepath.Dir(file), typeName)
		best := closestGoFieldNameExcluding(bad, fields, bad)
		if best == "" || shouldSkipGoFieldTypoRepair(bad, best) {
			continue
		}
		byFile[file] = append(byFile[file], fix{line: line, bad: bad, good: best})
	}
	changed := 0
	for file, fixes := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for _, fx := range fixes {
			idx := fx.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			updated := strings.ReplaceAll(lines[idx], "."+fx.bad, "."+fx.good)
			if updated != lines[idx] {
				lines[idx] = updated
				touched = true
			}
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func shouldSkipGoFieldTypoRepair(bad, best string) bool {
	badLower := strings.ToLower(strings.TrimSpace(bad))
	bestLower := strings.ToLower(strings.TrimSpace(best))
	if badLower == "" || bestLower == "" {
		return true
	}
	if badLower == "stats" && bestLower == "state" {
		return true
	}
	if strings.HasSuffix(badLower, "path") && bestLower == "state" {
		return true
	}
	return false
}

func repairGoNonMapFieldTyposFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot assign to ([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)\[`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type fix struct {
		line int
		bad  string
		good string
	}
	byFile := map[string][]fix{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		recvName, bad := m[3], m[4]
		if file == "" || line <= 0 || recvName == "" || bad == "" {
			continue
		}
		typeName := goReceiverTypeAtLine(file, recvName, line)
		fields := goStructFieldNamesInDir(filepath.Dir(file), typeName)
		best := closestGoFieldNameExcluding(bad, fields, bad)
		if best == "" {
			continue
		}
		byFile[file] = append(byFile[file], fix{line: line, bad: bad, good: best})
	}
	changed := 0
	for file, fixes := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for _, fx := range fixes {
			idx := fx.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			updated := strings.ReplaceAll(lines[idx], "."+fx.bad, "."+fx.good)
			if updated != lines[idx] {
				lines[idx] = updated
				touched = true
			}
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoMethodFieldSelectorDriftFromBuildErrors(root, buildErrors string) int {
	type fieldLine struct {
		line int
		name string
		typ  string
	}
	byFile := map[string][]fieldLine{}
	unknownFieldRe := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+unknown field ([A-Za-z_][A-Za-z0-9_]*) in struct literal of type ([A-Za-z_][A-Za-z0-9_]*)`)
	for _, m := range unknownFieldRe.FindAllStringSubmatch(buildErrors, -1) {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		field, typeName := m[3], m[4]
		if file == "" || line <= 0 || field == "" || typeName == "" {
			continue
		}
		if goMethodSignatureForTypeInDir(filepath.Dir(file), typeName, field) == "" {
			continue
		}
		byFile[file] = append(byFile[file], fieldLine{line: line, name: field, typ: typeName})
	}
	callRe := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot use ([A-Za-z_][A-Za-z0-9_\.]*\.([A-Za-z_][A-Za-z0-9_]*)) \(value of type func\(\) [^)]+\) as [^\n]+ value`)
	callLines := map[string]map[int]string{}
	for _, m := range callRe.FindAllStringSubmatch(buildErrors, -1) {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		expr := strings.TrimSpace(m[3])
		if file == "" || line <= 0 || expr == "" {
			continue
		}
		if callLines[file] == nil {
			callLines[file] = map[int]string{}
		}
		callLines[file][line] = expr
	}
	if len(byFile) == 0 && len(callLines) == 0 {
		return 0
	}
	changed := 0
	for file, fields := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		remove := map[int]bool{}
		for _, f := range fields {
			idx := f.line - 1
			if idx >= 0 && idx < len(lines) && regexp.MustCompile(`^\s*`+regexp.QuoteMeta(f.name)+`\s*:`).MatchString(lines[idx]) {
				remove[idx] = true
			}
		}
		if len(remove) == 0 {
			continue
		}
		next := make([]string, 0, len(lines)-len(remove))
		for i, line := range lines {
			if !remove[i] {
				next = append(next, line)
			}
		}
		if err := os.WriteFile(file, []byte(strings.Join(next, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	for file, exprs := range callLines {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for line, expr := range exprs {
			idx := line - 1
			if idx < 0 || idx >= len(lines) || strings.Contains(lines[idx], expr+"()") {
				continue
			}
			lines[idx] = strings.ReplaceAll(lines[idx], expr, expr+"()")
			touched = true
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func goMethodSignatureForTypeInDir(dir, typeName, method string) string {
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			fn, ok := decl.(*ast.FuncDecl)
			if !ok || fn.Recv == nil || fn.Name == nil || fn.Name.Name != method || len(fn.Recv.List) == 0 {
				continue
			}
			if goReceiverBaseTypeName(fn.Recv.List[0].Type) != typeName {
				continue
			}
			var buf bytes.Buffer
			if err := printer.Fprint(&buf, fset, fn.Type); err != nil {
				continue
			}
			return method + strings.TrimPrefix(strings.TrimSpace(buf.String()), "func")
		}
	}
	return ""
}

func goReceiverBaseTypeName(expr ast.Expr) string {
	switch t := expr.(type) {
	case *ast.Ident:
		return t.Name
	case *ast.StarExpr:
		return goReceiverBaseTypeName(t.X)
	}
	return ""
}

func repairGoFloatDriftFromBuildErrors(root, buildErrors string) int {
	targets := map[string]map[int]bool{}
	reReturn := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot use math\.Abs\([^\n]+\) \(value of type float64\) as float32 value in return statement`)
	for _, m := range reReturn.FindAllStringSubmatch(buildErrors, -1) {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		if file != "" && line > 0 {
			if targets[file] == nil {
				targets[file] = map[int]bool{}
			}
			targets[file][line] = true
		}
	}
	reAbsArg := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot use .+ \(value of type float32\) as float64 value in argument to math\.Abs`)
	for _, m := range reAbsArg.FindAllStringSubmatch(buildErrors, -1) {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		if file != "" && line > 0 {
			if targets[file] == nil {
				targets[file] = map[int]bool{}
			}
			targets[file][line] = true
		}
	}
	reAssign := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot use .+ \(variable of type float32\) as float64 value in assignment`)
	for _, m := range reAssign.FindAllStringSubmatch(buildErrors, -1) {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		if file != "" && line > 0 {
			if targets[file] == nil {
				targets[file] = map[int]bool{}
			}
			targets[file][line] = true
		}
	}
	changed := 0
	for file, lineSet := range targets {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for line := range lineSet {
			idx := line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			trimmed := strings.TrimSpace(lines[idx])
			if strings.HasPrefix(trimmed, "return math.Abs(") && strings.HasSuffix(trimmed, ")") {
				inner := strings.TrimSuffix(strings.TrimPrefix(trimmed, "return math.Abs("), ")")
				lines[idx] = leadingWhitespace(lines[idx]) + "return float32(math.Abs(float64(" + inner + ")))"
				touched = true
				continue
			}
			if strings.Contains(lines[idx], ":= math.MaxFloat32") {
				lines[idx] = strings.Replace(lines[idx], ":= math.MaxFloat32", ":= float32(math.MaxFloat32)", 1)
				touched = true
			}
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoStringIDLookupFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot use .+ \(variable of type string\) as int value in argument to .+\.getID`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		if file == "" || line <= 0 {
			continue
		}
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		idx := line - 1
		if idx < 0 || idx >= len(lines) {
			continue
		}
		lineText := lines[idx]
		assignRe := regexp.MustCompile(`^(\s*)([A-Za-z_][A-Za-z0-9_]*)\s*,\s*_\s*:=\s*.+\.getID\(([^)]+)\)\s*$`)
		if mm := assignRe.FindStringSubmatch(lineText); len(mm) == 4 {
			lines[idx] = mm[1] + mm[2] + " := " + strings.TrimSpace(mm[3])
			if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
				changed++
				_ = exec.Command("gofmt", "-w", file).Run()
			}
		}
	}
	return changed
}

func repairGoInterfaceConcreteAssignmentFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "need type assertion") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot use ([A-Za-z_][A-Za-z0-9_]*) \(variable of (?:interface )?type ([A-Za-z_][A-Za-z0-9_]*)\) as \*([A-Za-z_][A-Za-z0-9_]*) value in assignment: need type assertion`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type target struct {
		line          int
		valueName     string
		interfaceType string
		concreteType  string
	}
	byFile := map[string][]target{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		if file == "" || line <= 0 || m[3] == "" || m[4] == "" || m[5] == "" {
			continue
		}
		byFile[file] = append(byFile[file], target{
			line:          line,
			valueName:     m[3],
			interfaceType: m[4],
			concreteType:  m[5],
		})
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		lines := strings.Split(src, "\n")
		touched := false
		for _, target := range targets {
			idx := target.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			assigned := goAssignmentTargetForLine(lines[idx], target.valueName)
			if assigned == "" {
				continue
			}
			updated := rewriteGoVarInitializerConcreteToInterface(src, assigned, target.concreteType, target.interfaceType)
			if updated == src {
				continue
			}
			src = updated
			lines = strings.Split(src, "\n")
			touched = true
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(src), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func goAssignmentTargetForLine(line, valueName string) string {
	if valueName == "" {
		return ""
	}
	re := regexp.MustCompile(`^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*` + regexp.QuoteMeta(valueName) + `\s*$`)
	if m := re.FindStringSubmatch(line); len(m) == 2 {
		return m[1]
	}
	return ""
}

func rewriteGoVarInitializerConcreteToInterface(src, varName, concreteType, interfaceType string) string {
	if src == "" || varName == "" || concreteType == "" || interfaceType == "" {
		return src
	}
	lineRe := regexp.MustCompile(`(?m)^(\s*)var\s+` + regexp.QuoteMeta(varName) + `\s*=\s*(.+)$`)
	return lineRe.ReplaceAllString(src, `${1}var `+varName+" "+interfaceType+" = $2")
}

func repairGoSingleAssignmentMultiReturnFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+assignment mismatch: 1 variable but ([A-Za-z_][A-Za-z0-9_\.]*) returns 2 values`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type targetLine struct {
		line int
		call string
	}
	byFile := map[string][]targetLine{}
	for _, m := range matches {
		line, _ := strconv.Atoi(m[2])
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || line <= 0 || m[3] == "" {
			continue
		}
		byFile[file] = append(byFile[file], targetLine{line: line, call: m[3]})
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		sort.Slice(targets, func(i, j int) bool { return targets[i].line > targets[j].line })
		touched := false
		for _, target := range targets {
			idx := target.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			assignRe := regexp.MustCompile(`^(\s*)([A-Za-z_][A-Za-z0-9_]*)\s*:=\s*(.+)$`)
			parts := assignRe.FindStringSubmatch(lines[idx])
			if len(parts) != 4 {
				continue
			}
			expr := strings.TrimSpace(parts[3])
			if !strings.Contains(expr, target.call+"(") && !strings.Contains(expr, target.call+"()") {
				continue
			}
			indent := parts[1]
			if lineIsInsideRecentForBlock(lines, idx) {
				lines[idx] = fmt.Sprintf("%s%s, err := %s", indent, parts[2], expr)
				errGuard := indent + "if err != nil {"
				if idx+1 >= len(lines) || strings.TrimSpace(lines[idx+1]) != strings.TrimSpace(errGuard) {
					insert := []string{
						errGuard,
						indent + "\tcontinue",
						indent + "}",
					}
					lines = append(lines[:idx+1], append(insert, lines[idx+1:]...)...)
				}
			} else {
				lines[idx] = fmt.Sprintf("%s%s, _ := %s", indent, parts[2], expr)
			}
			touched = true
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoTypedSliceToInterfaceSliceCallsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot use ([A-Za-z_][A-Za-z0-9_]*) \(variable of type \[\][^)]+\) as \[\](?:interface\{\}|any) value in argument to ([A-Za-z_][A-Za-z0-9_\.]*)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type targetLine struct {
		line int
		name string
		call string
	}
	byFile := map[string][]targetLine{}
	for _, m := range matches {
		line, _ := strconv.Atoi(m[2])
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || line <= 0 || m[3] == "" || m[4] == "" {
			continue
		}
		byFile[file] = append(byFile[file], targetLine{line: line, name: m[3], call: m[4]})
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		sort.Slice(targets, func(i, j int) bool { return targets[i].line < targets[j].line })
		touched := false
		for _, target := range targets {
			idx := target.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			line := lines[idx]
			if !strings.Contains(line, target.call+"(") || strings.Contains(line, "toInterfaceSlice("+target.name+")") {
				continue
			}
			callRe := regexp.MustCompile(`\b` + regexp.QuoteMeta(target.call) + `\((.*)\)`)
			updated := callRe.ReplaceAllStringFunc(line, func(callText string) string {
				return regexp.MustCompile(`\b`+regexp.QuoteMeta(target.name)+`\b`).ReplaceAllString(callText, "toInterfaceSlice("+target.name+")")
			})
			if updated == line {
				continue
			}
			lines[idx] = updated
			touched = true
		}
		if !touched {
			continue
		}
		updated := strings.Join(lines, "\n")
		if !strings.Contains(updated, "func toInterfaceSlice[") && !strings.Contains(updated, "func toInterfaceSlice(") {
			updated += `

func toInterfaceSlice[T any](items []T) []interface{} {
	out := make([]interface{}, len(items))
	for i, item := range items {
		out[i] = item
	}
	return out
}
`
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoNonLocalTypeMethodsFromBuildErrors(root, modulePath, buildErrors string) int {
	if root == "" || modulePath == "" {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+cannot define new methods on non-local type ([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type target struct {
		alias string
		typ   string
	}
	byFile := map[string][]target{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || m[2] == "" || m[3] == "" {
			continue
		}
		byFile[file] = append(byFile[file], target{alias: m[2], typ: m[3]})
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, parser.ParseComments)
		if parseErr != nil {
			continue
		}
		var ranges []textRange
		additionsByDir := map[string][]string{}
		seen := map[string]bool{}
		for _, target := range targets {
			importPath := goImportPathForAlias(file, target.alias)
			if importPath == "" || !strings.HasPrefix(importPath, modulePath+"/") {
				continue
			}
			rel := strings.TrimPrefix(importPath, modulePath+"/")
			destDir := filepath.Join(root, filepath.FromSlash(rel))
			if !goStructExistsInDir(destDir, target.typ) {
				continue
			}
			for _, decl := range parsed.Decls {
				fn, ok := decl.(*ast.FuncDecl)
				if !ok || fn.Recv == nil || len(fn.Recv.List) == 0 || fn.Name == nil {
					continue
				}
				if !goReceiverIsQualifiedType(fn.Recv.List[0].Type, target.alias, target.typ) {
					continue
				}
				start := fset.Position(fn.Pos()).Offset
				end := fset.Position(fn.End()).Offset
				if start < 0 || end <= start || end > len(data) {
					continue
				}
				methodSrc := string(data[start:end])
				methodSrc = regexp.MustCompile(`(\(\s*[A-Za-z_][A-Za-z0-9_]*\s+\*?)`+regexp.QuoteMeta(target.alias)+`\.`+regexp.QuoteMeta(target.typ)+`(\s*\))`).ReplaceAllString(methodSrc, `${1}`+target.typ+`${2}`)
				key := destDir + "\x00" + fn.Name.Name
				if seen[key] || goMethodExistsOnTypeInDir(destDir, target.typ, fn.Name.Name) {
					continue
				}
				seen[key] = true
				additionsByDir[destDir] = append(additionsByDir[destDir], methodSrc)
				ranges = append(ranges, expandTextRangeToLine(data, start, end))
			}
		}
		if len(ranges) == 0 || len(additionsByDir) == 0 {
			continue
		}
		updated := removeTextRanges(data, ranges)
		if string(updated) != string(data) {
			if err := os.WriteFile(file, updated, 0o644); err == nil {
				changed++
				_ = exec.Command("gofmt", "-w", file).Run()
			}
		}
		for destDir, additions := range additionsByDir {
			if appendGoMethodsToDir(destDir, additions) {
				changed++
			}
		}
	}
	return changed
}

func goReceiverIsQualifiedType(expr ast.Expr, alias, typ string) bool {
	switch t := expr.(type) {
	case *ast.StarExpr:
		return goReceiverIsQualifiedType(t.X, alias, typ)
	case *ast.SelectorExpr:
		x, ok := t.X.(*ast.Ident)
		return ok && x.Name == alias && t.Sel != nil && t.Sel.Name == typ
	default:
		return false
	}
}

func goMethodExistsOnTypeInDir(dir, typeName, method string) bool {
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			fn, ok := decl.(*ast.FuncDecl)
			if !ok || fn.Recv == nil || len(fn.Recv.List) == 0 || fn.Name == nil || fn.Name.Name != method {
				continue
			}
			if goReceiverBaseTypeName(fn.Recv.List[0].Type) == typeName {
				return true
			}
		}
	}
	return false
}

func appendGoMethodsToDir(dir string, methods []string) bool {
	if dir == "" || len(methods) == 0 {
		return false
	}
	pkg := firstGoPackageNameInDir(dir)
	if pkg == "" {
		return false
	}
	target := filepath.Join(dir, "zz_generated_contract_methods.go")
	src := "package " + pkg + "\n\n" + strings.Join(methods, "\n\n") + "\n"
	if existing, err := os.ReadFile(target); err == nil {
		old := string(existing)
		var additions []string
		for _, method := range methods {
			if strings.Contains(old, method) {
				continue
			}
			additions = append(additions, method)
		}
		if len(additions) == 0 {
			return false
		}
		src = strings.TrimRight(old, "\n") + "\n\n" + strings.Join(additions, "\n\n") + "\n"
	}
	if err := os.WriteFile(target, []byte(src), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", target).Run()
	return true
}

func lineIsInsideRecentForBlock(lines []string, idx int) bool {
	depth := 0
	for i := idx - 1; i >= 0 && i >= idx-25; i-- {
		trimmed := strings.TrimSpace(lines[i])
		if strings.Contains(trimmed, "}") {
			depth++
		}
		if strings.Contains(trimmed, "{") {
			if depth > 0 {
				depth--
			}
			if depth == 0 && strings.HasPrefix(trimmed, "for ") {
				return true
			}
		}
	}
	return false
}

func repairGoNamedUintMismatchesFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+(?:invalid operation: ([^\n]+) \(mismatched types ([A-Za-z_][A-Za-z0-9_]*) and uint64\)|cannot use ([^\n]+) \(variable of (?:uint64 type |type )([A-Za-z_][A-Za-z0-9_]*)\) as uint64 value in assignment)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type targetLine struct {
		line int
	}
	byFile := map[string][]targetLine{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		if file == "" || line <= 0 {
			continue
		}
		byFile[file] = append(byFile[file], targetLine{line: line})
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for _, target := range targets {
			idx := target.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			line := lines[idx]
			line = regexp.MustCompile(`(\b[A-Za-z_][A-Za-z0-9_\.]*Version\b)\s*([><=!]=?)\s*(\b[A-Za-z_][A-Za-z0-9_]*Ts\b|\breadTs\b|\bnowTs\b)`).ReplaceAllString(line, `uint64($1) $2 $3`)
			line = regexp.MustCompile(`=\s*(\b[A-Za-z_][A-Za-z0-9_\.]*Version\b)\s*$`).ReplaceAllString(line, `= uint64($1)`)
			if line != lines[idx] {
				lines[idx] = line
				touched = true
			}
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoNamedUintAtomicCallsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot use &([A-Za-z_][A-Za-z0-9_\.]+) \(value of type \*([A-Za-z_][A-Za-z0-9_]*)\) as \*uint64 value in argument to atomic\.(LoadUint64|StoreUint64|AddUint64)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type targetLine struct {
		line     int
		expr     string
		typeName string
	}
	byFile := map[string][]targetLine{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		if file == "" || line <= 0 || m[3] == "" || m[4] == "" {
			continue
		}
		byFile[file] = append(byFile[file], targetLine{line: line, expr: m[3], typeName: m[4]})
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for _, target := range targets {
			idx := target.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			line := lines[idx]
			loadRe := regexp.MustCompile(`atomic\.LoadUint64\(&` + regexp.QuoteMeta(target.expr) + `\)`)
			storeRe := regexp.MustCompile(`atomic\.StoreUint64\(&` + regexp.QuoteMeta(target.expr) + `,\s*([^)]+)\)`)
			addRe := regexp.MustCompile(`atomic\.AddUint64\(&` + regexp.QuoteMeta(target.expr) + `,\s*([^)]+)\)`)
			updated := loadRe.ReplaceAllString(line, `uint64(`+target.expr+`)`)
			updated = storeRe.ReplaceAllString(updated, target.expr+` = `+target.typeName+`($1)`)
			updated = addRe.ReplaceAllString(updated, target.expr+` += `+target.typeName+`($1)`)
			if updated != line {
				lines[idx] = updated
				touched = true
			}
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoSamePackageEnumMismatchesFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+(?:cannot use ([A-Za-z_][A-Za-z0-9_]*) \(constant \d+ of type ([A-Za-z_][A-Za-z0-9_]*)\) as ([A-Za-z_][A-Za-z0-9_]*) value|invalid operation: [^\n]+ \(mismatched types ([A-Za-z_][A-Za-z0-9_]*) and ([A-Za-z_][A-Za-z0-9_]*)\))`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type enumMismatch struct {
		file string
		from string
		to   string
	}
	var targets []enumMismatch
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" {
			continue
		}
		from, to := m[4], m[5]
		if from == "" || to == "" {
			from, to = m[6], m[7]
		}
		if from == "" || to == "" || from == to {
			continue
		}
		targets = append(targets, enumMismatch{file: file, from: from, to: to})
	}
	if len(targets) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, target := range targets {
		dir := filepath.Dir(target.file)
		replacement := choosePreferredSamePackageEnumType(dir, target.from, target.to)
		remove := target.from
		if replacement == "" {
			continue
		}
		if replacement == target.from {
			remove = target.to
		}
		key := dir + "\x00" + remove + "\x00" + replacement
		if seen[key] {
			continue
		}
		seen[key] = true
		changed += replaceSamePackageEnumType(dir, remove, replacement)
	}
	return changed
}

func choosePreferredSamePackageEnumType(dir, a, b string) string {
	aConsts := goEnumConstNamesForType(dir, a)
	bConsts := goEnumConstNamesForType(dir, b)
	if len(aConsts) > 0 && len(bConsts) == 0 {
		return a
	}
	if len(bConsts) > 0 && len(aConsts) == 0 {
		return b
	}
	if len(aConsts) != len(bConsts) {
		if len(aConsts) > len(bConsts) {
			return a
		}
		return b
	}
	if strings.Contains(strings.ToLower(a), "memtable") && !strings.Contains(strings.ToLower(b), "memtable") {
		return b
	}
	if strings.Contains(strings.ToLower(b), "memtable") && !strings.Contains(strings.ToLower(a), "memtable") {
		return a
	}
	if len(a) <= len(b) {
		return a
	}
	return b
}

func goEnumConstNamesForType(dir, typeName string) []string {
	var names []string
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, err := parser.ParseFile(fset, file, data, 0)
		if err != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.CONST {
				continue
			}
			for _, spec := range gen.Specs {
				vs, ok := spec.(*ast.ValueSpec)
				if !ok || vs.Type == nil {
					continue
				}
				ident, ok := vs.Type.(*ast.Ident)
				if !ok || ident.Name != typeName {
					continue
				}
				for _, name := range vs.Names {
					if name != nil {
						names = append(names, name.Name)
					}
				}
			}
		}
	}
	return uniqueStrings(names)
}

func replaceSamePackageEnumType(dir, oldType, newType string) int {
	if dir == "" || oldType == "" || newType == "" || oldType == newType {
		return 0
	}
	changed := 0
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		typeDeclRe := regexp.MustCompile(`(?ms)^type\s+` + regexp.QuoteMeta(oldType) + `\s+[^\n]+\n`)
		src = typeDeclRe.ReplaceAllString(src, "")
		emptyConstRe := regexp.MustCompile(`(?ms)^const\s*\(\s*(?://[^\n]*\n|\s*)*\)\s*`)
		src = emptyConstRe.ReplaceAllString(src, "")
		wordRe := regexp.MustCompile(`\b` + regexp.QuoteMeta(oldType) + `\b`)
		src = wordRe.ReplaceAllString(src, newType)
		if src == string(data) {
			continue
		}
		if err := os.WriteFile(file, []byte(src), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoPointerReturnContractDriftFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+cannot use (?:nil|[A-Za-z_][A-Za-z0-9_]*)(?: .*?)? as ([A-Za-z_][A-Za-z0-9_]*) value in return statement`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		typeName := m[2]
		if file == "" || typeName == "" {
			continue
		}
		key := file + "\x00" + typeName
		if seen[key] {
			continue
		}
		seen[key] = true
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		reSig := regexp.MustCompile(`func(\s+(?:\([^)]*\)\s*)?[A-Za-z_][A-Za-z0-9_]*\s*\([^)]*\)\s*)\(` + regexp.QuoteMeta(typeName) + `\s*,\s*error\)`)
		updated := reSig.ReplaceAllString(src, `func${1}(*`+typeName+`, error)`)
		if updated == src {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoConcreteReturnForNonImplementingInterfaceFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+cannot use .+ \(value of type \*([A-Za-z_][A-Za-z0-9_]*)\) as ([A-Za-z_][A-Za-z0-9_]*) value in return statement: \*[A-Za-z_][A-Za-z0-9_]* does not implement [A-Za-z_][A-Za-z0-9_]*`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		concreteType, interfaceType := m[2], m[3]
		if file == "" || concreteType == "" || interfaceType == "" {
			continue
		}
		if interfaceType == "error" {
			continue
		}
		key := file + "\x00" + concreteType + "\x00" + interfaceType
		if seen[key] {
			continue
		}
		seen[key] = true
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		reSig := regexp.MustCompile(`func(\s+(?:\([^)]*\)\s*)?[A-Za-z_][A-Za-z0-9_]*\s*\([^)]*\)\s*)` + regexp.QuoteMeta(interfaceType) + `(\s*\{)`)
		updated := reSig.ReplaceAllString(src, `func${1}*`+concreteType+`${2}`)
		if updated == src {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoMissingLeadingReturnValueFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+not enough return values\s*\n\s*have \(([^)]*)\)\s*\n\s*want \(\*?[A-Za-z_][A-Za-z0-9_\.]*(?:\[[^\]]*\])?,\s*error\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type targetLine struct {
		line int
		have string
	}
	byFile := map[string][]targetLine{}
	for _, m := range matches {
		line, _ := strconv.Atoi(m[2])
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || line <= 0 {
			continue
		}
		byFile[file] = append(byFile[file], targetLine{line: line, have: strings.TrimSpace(m[3])})
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for _, target := range targets {
			idx := target.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			trimmed := strings.TrimSpace(lines[idx])
			if !strings.HasPrefix(trimmed, "return ") || strings.Contains(strings.TrimPrefix(trimmed, "return "), ",") {
				continue
			}
			if target.have != "error" && target.have != "" && !strings.Contains(target.have, "error") {
				continue
			}
			lines[idx] = leadingWhitespace(lines[idx]) + "return nil, " + strings.TrimSpace(strings.TrimPrefix(trimmed, "return "))
			touched = true
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoTwoVarSingleReturnTaskResultFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+assignment mismatch: 2 variables but ([A-Za-z_][A-Za-z0-9_\.]*) returns 1 value`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type targetLine struct {
		line int
		call string
	}
	byFile := map[string][]targetLine{}
	for _, m := range matches {
		line, _ := strconv.Atoi(m[2])
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || line <= 0 {
			continue
		}
		byFile[file] = append(byFile[file], targetLine{line: line, call: m[3]})
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		sort.Slice(targets, func(i, j int) bool { return targets[i].line > targets[j].line })
		touched := false
		for _, target := range targets {
			idx := target.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			assignRe := regexp.MustCompile(`^(\s*)([A-Za-z_][A-Za-z0-9_]*)\s*,\s*([A-Za-z_][A-Za-z0-9_]*)\s*:=\s*(.+)$`)
			parts := assignRe.FindStringSubmatch(lines[idx])
			if len(parts) != 5 || !strings.Contains(parts[4], target.call+"(") {
				continue
			}
			if parts[2] != "result" || parts[3] != "err" || !strings.Contains(parts[4], "task") {
				continue
			}
			indent := parts[1]
			lines[idx] = indent + "err := " + strings.TrimSpace(parts[4])
			lines = append(lines[:idx+1], append([]string{indent + "result := task.Result"}, lines[idx+1:]...)...)
			touched = true
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoTwoVarSingleReturnGenericFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+assignment mismatch: 2 variables but ([A-Za-z_][A-Za-z0-9_\.]*) returns 1 value`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type targetLine struct {
		line int
		call string
	}
	byFile := map[string][]targetLine{}
	for _, m := range matches {
		line, _ := strconv.Atoi(m[2])
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || line <= 0 || m[3] == "" {
			continue
		}
		byFile[file] = append(byFile[file], targetLine{line: line, call: m[3]})
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for _, target := range targets {
			idx := target.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			assignRe := regexp.MustCompile(`^(\s*)([A-Za-z_][A-Za-z0-9_]*)\s*,\s*(?:_|[A-Za-z_][A-Za-z0-9_]*)\s*:=\s*(.+)$`)
			parts := assignRe.FindStringSubmatch(lines[idx])
			if len(parts) != 4 || !strings.Contains(parts[3], target.call+"(") {
				continue
			}
			lines[idx] = parts[1] + parts[2] + " := " + strings.TrimSpace(parts[3])
			touched = true
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoConstructorTypeToFuncFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+missing argument in conversion to ([A-Za-z_][A-Za-z0-9_]*)\.New([A-Za-z_][A-Za-z0-9_]*)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		pkgName, typeName := m[2], m[3]
		for _, dir := range goDirsByPackageName(root, pkgName) {
			key := dir + "\x00" + typeName
			if seen[key] {
				continue
			}
			seen[key] = true
			changed += replaceGoConstructorTypeWithFunc(dir, "New"+typeName, typeName)
		}
	}
	return changed
}

func repairGoTooManyArgsErrorConstructorsFromBuildErrors(root, modulePath, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+too many arguments in call to ([A-Za-z_][A-Za-z0-9_]*)\.((?:New)?[A-Za-z_][A-Za-z0-9_]*Error)\s*\n\s*have \(string\)\s*\n\s*want \(\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		alias, fnName := m[2], m[3]
		if file == "" || alias == "" || fnName == "" {
			continue
		}
		dir := goLocalPackageDirForAlias(root, modulePath, file, alias)
		if dir == "" {
			continue
		}
		key := dir + "\x00" + fnName
		if seen[key] {
			continue
		}
		seen[key] = true
		if makeGoZeroArgErrorConstructorVariadic(dir, fnName) {
			changed++
		}
	}
	return changed
}

func makeGoZeroArgErrorConstructorVariadic(dir, fnName string) bool {
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		reSig := regexp.MustCompile(`func\s+` + regexp.QuoteMeta(fnName) + `\s*\(\s*\)\s*([^{\n]+)\{`)
		loc := reSig.FindStringSubmatchIndex(src)
		if loc == nil {
			continue
		}
		returns := strings.TrimSpace(src[loc[2]:loc[3]])
		updated := src[:loc[0]] + "func " + fnName + "(message ...string) " + returns + " {" + src[loc[1]:]
		bodyOffset := loc[0] + len("func "+fnName+"(message ...string) "+returns+" ")
		if bodyOffset < 0 || bodyOffset >= len(updated) || updated[bodyOffset] != '{' {
			bodyOffset = strings.Index(updated[loc[0]:], "{")
			if bodyOffset < 0 {
				continue
			}
			bodyOffset += loc[0]
		}
		insertAt := bodyOffset + 1
		if !strings.Contains(updated[insertAt:], "if len(message) > 0") {
			updated = updated[:insertAt] + "\n\tmsg := \"\"\n\tif len(message) > 0 {\n\t\tmsg = message[0]\n\t}\n" + updated[insertAt:]
		}
		updated = regexp.MustCompile(`NewAgentDBError\((ErrCode[A-Za-z0-9_]+),\s*"([^"]*)"\)`).ReplaceAllString(updated, `NewAgentDBError($1, firstNonEmptyString(msg, "$2"))`)
		if !strings.Contains(updated, "func firstNonEmptyString(") {
			updated += `

func firstNonEmptyString(values ...string) string {
	for _, value := range values {
		if value != "" {
			return value
		}
	}
	return ""
}
`
		}
		if updated == src {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err != nil {
			continue
		}
		_ = exec.Command("gofmt", "-w", file).Run()
		return true
	}
	return false
}

func repairGoMissingMethodStubsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+[A-Za-z_][A-Za-z0-9_\.]*\.([A-Za-z_][A-Za-z0-9_]*) undefined \(type ([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*) has no field or method ([A-Za-z_][A-Za-z0-9_]*)\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		if m[2] != m[5] {
			continue
		}
		pkgName, typeName, method := m[3], m[4], m[2]
		for _, dir := range goDirsByPackageName(root, pkgName) {
			key := dir + "\x00" + typeName + "\x00" + method
			if seen[key] || !goStructExistsInDir(dir, typeName) {
				continue
			}
			seen[key] = true
			changed += appendGoMethodStubToTypeInDir(dir, typeName, method)
		}
	}
	return changed
}

func repairGoImportedPackageSingleFetchAliasesFromBuildErrors(root, modulePath, buildErrors string) int {
	if modulePath == "" {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+.+\.([A-Za-z_][A-Za-z0-9_]*) undefined \(type \*?([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*) has no field or method ([A-Za-z_][A-Za-z0-9_]*)\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		selector, alias, typeName, missingMethod := m[2], m[3], m[4], m[5]
		if file == "" || selector == "" || selector != missingMethod || alias == "" || typeName == "" {
			continue
		}
		if !strings.HasPrefix(missingMethod, "Fetch") || missingMethod == "Fetch" {
			continue
		}
		importPath := goImportPathForAlias(file, alias)
		if importPath == "" || !strings.HasPrefix(importPath, modulePath+"/") {
			continue
		}
		rel := strings.TrimPrefix(importPath, modulePath+"/")
		dir := filepath.Join(root, filepath.FromSlash(rel))
		key := dir + "\x00" + typeName + "\x00" + missingMethod
		if seen[key] {
			continue
		}
		seen[key] = true
		changed += appendGoSingleFetchAliasMethod(dir, typeName, missingMethod)
	}
	return changed
}

func appendGoSingleFetchAliasMethod(dir, typeName, method string) int {
	if dir == "" || typeName == "" || method == "" || !goStructExistsInDir(dir, typeName) {
		return 0
	}
	if goMethodSignatureForTypeInDir(dir, typeName, method) != "" {
		return 0
	}
	target, elemType := goFetchSliceMethodTarget(dir, typeName)
	if target == "" || elemType == "" {
		return 0
	}
	returnType := "*" + elemType
	resultExpr := "&items[0]"
	if strings.HasPrefix(elemType, "*") {
		returnType = elemType
		resultExpr = "items[0]"
	}
	recv := strings.ToLower(typeName[:1])
	addition := fmt.Sprintf(`
func (%s *%s) %s(ctx context.Context, id string) (%s, error) {
	items, err := %s.Fetch(ctx, []string{id})
	if err != nil {
		return nil, err
	}
	if len(items) == 0 {
		return nil, fmt.Errorf("item not found: %%s", id)
	}
	return %s, nil
}
`, recv, typeName, method, returnType, recv, resultExpr)
	data, err := os.ReadFile(target)
	if err != nil {
		return 0
	}
	updated := string(data) + "\n" + addition
	updated = ensureImportIfUsed(updated, "context", "context.")
	updated = ensureImportIfUsed(updated, "fmt", "fmt.")
	if err := os.WriteFile(target, []byte(updated), 0o644); err != nil {
		return 0
	}
	_ = exec.Command("gofmt", "-w", target).Run()
	return 1
}

func goFetchSliceMethodTarget(dir, typeName string) (string, string) {
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			fn, ok := decl.(*ast.FuncDecl)
			if !ok || fn.Recv == nil || fn.Name == nil || fn.Name.Name != "Fetch" || len(fn.Recv.List) == 0 {
				continue
			}
			if goReceiverBaseTypeName(fn.Recv.List[0].Type) != typeName {
				continue
			}
			if fn.Type == nil || fn.Type.Results == nil || len(fn.Type.Results.List) < 1 {
				continue
			}
			array, ok := fn.Type.Results.List[0].Type.(*ast.ArrayType)
			if !ok || array.Len != nil {
				continue
			}
			elem := goExprString(fset, array.Elt)
			if strings.TrimSpace(elem) == "" {
				continue
			}
			return file, strings.TrimSpace(elem)
		}
	}
	return "", ""
}

func goExprString(fset *token.FileSet, expr ast.Expr) string {
	if expr == nil {
		return ""
	}
	var buf bytes.Buffer
	if err := printer.Fprint(&buf, fset, expr); err != nil {
		return ""
	}
	return strings.TrimSpace(buf.String())
}

func repairGoMissingGraphTypesFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+undefined:\s+Graph\b`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" {
			continue
		}
		dir := filepath.Dir(file)
		if seen[dir] {
			continue
		}
		seen[dir] = true
		stub := filepath.Join(dir, "graph_stub.go")
		if _, err := os.Stat(stub); err == nil {
			continue
		}
		src := "package " + inferGoPackageNameForFile(filepath.Dir(dir), file) + "\n\n" +
			"type Node struct { ID string }\n\n" +
			"type Graph struct{}\n\n" +
			"func (g *Graph) Neighbors(id string) []Node { return nil }\n"
		if err := os.WriteFile(stub, []byte(src), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", stub).Run()
		}
	}
	return changed
}

func repairGoUndefinedSamePackageTypesFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+undefined:\s+([A-Z][A-Za-z0-9_]*)\b`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	byDir := map[string]map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		name := strings.TrimSpace(m[2])
		if file == "" || name == "" || isGoBuiltinOrStdlibIdentifier(name) {
			continue
		}
		dir := filepath.Dir(file)
		if goTypeExistsInDir(dir, name) || goValueOrFuncExistsInDir(dir, name) {
			continue
		}
		if byDir[dir] == nil {
			byDir[dir] = map[string]bool{}
		}
		byDir[dir][name] = true
	}
	changed := 0
	for dir, names := range byDir {
		if len(names) == 0 {
			continue
		}
		pkg := firstGoPackageNameInDir(dir)
		if pkg == "" {
			continue
		}
		var ordered []string
		for name := range names {
			ordered = append(ordered, name)
		}
		sort.Strings(ordered)
		var b strings.Builder
		b.WriteString("package " + pkg + "\n\n")
		for _, name := range ordered {
			b.WriteString(synthesizeSamePackageIdentifierStub(name))
		}
		if b.Len() == len("package "+pkg+"\n\n") {
			continue
		}
		target := filepath.Join(dir, "zz_generated_contract_stubs.go")
		if existing, err := os.ReadFile(target); err == nil {
			src := string(existing)
			added := false
			for _, name := range ordered {
				if regexp.MustCompile(`\b(func|type|var|const)\s+` + regexp.QuoteMeta(name) + `\b`).MatchString(src) {
					continue
				}
				src += "\n" + synthesizeSamePackageIdentifierStub(name)
				added = true
			}
			if !added {
				continue
			}
			if err := os.WriteFile(target, []byte(src), 0o644); err == nil {
				changed++
				_ = exec.Command("gofmt", "-w", target).Run()
			}
			continue
		}
		if err := os.WriteFile(target, []byte(b.String()), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", target).Run()
		}
	}
	return changed
}

func synthesizeSamePackageIdentifierStub(name string) string {
	switch {
	case strings.HasPrefix(name, "Op") && len(name) > len("Op"):
		return "const " + name + " = Query" + name + "\n\n"
	case strings.HasPrefix(name, "SyncMode") && len(name) > len("SyncMode"):
		return "var " + name + " = SyncMode{}\n\n"
	case strings.HasSuffix(name, "Block"):
		return "type " + name + " struct {\n\tData []byte\n\tentries []Entry\n}\n\n" +
			"type Entry struct {\n\tKey []byte\n\tValue []byte\n}\n\n" +
			"func New" + name + "(cmp any) *" + name + " { return &" + name + "{} }\n\n" +
			"func (b *" + name + ") Add(key, value []byte) { b.entries = append(b.entries, Entry{Key: append([]byte(nil), key...), Value: append([]byte(nil), value...)}) }\n\n" +
			"func (b *" + name + ") Encode() []byte { return append([]byte(nil), b.Data...) }\n\n" +
			"func (b *" + name + ") EstimateSize() uint64 { return uint64(len(b.Data)) }\n\n" +
			"func (b *" + name + ") NumEntries() int { return len(b.entries) }\n\n" +
			"func (b *" + name + ") NewIterator(cmp any) *BlockIterator { return &BlockIterator{entries: b.entries} }\n\n" +
			"type BlockIterator struct { entries []Entry; idx int }\n\n" +
			"func (it *BlockIterator) Close() error { return nil }\n\n" +
			"func (it *BlockIterator) Seek(key []byte) { it.idx = 0 }\n\n" +
			"func (it *BlockIterator) SeekFirst() { it.idx = 0 }\n\n" +
			"func (it *BlockIterator) SeekLast() { if len(it.entries) > 0 { it.idx = len(it.entries)-1 } }\n\n" +
			"func (it *BlockIterator) Valid() bool { return it.idx >= 0 && it.idx < len(it.entries) }\n\n" +
			"func (it *BlockIterator) Next() { it.idx++ }\n\n" +
			"func (it *BlockIterator) Current() Entry { if !it.Valid() { return Entry{} }; return it.entries[it.idx] }\n\n"
	case strings.HasPrefix(name, "Level") && len(name) > len("Level"):
		return "const " + name + " = 0\n\n"
	default:
		return "type " + name + " struct{}\n\n"
	}
}

func isGoBuiltinOrStdlibIdentifier(name string) bool {
	switch name {
	case "Context", "Reader", "Writer", "ReadCloser", "WriteCloser", "Closer", "Time", "Duration", "File", "Mutex", "RWMutex", "WaitGroup":
		return true
	default:
		return false
	}
}

func goValueOrFuncExistsInDir(dir, name string) bool {
	for _, file := range goFilesInDir(dir) {
		parsed, parseErr := parser.ParseFile(token.NewFileSet(), file, nil, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			switch d := decl.(type) {
			case *ast.FuncDecl:
				if d.Name != nil && d.Name.Name == name {
					return true
				}
			case *ast.GenDecl:
				if d.Tok != token.VAR && d.Tok != token.CONST {
					continue
				}
				for _, spec := range d.Specs {
					vs, ok := spec.(*ast.ValueSpec)
					if !ok {
						continue
					}
					for _, n := range vs.Names {
						if n != nil && n.Name == name {
							return true
						}
					}
				}
			}
		}
	}
	return false
}

func repairGoWeakComparatorStubsFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, ".Compare") {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+.+\.Compare\(([^)]*)\)(?: \(no value\) used as value|.*too many arguments)`)
	for _, m := range re.FindAllStringSubmatch(buildErrors, -1) {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" {
			continue
		}
		for _, dir := range candidateComparatorDirs(root, file) {
			if seen[dir] {
				continue
			}
			seen[dir] = true
			changed += rewriteWeakComparatorPackage(dir)
		}
	}
	return changed
}

func repairGoWeakGeneratedEnumStubsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot use ([A-Z][A-Za-z0-9_]*)\{\} \(value of (?:struct type |type )?([A-Z][A-Za-z0-9_]*)\) as ([A-Z][A-Za-z0-9_]*) value`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 && !strings.Contains(buildErrors, " is not an interface") {
		return 0
	}
	type enumUse struct {
		file    string
		base    string
		variant string
	}
	var uses []enumUse
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		variant, repeated, base := m[3], m[4], m[5]
		if file == "" || variant == "" || variant != repeated || base == "" || !strings.HasPrefix(variant, base) || variant == base {
			continue
		}
		uses = append(uses, enumUse{file: file, base: base, variant: variant})
	}
	if len(uses) == 0 {
		return 0
	}
	byDirBase := map[string]map[string]map[string]bool{}
	for _, use := range uses {
		dir := filepath.Dir(use.file)
		if byDirBase[dir] == nil {
			byDirBase[dir] = map[string]map[string]bool{}
		}
		if byDirBase[dir][use.base] == nil {
			byDirBase[dir][use.base] = map[string]bool{}
		}
		byDirBase[dir][use.base][use.variant] = true
	}
	changed := 0
	for dir, byBase := range byDirBase {
		for base, variants := range byBase {
			if rewriteGeneratedEnumStubInDir(dir, base, variants) {
				changed++
			}
		}
	}
	for _, use := range uses {
		if rewriteGoEnumStructLiteralUse(use.file, use.base) {
			changed++
		}
	}
	return changed
}

func repairGoInvalidConstantEnumStubsFromBuildErrors(root, buildErrors string) int {
	invalidConstRe := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+invalid constant type ([A-Z][A-Za-z0-9_\.]*)`)
	notExpressionRe := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+([A-Z][A-Za-z0-9_\.]*) \(type\) is not an expression`)
	type enumTarget struct {
		dir  string
		base string
	}
	targets := map[enumTarget]bool{}
	for _, m := range invalidConstRe.FindAllStringSubmatch(buildErrors, -1) {
		file := resolveGoBuildErrorPath(root, m[1])
		symbol := strings.TrimSpace(m[2])
		base := goQualifiedSymbolBase(symbol)
		if file == "" || base == "" {
			continue
		}
		var dirs []string
		if qualifier := goQualifiedSymbolQualifier(symbol); qualifier != "" {
			dirs = append(dirs, goDirsByPackageName(root, qualifier)...)
		}
		if len(dirs) == 0 {
			dirs = []string{filepath.Dir(file)}
		}
		for _, dir := range dirs {
			if goDirDefinesStructType(dir, base) {
				targets[enumTarget{dir: dir, base: base}] = true
			}
		}
	}
	for _, m := range notExpressionRe.FindAllStringSubmatch(buildErrors, -1) {
		file := resolveGoBuildErrorPath(root, m[1])
		symbol := goQualifiedSymbolBase(m[2])
		if file == "" || symbol == "" {
			continue
		}
		dir := filepath.Dir(file)
		for _, candidateDir := range append(goDirsDefiningType(root, symbol), dir) {
			base := enumBaseForVariant(candidateDir, symbol)
			if base != "" {
				targets[enumTarget{dir: candidateDir, base: base}] = true
			}
		}
	}
	if len(targets) == 0 {
		return 0
	}
	changed := 0
	for target := range targets {
		variants := enumVariantsInDir(target.dir, target.base)
		if len(variants) == 0 {
			continue
		}
		if rewriteGeneratedEnumStubInDir(target.dir, target.base, variants) {
			changed++
		}
	}
	return changed
}

func repairGoQualifiedEmptyStructTypeExpressionFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+([a-z][A-Za-z0-9_]*)\.([A-Z][A-Za-z0-9_]*)\s+\(type\)\s+is not an expression`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type target struct {
		file      string
		qualifier string
		typeName  string
	}
	var targets []target
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		qualifier := strings.TrimSpace(m[2])
		typeName := strings.TrimSpace(m[3])
		if file == "" || qualifier == "" || typeName == "" {
			continue
		}
		importPath := goImportPathForAlias(file, qualifier)
		if importPath == "" || !goImportedPackageDefinesEmptyStruct(root, importPath, typeName) {
			continue
		}
		targets = append(targets, target{file: file, qualifier: qualifier, typeName: typeName})
	}
	if len(targets) == 0 {
		return 0
	}
	changed := 0
	byFile := map[string][]target{}
	for _, t := range targets {
		byFile[t.file] = append(byFile[t.file], t)
	}
	for file, ts := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		updated := string(data)
		for _, t := range ts {
			repl := t.qualifier + "." + t.typeName + "{}"
			updated = regexp.MustCompile(`\b`+regexp.QuoteMeta(t.qualifier)+`\.`+regexp.QuoteMeta(t.typeName)+`\b`).ReplaceAllString(updated, repl)
		}
		if updated == string(data) {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func goImportedPackageDefinesEmptyStruct(root, importPath, typeName string) bool {
	if root == "" || importPath == "" || typeName == "" {
		return false
	}
	for _, dir := range goDirsByImportPath(root, importPath) {
		if goDirDefinesEmptyStructType(dir, typeName) {
			return true
		}
	}
	return false
}

func goDirsByImportPath(root, importPath string) []string {
	modulePath, _ := readGoModModuleAndRequires(filepath.Join(root, "go.mod"))
	modulePath = strings.TrimSpace(modulePath)
	if modulePath != "" && strings.HasPrefix(importPath, modulePath+"/") {
		dir := filepath.Join(root, filepath.FromSlash(strings.TrimPrefix(importPath, modulePath+"/")))
		if directoryHasGoFiles(dir) {
			return []string{dir}
		}
	}
	pkgName := pathBase(importPath)
	return goDirsByPackageName(root, pkgName)
}

func goDirDefinesEmptyStructType(dir, typeName string) bool {
	if dir == "" || typeName == "" {
		return false
	}
	re := regexp.MustCompile(`(?m)^type\s+` + regexp.QuoteMeta(typeName) + `\s+struct\s*\{\s*\}`)
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		if re.Match(data) {
			return true
		}
	}
	return false
}

func enumBaseForVariant(dir, variant string) string {
	if dir == "" || variant == "" {
		return ""
	}
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		re := regexp.MustCompile(`(?m)^type\s+` + regexp.QuoteMeta(variant) + `\s+struct\s*\{\s*\}`)
		if !re.Match(data) {
			continue
		}
		best := ""
		for _, other := range goTypeNamesInFile(file) {
			if other == variant || !strings.HasPrefix(variant, other) {
				continue
			}
			if len(other) > len(best) {
				best = other
			}
		}
		if best != "" {
			return best
		}
	}
	return ""
}

func enumVariantsInDir(dir, base string) map[string]bool {
	variants := map[string]bool{}
	if dir == "" || base == "" {
		return variants
	}
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		re := regexp.MustCompile(`\b` + regexp.QuoteMeta(base) + `[A-Z][A-Za-z0-9_]*\b`)
		for _, match := range re.FindAllString(string(data), -1) {
			if match != base {
				variants[match] = true
			}
		}
	}
	return variants
}

func goQualifiedSymbolBase(symbol string) string {
	symbol = strings.TrimSpace(symbol)
	if symbol == "" {
		return ""
	}
	if i := strings.LastIndex(symbol, "."); i >= 0 && i+1 < len(symbol) {
		symbol = symbol[i+1:]
	}
	if i := strings.LastIndex(symbol, "/"); i >= 0 && i+1 < len(symbol) {
		symbol = symbol[i+1:]
	}
	return symbol
}

func goQualifiedSymbolQualifier(symbol string) string {
	symbol = strings.TrimSpace(symbol)
	if i := strings.LastIndex(symbol, "."); i > 0 {
		return symbol[:i]
	}
	return ""
}

func goDirDefinesStructType(dir, typeName string) bool {
	if dir == "" || typeName == "" {
		return false
	}
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		re := regexp.MustCompile(`(?m)^type\s+` + regexp.QuoteMeta(typeName) + `\s+struct\s*\{\s*\}`)
		if re.Match(data) {
			return true
		}
	}
	return false
}

func rewriteGeneratedEnumStubInDir(dir, base string, variants map[string]bool) bool {
	files := goFilesInDir(dir)
	if len(files) == 0 || base == "" || len(variants) == 0 {
		return false
	}
	target := filepath.Join(dir, "zz_generated_contract_stubs.go")
	if _, err := os.Stat(target); err != nil {
		target = files[0]
	}
	data, err := os.ReadFile(target)
	if err != nil {
		return false
	}
	src := string(data)
	if strings.Contains(src, "type "+base+" int") {
		return false
	}
	for _, file := range files {
		fdata, readErr := os.ReadFile(file)
		if readErr != nil {
			continue
		}
		re := regexp.MustCompile(`\b` + regexp.QuoteMeta(base) + `[A-Z][A-Za-z0-9_]*\b`)
		for _, match := range re.FindAllString(string(fdata), -1) {
			if match != base {
				variants[match] = true
			}
		}
	}
	var ordered []string
	for v := range variants {
		if strings.HasPrefix(v, base) && v != base {
			ordered = append(ordered, v)
		}
	}
	if len(ordered) == 0 {
		return false
	}
	sort.Strings(ordered)
	typeRe := regexp.MustCompile(`(?m)^type\s+` + regexp.QuoteMeta(base) + `\s+struct\s*\{\s*\}\s*\n?`)
	src = typeRe.ReplaceAllString(src, "")
	for _, variant := range ordered {
		variantRe := regexp.MustCompile(`(?m)^type\s+` + regexp.QuoteMeta(variant) + `\s+struct\s*\{\s*\}\s*\n?`)
		src = variantRe.ReplaceAllString(src, "")
	}
	var b strings.Builder
	b.WriteString("type " + base + " int\n\nconst (\n")
	for i, variant := range ordered {
		if i == 0 {
			b.WriteString("\t" + variant + " " + base + " = iota\n")
		} else {
			b.WriteString("\t" + variant + "\n")
		}
	}
	b.WriteString(")\n\n")
	pkgRe := regexp.MustCompile(`(?m)^package\s+[A-Za-z_][A-Za-z0-9_]*\s*$`)
	if loc := pkgRe.FindStringIndex(src); loc != nil {
		src = src[:loc[1]] + "\n\n" + b.String() + strings.TrimLeft(src[loc[1]:], "\n")
	} else {
		src = b.String() + src
	}
	if err := os.WriteFile(target, []byte(src), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", target).Run()
	return true
}

func rewriteGoEnumStructLiteralUse(file, base string) bool {
	if file == "" || base == "" {
		return false
	}
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	src := string(data)
	re := regexp.MustCompile(`\b(` + regexp.QuoteMeta(base) + `[A-Z][A-Za-z0-9_]*)\{\}`)
	updated := re.ReplaceAllString(src, "$1")
	switchRe := regexp.MustCompile(`switch\s+([A-Za-z_][A-Za-z0-9_]*)\.\(type\)\s*\{`)
	updated = switchRe.ReplaceAllString(updated, "switch $1 {")
	if updated == src {
		return false
	}
	if err := os.WriteFile(file, []byte(updated), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", file).Run()
	return true
}

func candidateComparatorDirs(root, usingFile string) []string {
	var dirs []string
	if importPath := goImportPathForAlias(usingFile, "comparator"); importPath != "" {
		modulePath, _ := readGoModModuleAndRequires(filepath.Join(root, "go.mod"))
		modulePath = strings.TrimSpace(modulePath)
		if modulePath != "" && strings.HasPrefix(importPath, modulePath+"/") {
			rel := strings.TrimPrefix(importPath, modulePath+"/")
			dirs = append(dirs, filepath.Join(root, filepath.FromSlash(rel)))
		}
	}
	dirs = append(dirs, filepath.Join(root, "internal", "comparator"))
	return uniqueStrings(dirs)
}

func rewriteWeakComparatorPackage(dir string) int {
	files := goFilesInDir(dir)
	if len(files) == 0 {
		return 0
	}
	target := files[0]
	data, err := os.ReadFile(target)
	if err != nil {
		return 0
	}
	src := string(data)
	if strings.Contains(src, "Compare(a, b []byte) int") {
		return 0
	}
	pkg := firstGoPackageName(src)
	if pkg == "" {
		pkg = firstGoPackageNameInDir(dir)
	}
	if pkg == "" {
		pkg = filepath.Base(dir)
	}
	updated := "package " + pkg + "\n\nimport \"bytes\"\n\n" +
		"type Comparator interface {\n\tCompare(a, b []byte) int\n}\n\n" +
		"type ByteComparator struct{}\n\n" +
		"func (ByteComparator) Compare(a, b []byte) int { return bytes.Compare(a, b) }\n\n" +
		"func New() Comparator { return ByteComparator{} }\n"
	if strings.Contains(src, "type Comparator struct{}") || strings.Contains(src, "func (c *Comparator) Compare()") || strings.Contains(src, "type Compare struct{}") {
		if err := os.WriteFile(target, []byte(updated), 0o644); err == nil {
			_ = exec.Command("gofmt", "-w", target).Run()
			return 1
		}
	}
	return 0
}

func repairGoDuplicateErrorVarAgainstErrorCodeFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+(Err[A-Za-z_][A-Za-z0-9_]*) redeclared in this block\s*\n\s+(.+\.go):\d+:\d+:\s+other declaration of (Err[A-Za-z_][A-Za-z0-9_]*)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type rename struct {
		line int
		old  string
		new  string
	}
	byFile := map[string][]rename{}
	for _, m := range matches {
		if m[3] != m[5] {
			continue
		}
		file := resolveGoBuildErrorPath(root, m[1])
		other := resolveGoBuildErrorPath(root, m[4])
		line, _ := strconv.Atoi(m[2])
		if file == "" || other == "" || file == other || line <= 0 {
			continue
		}
		byFile[file] = append(byFile[file], rename{line: line, old: m[3], new: m[3] + "Error"})
	}
	changed := 0
	for file, renames := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		for _, rn := range renames {
			if !goValueDeclAtLineHasName(file, rn.line, rn.old) {
				continue
			}
			src = regexp.MustCompile(`\b`+regexp.QuoteMeta(rn.old)+`\b`).ReplaceAllString(src, rn.new)
		}
		if src == string(data) {
			continue
		}
		if err := os.WriteFile(file, []byte(src), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func goValueDeclAtLineHasName(file string, line int, name string) bool {
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	fset := token.NewFileSet()
	parsed, parseErr := parser.ParseFile(fset, file, data, 0)
	if parseErr != nil {
		return false
	}
	for _, decl := range parsed.Decls {
		gen, ok := decl.(*ast.GenDecl)
		if !ok || (gen.Tok != token.VAR && gen.Tok != token.CONST) {
			continue
		}
		for _, spec := range gen.Specs {
			vs, ok := spec.(*ast.ValueSpec)
			if !ok || fset.Position(vs.Pos()).Line != line {
				continue
			}
			for _, n := range vs.Names {
				if n != nil && n.Name == name {
					return true
				}
			}
		}
	}
	return false
}

func repairGoMissingErrorCodeConstsFromBuildErrors(root, modulePath, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+undefined:\s+([A-Za-z_][A-Za-z0-9_]*)\.?(ErrCode[A-Za-z0-9_]*)\b`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		usingFile := resolveGoBuildErrorPath(root, m[1])
		alias, name := strings.TrimSpace(m[2]), strings.TrimSpace(m[3])
		if usingFile == "" || alias == "" || name == "" {
			continue
		}
		dir := ""
		if aliasImport := goImportPathForAlias(usingFile, alias); aliasImport != "" && modulePath != "" {
			rel := strings.TrimPrefix(aliasImport, modulePath+"/")
			if rel != aliasImport && rel != "" && !strings.Contains(rel, "..") {
				dir = filepath.Join(root, filepath.FromSlash(rel))
			}
		}
		if dir == "" {
			dir = filepath.Dir(usingFile)
		}
		key := dir + "\x00" + name
		if seen[key] {
			continue
		}
		seen[key] = true
		if appendGoErrorCodeConst(dir, name) {
			changed++
		}
	}
	return changed
}

func appendGoErrorCodeConst(dir, name string) bool {
	if dir == "" || name == "" {
		return false
	}
	files := goFilesInDir(dir)
	if len(files) == 0 {
		return false
	}
	var target string
	for _, file := range files {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		if strings.Contains(src, name) {
			return false
		}
		if strings.Contains(src, "type ErrorCode") {
			target = file
			break
		}
	}
	if target == "" {
		target = files[0]
	}
	data, err := os.ReadFile(target)
	if err != nil || strings.Contains(string(data), name) {
		return false
	}
	value := strings.TrimPrefix(name, "ErrCode")
	value = strings.ToUpper(regexp.MustCompile(`([a-z0-9])([A-Z])`).ReplaceAllString(value, "${1}_${2}"))
	if value == "" {
		value = strings.ToUpper(name)
	}
	src := strings.TrimRight(string(data), "\n") + "\n\nconst " + name + " ErrorCode = \"" + value + "\"\n"
	if err := os.WriteFile(target, []byte(src), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", target).Run()
	return true
}

func repairGoIntInt64OffsetMismatchesFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+(?:invalid operation: ([A-Za-z_][A-Za-z0-9_]*) \+= int64\([^)]+\) \(mismatched types int and int64\)|cannot use ([A-Za-z_][A-Za-z0-9_]*) \(variable of type int\) as int64 value)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	byFile := map[string]map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" {
			continue
		}
		name := m[3]
		if name == "" {
			name = m[4]
		}
		if name == "" {
			continue
		}
		if byFile[file] == nil {
			byFile[file] = map[string]bool{}
		}
		byFile[file][name] = true
	}
	changed := 0
	for file, names := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		updated := src
		for name := range names {
			updated = regexp.MustCompile(`\b`+regexp.QuoteMeta(name)+`\s*:=\s*([A-Za-z_][A-Za-z0-9_]*Size)\b`).ReplaceAllString(updated, name+" := int64(${1})")
			updated = regexp.MustCompile(`\b`+regexp.QuoteMeta(name)+`\s*:=\s*0\b`).ReplaceAllString(updated, name+" := int64(0)")
			updated = regexp.MustCompile(`\b`+regexp.QuoteMeta(name)+`\s*:=\s*([0-9]+)\b`).ReplaceAllString(updated, name+" := int64(${1})")
		}
		if updated == src {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoDirectionAliasesFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+undefined:\s+(Direction(?:Out|In))\b`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	byFile := map[string]map[string]string{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" {
			continue
		}
		if byFile[file] == nil {
			byFile[file] = map[string]string{}
		}
		switch m[2] {
		case "DirectionOut":
			byFile[file]["DirectionOut"] = "DirectionOutgoing"
		case "DirectionIn":
			byFile[file]["DirectionIn"] = "DirectionIncoming"
		}
	}
	for file, aliases := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		var b strings.Builder
		for alias, target := range aliases {
			if strings.Contains(src, alias+" Direction = "+target) || !strings.Contains(src, target) {
				continue
			}
			b.WriteString("\nconst " + alias + " Direction = " + target + "\n")
		}
		if b.Len() == 0 {
			continue
		}
		if err := os.WriteFile(file, []byte(src+b.String()), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoWeakLocalStubTypesFromBuildErrors(root, modulePath, buildErrors string) int {
	if root == "" || modulePath == "" {
		return 0
	}
	if !strings.Contains(buildErrors, "types.Key") && !strings.Contains(buildErrors, "types.ValueTypeNormal") {
		return 0
	}
	dir := filepath.Join(root, "internal", "types")
	files := goFilesInDir(dir)
	if len(files) == 0 {
		return 0
	}
	target := files[0]
	data, err := os.ReadFile(target)
	if err != nil {
		return 0
	}
	src := string(data)
	touched := false
	if strings.Contains(src, "type Key struct{}") || strings.Contains(src, "func (k *Key) Compare()") || strings.Contains(src, "func (k *Key) String()") {
		src = replaceOrAppendKeyStub(src)
		touched = true
	}
	if strings.Contains(src, "type ValueTypeNormal struct{}") {
		src = strings.ReplaceAll(src, "type ValueTypeNormal struct{}", "type ValueType int\n\nconst ValueTypeNormal ValueType = 0")
		touched = true
	}
	if strings.Contains(src, "type NewKey struct{}") {
		src = strings.ReplaceAll(src, "type NewKey struct{}", "func NewKey(b []byte) Key { return Key(append([]byte(nil), b...)) }")
		touched = true
	}
	if !touched {
		return 0
	}
	src = ensureImportIfUsed(src, "bytes", "bytes.")
	if err := os.WriteFile(target, []byte(src), 0o644); err != nil {
		return 0
	}
	_ = exec.Command("gofmt", "-w", target).Run()
	return 1
}

func replaceOrAppendKeyStub(src string) string {
	typeRe := regexp.MustCompile(`(?s)type\s+Key\s+struct\s*\{\s*\}\s*`)
	src = typeRe.ReplaceAllString(src, "type Key []byte\n\n")
	funcRes := []*regexp.Regexp{
		regexp.MustCompile(`(?m)^func\s*\(\s*k\s+\*?Key\s*\)\s+Compare\([^)]*\)\s*[^{]*\{\s*\}\s*$`),
		regexp.MustCompile(`(?m)^func\s*\(\s*k\s+\*?Key\s*\)\s+String\([^)]*\)\s*[^{]*\{\s*\}\s*$`),
		regexp.MustCompile(`(?m)^func\s*\(\s*k\s+\*?Key\s*\)\s+Clone\([^)]*\)\s*[^{]*\{\s*\}\s*$`),
		regexp.MustCompile(`(?m)^func\s*\(\s*k\s+\*?Key\s*\)\s+Bytes\([^)]*\)\s*[^{]*\{\s*\}\s*$`),
	}
	for _, re := range funcRes {
		src = re.ReplaceAllString(src, "")
	}
	if !strings.Contains(src, "func (k Key) Compare(") {
		src += "\nfunc (k Key) Compare(other Key) int { return bytes.Compare(k, other) }\n"
	}
	if !strings.Contains(src, "func (k Key) Clone(") {
		src += "\nfunc (k Key) Clone() Key { out := append([]byte(nil), k...); return Key(out) }\n"
	}
	if !strings.Contains(src, "func (k Key) String(") {
		src += "\nfunc (k Key) String() string { return string(k) }\n"
	}
	if !strings.Contains(src, "func (k Key) Bytes(") {
		src += "\nfunc (k Key) Bytes() []byte { return []byte(k) }\n"
	}
	return src
}

func repairGoFieldMethodConflictsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+field and method with the same name ([A-Za-z_][A-Za-z0-9_]*)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		name := m[3]
		if file == "" || line <= 0 || name == "" {
			continue
		}
		if removeGoFuncAtLine(file, line, name) {
			changed++
		}
	}
	return changed
}

func repairGoNonFunctionFieldCallsFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "invalid operation: cannot call") {
		return 0
	}
	patterns := []*regexp.Regexp{
		regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+invalid operation: cannot call non-function ([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)+)`),
		regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+invalid operation: cannot call ([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)+) \(`),
	}
	type target struct {
		line int
		expr string
	}
	byFile := map[string][]target{}
	for _, re := range patterns {
		for _, m := range re.FindAllStringSubmatch(buildErrors, -1) {
			file := resolveGoBuildErrorPath(root, m[1])
			line, _ := strconv.Atoi(m[2])
			expr := strings.TrimSpace(m[3])
			if file == "" || line <= 0 || expr == "" {
				continue
			}
			byFile[file] = append(byFile[file], target{line: line, expr: expr})
		}
	}
	if len(byFile) == 0 {
		return 0
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for _, target := range targets {
			idx := target.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			before := lines[idx]
			lines[idx] = strings.ReplaceAll(lines[idx], target.expr+"()", target.expr)
			if lines[idx] != before {
				touched = true
			}
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoDatabaseBootstrapContractFromBuildErrors(root, buildErrors string) int {
	if root == "" || !strings.Contains(buildErrors, "internal/db/bootstrap.go") {
		return 0
	}
	if !strings.Contains(buildErrors, "newMemStorageEngine") &&
		!strings.Contains(buildErrors, "newMemWAL") &&
		!strings.Contains(buildErrors, "db.path") &&
		!strings.Contains(buildErrors, "databaseExists") &&
		!strings.Contains(buildErrors, "manifestPath") {
		return 0
	}
	dbDir := filepath.Join(root, "internal", "db")
	changed := 0
	changed += repairGoReceiverStructFieldTypesInDir(dbDir, "Database", map[string]string{
		"path":         "string",
		"manifestPath": "string",
		"lockFile":     "*os.File",
		"manifest":     "*Manifest",
		"state":        "BootstrapState",
		"engine":       "bootstrapStorageEngine",
		"wal":          "bootstrapWAL",
		"indexer":      "bootstrapIndexer",
		"stats":        "*DatabaseStats",
	})
	changed += removeGoFieldFromStructInDir(dbDir, "Database", "databaseExists")
	changed += appendGoFieldToStructInDir(dbDir, "Database", "manifestPath", "string")
	changed += appendGoFieldToStructInDir(dbDir, "Database", "indexer", "bootstrapIndexer")
	changed += appendGoFieldToStructInDir(dbDir, "Database", "stats", "*DatabaseStats")
	changed += appendGoBootstrapSupportInDir(dbDir)
	return changed
}

func repairGoReceiverStructFieldTypesInDir(dir, typeName string, fieldTypes map[string]string) int {
	if dir == "" || typeName == "" || len(fieldTypes) == 0 {
		return 0
	}
	changed := 0
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		updated := string(data)
		var replacements []textReplacement
		for _, decl := range parsed.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.TYPE {
				continue
			}
			for _, spec := range gen.Specs {
				ts, ok := spec.(*ast.TypeSpec)
				if !ok || ts.Name == nil || ts.Name.Name != typeName {
					continue
				}
				st, ok := ts.Type.(*ast.StructType)
				if !ok || st.Fields == nil {
					continue
				}
				for _, field := range st.Fields.List {
					for _, name := range field.Names {
						want := fieldTypes[name.Name]
						if want == "" {
							continue
						}
						start := fset.Position(field.Type.Pos()).Offset
						end := fset.Position(field.Type.End()).Offset
						if start < 0 || end <= start || end > len(data) {
							continue
						}
						if strings.TrimSpace(string(data[start:end])) == want {
							continue
						}
						replacements = append(replacements, textReplacement{start: start, end: end, text: want})
					}
				}
			}
		}
		if len(replacements) == 0 {
			continue
		}
		sort.Slice(replacements, func(i, j int) bool { return replacements[i].start > replacements[j].start })
		for _, repl := range replacements {
			if repl.start < 0 || repl.end > len(updated) || repl.start >= repl.end {
				continue
			}
			updated = updated[:repl.start] + repl.text + updated[repl.end:]
		}
		updated = ensureImportIfUsed(updated, "os", "os.")
		if updated == string(data) {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

type textReplacement struct {
	start int
	end   int
	text  string
}

func removeGoFieldFromStructInDir(dir, typeName, fieldName string) int {
	if dir == "" || typeName == "" || fieldName == "" {
		return 0
	}
	changed := 0
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		var removals []textRange
		for _, decl := range parsed.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.TYPE {
				continue
			}
			for _, spec := range gen.Specs {
				ts, ok := spec.(*ast.TypeSpec)
				if !ok || ts.Name == nil || ts.Name.Name != typeName {
					continue
				}
				st, ok := ts.Type.(*ast.StructType)
				if !ok || st.Fields == nil {
					continue
				}
				for _, field := range st.Fields.List {
					for _, name := range field.Names {
						if name.Name != fieldName {
							continue
						}
						removals = append(removals, expandTextRangeToLine(data, fset.Position(field.Pos()).Offset, fset.Position(field.End()).Offset))
					}
				}
			}
		}
		if len(removals) == 0 {
			continue
		}
		updated := removeTextRanges(data, removals)
		if string(updated) == string(data) {
			continue
		}
		if err := os.WriteFile(file, updated, 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func appendGoBootstrapSupportInDir(dir string) int {
	if dir == "" {
		return 0
	}
	files := goFilesInDir(dir)
	if len(files) == 0 {
		return 0
	}
	target := files[0]
	data, err := os.ReadFile(target)
	if err != nil {
		return 0
	}
	src := string(data)
	var additions []string
	if !strings.Contains(src, "type bootstrapStorageEngine interface") {
		additions = append(additions, `
type bootstrapStorageEngine interface {
	Sync() error
	Close() error
}
`)
	}
	if !strings.Contains(src, "type bootstrapRecoverableEngine interface") {
		additions = append(additions, `
type bootstrapRecoverableEngine interface {
	Put(key, value []byte) error
	Delete(key []byte) error
}
`)
	}
	if !strings.Contains(src, "type bootstrapWAL interface") {
		additions = append(additions, `
type bootstrapWAL interface {
	Recover(engine bootstrapStorageEngine) error
	Close() error
}
`)
	}
	if !strings.Contains(src, "type bootstrapIndexer interface") {
		additions = append(additions, `
type bootstrapIndexer interface {
	Index(doc *Document) error
	Search(query *Query) (*ResultSet, error)
	Stats() IndexStats
}
`)
	}
	if !strings.Contains(src, "type DatabaseStats struct") {
		additions = append(additions, `
type DatabaseStats struct {
	NumReads             uint64
	NumWrites            uint64
	NumDeletes           uint64
	CacheHitRate         float64
	NumSSTables          int
	TotalSizeBytes       int64
	NumMemTables         int
	WALSizeBytes         int64
	ActiveMemTableBytes  int64
}

func newDatabaseStats() *DatabaseStats { return &DatabaseStats{} }
`)
	} else if !strings.Contains(src, "func newDatabaseStats() *DatabaseStats") {
		additions = append(additions, `
func newDatabaseStats() *DatabaseStats { return &DatabaseStats{} }
`)
	}
	if !strings.Contains(src, "type memStorageEngine struct") {
		additions = append(additions, `
type memStorageEngine struct {
	mu   sync.RWMutex
	data map[string][]byte
}

func newMemStorageEngine() *memStorageEngine {
	return &memStorageEngine{data: make(map[string][]byte)}
}

func (m *memStorageEngine) Put(key, value []byte) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.data[string(key)] = append([]byte(nil), value...)
	return nil
}

func (m *memStorageEngine) Delete(key []byte) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	delete(m.data, string(key))
	return nil
}

func (m *memStorageEngine) Sync() error { return nil }

func (m *memStorageEngine) Close() error { return nil }
`)
	}
	if !strings.Contains(src, "type memWAL struct") {
		additions = append(additions, `
type memWAL struct{}

func newMemWAL() *memWAL { return &memWAL{} }

func (w *memWAL) Recover(engine bootstrapStorageEngine) error { return nil }

func (w *memWAL) Close() error { return nil }
`)
	}
	if !strings.Contains(src, "func (db *Database) databaseExists") {
		additions = append(additions, `
func (db *Database) databaseExists(path string) bool {
	if path == "" {
		return false
	}
	if _, err := os.Stat(filepath.Join(path, "manifest.json")); err == nil {
		return true
	}
	return false
}
`)
	}
	if len(additions) == 0 {
		return 0
	}
	updated := strings.TrimRight(src, "\n") + "\n" + strings.Join(additions, "\n") + "\n"
	updated = ensureImportIfUsed(updated, "os", "os.")
	updated = ensureImportIfUsed(updated, "path/filepath", "filepath.")
	updated = ensureImportIfUsed(updated, "sync", "sync.")
	if err := os.WriteFile(target, []byte(updated), 0o644); err != nil {
		return 0
	}
	_ = exec.Command("gofmt", "-w", target).Run()
	return len(additions)
}

func repairGoMissingCategoryResourceExhaustedFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "CategoryResourceExhausted") {
		return 0
	}
	changed := 0
	patterns := []*regexp.Regexp{
		regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+CategoryResourceExhausted \(type\) is not an expression`),
		regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+undefined: CategoryResourceExhausted`),
	}
	seen := map[string]bool{}
	for _, re := range patterns {
		for _, m := range re.FindAllStringSubmatch(buildErrors, -1) {
			file := resolveGoBuildErrorPath(root, m[1])
			if file == "" || seen[file] {
				continue
			}
			seen[file] = true
			data, err := os.ReadFile(file)
			if err != nil {
				continue
			}
			src := string(data)
			if !strings.Contains(src, "CategoryResourceExhausted") {
				continue
			}
			updated := strings.ReplaceAll(src, "CategoryResourceExhausted", "CategoryInternal")
			if updated == src {
				continue
			}
			if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
				changed++
				_ = exec.Command("gofmt", "-w", file).Run()
			}
		}
	}
	return changed
}

func repairGoScanIteratorContractsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+[A-Za-z_][A-Za-z0-9_\.]*\.Scan undefined \(type ([A-Za-z_][A-Za-z0-9_]*) has no field or method Scan\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seenDirInterface := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || m[2] == "" {
			continue
		}
		dir := filepath.Dir(file)
		key := dir + "\x00" + m[2]
		if seenDirInterface[key] {
			continue
		}
		seenDirInterface[key] = true
		changed += ensureGoIteratorContractInDir(dir, m[2])
	}
	return changed
}

func repairGoSyncableWriteCloserFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+.+\.Sync undefined \(type io\.WriteCloser has no field or method Sync\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	fieldType := regexp.MustCompile(`\b([A-Za-z_][A-Za-z0-9_]*\s+)io\.WriteCloser\b`)
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || seen[file] {
			continue
		}
		seen[file] = true
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		updated := fieldType.ReplaceAllString(src, `${1}*os.File`)
		if updated == src {
			continue
		}
		updated = ensureImportIfUsed(updated, "os", "os.")
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoSlogSyncCallsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+.+\.Sync undefined \(type \*slog\.Logger has no field or method Sync\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type targetLine struct {
		file string
		line int
	}
	var targets []targetLine
	for _, m := range matches {
		line, _ := strconv.Atoi(m[2])
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || line <= 0 {
			continue
		}
		targets = append(targets, targetLine{file: file, line: line})
	}
	if len(targets) == 0 {
		return 0
	}
	byFile := map[string][]int{}
	for _, target := range targets {
		byFile[target.file] = append(byFile[target.file], target.line)
	}
	changed := 0
	for file, linesToPatch := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for _, lineNo := range linesToPatch {
			idx := lineNo - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			line := lines[idx]
			trimmed := strings.TrimSpace(line)
			switch {
			case strings.HasPrefix(trimmed, "return ") && strings.Contains(trimmed, ".Sync()"):
				lines[idx] = leadingWhitespace(line) + "return nil"
				touched = true
			case strings.Contains(trimmed, ".Sync()"):
				lines[idx] = leadingWhitespace(line) + "// slog.Logger has no buffered Sync operation."
				touched = true
			}
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoUndefinedSyscallMsyncFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+undefined:\s+syscall\.Msync`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type targetLine struct{ line int }
	byFile := map[string][]targetLine{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		if file == "" || line <= 0 {
			continue
		}
		byFile[file] = append(byFile[file], targetLine{line: line})
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for _, target := range targets {
			idx := target.line - 1
			if idx < 0 || idx >= len(lines) || !strings.Contains(lines[idx], "syscall.Msync") {
				continue
			}
			lines[idx] = leadingWhitespace(lines[idx]) + "err := error(nil)"
			touched = true
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoImportedLocalSelectorStubsFromBuildErrors(root, modulePath, buildErrors string) int {
	if modulePath == "" {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+undefined:\s+([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		alias, selector := m[2], m[3]
		if file == "" || alias == "" || selector == "" {
			continue
		}
		importPath := goImportPathForAlias(file, alias)
		if importPath == "" || !strings.HasPrefix(importPath, modulePath+"/") {
			continue
		}
		rel := strings.TrimPrefix(importPath, modulePath+"/")
		dir := filepath.Join(root, filepath.FromSlash(rel))
		key := dir + "\x00" + selector
		if seen[key] {
			continue
		}
		seen[key] = true
		changed += appendGoLocalSelectorStub(dir, selector)
	}
	return changed
}

func goImportPathForAlias(file, alias string) string {
	data, err := os.ReadFile(file)
	if err != nil {
		return ""
	}
	fset := token.NewFileSet()
	parsed, parseErr := parser.ParseFile(fset, file, data, parser.ImportsOnly)
	if parseErr != nil {
		return ""
	}
	for _, imp := range parsed.Imports {
		if imp.Path == nil {
			continue
		}
		importPath, err := strconv.Unquote(imp.Path.Value)
		if err != nil {
			continue
		}
		impAlias := pathBase(importPath)
		if imp.Name != nil && imp.Name.Name != "" && imp.Name.Name != "." && imp.Name.Name != "_" {
			impAlias = imp.Name.Name
		}
		if impAlias == alias {
			return importPath
		}
	}
	return ""
}

func appendGoLocalSelectorStub(dir, selector string) int {
	if dir == "" || selector == "" {
		return 0
	}
	files := goFilesInDir(dir)
	if len(files) == 0 {
		return 0
	}
	for _, file := range files {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		if regexp.MustCompile(`\b(func|type|var|const)\s+` + regexp.QuoteMeta(selector) + `\b`).Match(data) {
			return 0
		}
	}
	src := goLocalSelectorStubSource(selector)
	if src == "" {
		return 0
	}
	target := files[0]
	data, err := os.ReadFile(target)
	if err != nil {
		return 0
	}
	updated := string(data) + "\n" + src + "\n"
	updated = ensureImportIfUsed(updated, "errors", "errors.")
	if err := os.WriteFile(target, []byte(updated), 0o644); err != nil {
		return 0
	}
	_ = exec.Command("gofmt", "-w", target).Run()
	return 1
}

func goLocalSelectorStubSource(selector string) string {
	switch selector {
	case "IsNotFound":
		return "func IsNotFound(err error) bool { return Is(err, ErrCodeNotFound) }"
	default:
		if strings.HasPrefix(selector, "Op") && len(selector) > len("Op") {
			return "const " + selector + " = Query" + selector
		}
		if strings.HasPrefix(selector, "Is") {
			return "func " + selector + "(err error) bool { return false }"
		}
		if strings.HasPrefix(selector, "Err") && len(selector) > len("Err") {
			return "var " + selector + " = errors.New(" + strconv.Quote(goErrorMessageFromSelector(selector)) + ")"
		}
	}
	return ""
}

func goErrorMessageFromSelector(selector string) string {
	name := strings.TrimPrefix(selector, "Err")
	if name == "" {
		return "generated error"
	}
	var words []string
	var current strings.Builder
	for i, r := range name {
		if i > 0 && r >= 'A' && r <= 'Z' && current.Len() > 0 {
			words = append(words, strings.ToLower(current.String()))
			current.Reset()
		}
		current.WriteRune(r)
	}
	if current.Len() > 0 {
		words = append(words, strings.ToLower(current.String()))
	}
	if len(words) == 0 {
		return strings.ToLower(name)
	}
	return strings.Join(words, " ")
}

func repairGoMissingLocalPackageStubsFromBuildErrors(root, modulePath, buildErrors string) int {
	if root == "" || modulePath == "" {
		return 0
	}
	re := regexp.MustCompile(`package (` + regexp.QuoteMeta(modulePath) + `/[^\s]+) is not in std`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	for _, m := range matches {
		importPath := strings.TrimSpace(m[1])
		if importPath == "" || goLocalImportExists(root, modulePath, importPath) {
			continue
		}
		rel := strings.TrimPrefix(importPath, modulePath+"/")
		if rel == importPath || rel == "" || strings.Contains(rel, "..") {
			continue
		}
		selectors := goImportSelectorsForPath(root, importPath)
		if len(selectors) == 0 {
			continue
		}
		dir := filepath.Join(root, filepath.FromSlash(rel))
		if err := os.MkdirAll(dir, 0o755); err != nil {
			continue
		}
		file := filepath.Join(dir, "stub.go")
		if _, err := os.Stat(file); err == nil {
			continue
		}
		src := synthesizeGoLocalPackageStub(importPath, selectors)
		if src == "" {
			continue
		}
		if err := os.WriteFile(file, []byte(src), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoKeywordImportAliases(root string) int {
	if root == "" {
		return 0
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		updated := string(data)
		seen := map[string]bool{}
		importPathRe := regexp.MustCompile(`"([^"]+)"`)
		for _, match := range importPathRe.FindAllStringSubmatch(updated, -1) {
			if len(match) != 2 || match[1] == "" {
				continue
			}
			importPath := match[1]
			if seen[importPath] {
				continue
			}
			seen[importPath] = true
			base := pathBase(importPath)
			if !isGoKeywordPackageName(base) {
				continue
			}
			alias := safeGoPackageName(base)
			if alias == "" || alias == base {
				continue
			}
			updated = ensureImportAliasForPath(updated, alias, importPath)
			updated = strings.ReplaceAll(updated, base+".", alias+".")
		}
		if updated == string(data) {
			return nil
		}
		if writeErr := os.WriteFile(p, []byte(updated), info.Mode()); writeErr == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func ensureImportAliasForPath(src, alias, importPath string) string {
	quoted := strconv.Quote(importPath)
	base := regexp.QuoteMeta(pathBase(importPath))
	quotedRe := regexp.QuoteMeta(quoted)
	single := regexp.MustCompile(`(?m)^(\s*import\s+)(?:` + base + `\s+)?` + quotedRe + `(\s*(?://[^\n]*)?)$`)
	if single.MatchString(src) {
		return single.ReplaceAllString(src, "${1}"+alias+" "+quoted+"${2}")
	}
	blockLine := regexp.MustCompile(`(?m)^(\s*)(?:` + base + `\s+)?` + quotedRe + `(\s*(?://[^\n]*)?)$`)
	return blockLine.ReplaceAllString(src, "${1}"+alias+" "+quoted+"${2}")
}

func repairGoMissingUnusedLocalImportsFromBuildErrors(root, modulePath, buildErrors string) int {
	if root == "" || modulePath == "" {
		return 0
	}
	re := regexp.MustCompile(`package (` + regexp.QuoteMeta(modulePath) + `/[^\s]+) is not in std`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	for _, m := range matches {
		importPath := strings.TrimSpace(m[1])
		if importPath == "" || goLocalImportExists(root, modulePath, importPath) {
			continue
		}
		if len(goImportSelectorsForPath(root, importPath)) > 0 {
			continue
		}
		changed += removeGoImportFromWorkspace(root, importPath)
	}
	return changed
}

func removeGoImportFromWorkspace(root, importPath string) int {
	if root == "" || importPath == "" {
		return 0
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		if removeGoImportByPath(p, importPath) {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func goImportSelectorsForPath(root, importPath string) map[string]bool {
	selectors := map[string]bool{}
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		f, parseErr := parser.ParseFile(token.NewFileSet(), p, data, parser.ImportsOnly)
		if parseErr != nil {
			return nil
		}
		alias := ""
		for _, imp := range f.Imports {
			pth, unquoteErr := strconv.Unquote(imp.Path.Value)
			if unquoteErr != nil || pth != importPath {
				continue
			}
			if imp.Name != nil && imp.Name.Name != "" && imp.Name.Name != "." && imp.Name.Name != "_" {
				alias = imp.Name.Name
			} else {
				alias = pathBase(importPath)
			}
			break
		}
		if alias == "" {
			return nil
		}
		re := regexp.MustCompile(`\b` + regexp.QuoteMeta(alias) + `\.([A-Za-z_][A-Za-z0-9_]*)\b`)
		for _, m := range re.FindAllStringSubmatch(string(data), -1) {
			if len(m) == 2 && m[1] != "" {
				selectors[m[1]] = true
			}
		}
		return nil
	})
	return selectors
}

func synthesizeGoLocalPackageStub(importPath string, selectors map[string]bool) string {
	pkg := safeGoPackageName(pathBase(importPath))
	if pkg == "" {
		return ""
	}
	if pkg == "segment" && (selectors["File"] || strings.Contains(importPath, "/wal/segment")) {
		return synthesizeGoWALSegmentPackage()
	}
	needsContext := selectors["NodeStore"]
	needsBytes := selectors["Key"]
	needsErrors := false
	for name := range selectors {
		if strings.HasPrefix(name, "Err") {
			needsErrors = true
			break
		}
	}
	var b strings.Builder
	b.WriteString("package " + pkg + "\n\n")
	var imports []string
	if needsBytes {
		imports = append(imports, "bytes")
	}
	if needsContext {
		imports = append(imports, "context")
	}
	if needsErrors {
		imports = append(imports, "errors")
	}
	if len(imports) > 0 {
		b.WriteString("import (\n")
		for _, imp := range imports {
			b.WriteString("\t" + strconv.Quote(imp) + "\n")
		}
		b.WriteString(")\n\n")
	}
	names := make([]string, 0, len(selectors))
	for name := range selectors {
		names = append(names, name)
	}
	sort.Strings(names)
	for _, name := range names {
		switch {
		case name == "Key":
			b.WriteString("type Key []byte\n\n")
			b.WriteString("func (k Key) Compare(other Key) int { return bytes.Compare(k, other) }\n\n")
			b.WriteString("func (k Key) Clone() Key { out := append([]byte(nil), k...); return Key(out) }\n\n")
			b.WriteString("func (k Key) String() string { return string(k) }\n\n")
			b.WriteString("func (k Key) Bytes() []byte { return []byte(k) }\n\n")
		case name == "NewKey":
			b.WriteString("func NewKey(b []byte) Key { return Key(append([]byte(nil), b...)) }\n\n")
		case name == "ValueTypeNormal":
			b.WriteString("type ValueType int\n\n")
			b.WriteString("const ValueTypeNormal ValueType = 0\n\n")
		case name == "Node":
			b.WriteString("type Node struct {\n\tID string\n\tOutEdges []string\n\tInEdges []string\n}\n\n")
		case name == "NodeStore":
			b.WriteString("type NodeStore interface {\n\tGetNode(ctx context.Context, id string) (*Node, error)\n}\n\n")
		case strings.HasPrefix(name, "Err"):
			b.WriteString("var " + name + " = errors.New(" + strconv.Quote(strings.ToLower(strings.TrimPrefix(name, "Err"))) + ")\n\n")
		case strings.HasSuffix(name, "Store"):
			b.WriteString("type " + name + " interface{}\n\n")
		default:
			b.WriteString("type " + name + " struct{}\n\n")
		}
	}
	return b.String()
}

func synthesizeGoWALSegmentPackage() string {
	return `package segment

import (
	"os"
	"path/filepath"
)

type File struct {
	id   uint64
	path string
	file *os.File
}

func NewFile(dir string, id uint64) (*File, error) {
	if err := os.MkdirAll(dir, 0755); err != nil {
		return nil, err
	}
	path := filepath.Join(dir, "segment-"+strconvFormatUint(id)+".wal")
	f, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR|os.O_APPEND, 0644)
	if err != nil {
		return nil, err
	}
	return &File{id: id, path: path, file: f}, nil
}

func Open(path string, id uint64) (*File, error) {
	f, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR|os.O_APPEND, 0644)
	if err != nil {
		return nil, err
	}
	return &File{id: id, path: path, file: f}, nil
}

func (f *File) ID() uint64 { return f.id }

func (f *File) Path() string { return f.path }

func (f *File) Size() (int64, error) {
	info, err := os.Stat(f.path)
	if err != nil {
		return 0, err
	}
	return info.Size(), nil
}

func (f *File) Close() error {
	if f == nil || f.file == nil {
		return nil
	}
	err := f.file.Close()
	f.file = nil
	return err
}

func strconvFormatUint(v uint64) string {
	if v == 0 {
		return "0"
	}
	var buf [20]byte
	i := len(buf)
	for v > 0 {
		i--
		buf[i] = byte('0' + v%10)
		v /= 10
	}
	return string(buf[i:])
}
`
}

func ensureGoIteratorContractInDir(dir, interfaceName string) int {
	if dir == "" || interfaceName == "" || !goTypeExistsInDir(dir, "Iterator") {
		return 0
	}
	changed := 0
	changed += appendGoMethodToInterfaceInDir(dir, interfaceName, "Scan(prefix []byte) (*Iterator, error)")
	changed += appendGoScanMethodForIteratorOwner(dir)
	changed += appendGoIteratorAuxMethods(dir)
	return changed
}

func appendGoMethodToInterfaceInDir(dir, interfaceName, methodSig string) int {
	methodName := goMethodNameFromSignature(methodSig)
	if methodName == "" {
		return 0
	}
	files := goFilesInDir(dir)
	for _, file := range files {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.TYPE {
				continue
			}
			for _, spec := range gen.Specs {
				ts, ok := spec.(*ast.TypeSpec)
				if !ok || ts.Name == nil || ts.Name.Name != interfaceName {
					continue
				}
				iface, ok := ts.Type.(*ast.InterfaceType)
				if !ok || iface.Methods == nil {
					continue
				}
				if interfaceHasMethod(iface, methodName) {
					return 0
				}
				insertAt := fset.Position(iface.Methods.Closing).Offset
				if insertAt <= 0 || insertAt > len(data) {
					continue
				}
				updated := string(data[:insertAt]) + "\t" + methodSig + "\n" + string(data[insertAt:])
				if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
					_ = exec.Command("gofmt", "-w", file).Run()
					return 1
				}
			}
		}
	}
	return 0
}

func appendGoScanMethodForIteratorOwner(dir string) int {
	files := goFilesInDir(dir)
	for _, file := range files {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		if !strings.Contains(src, "NewIterator() *Iterator") || strings.Contains(src, ") Scan(prefix []byte) (*Iterator, error)") {
			continue
		}
		re := regexp.MustCompile(`func\s*\(\s*([A-Za-z_][A-Za-z0-9_]*)\s+\*([A-Za-z_][A-Za-z0-9_]*)\s*\)\s+NewIterator\s*\(\s*\)\s+\*Iterator`)
		m := re.FindStringSubmatch(src)
		if len(m) != 3 {
			continue
		}
		addition := fmt.Sprintf(`

func (%s *%s) Scan(prefix []byte) (*Iterator, error) {
	it := %s.NewIterator()
	if seeker, ok := interface{}(it).(interface{ Seek([]byte) }); ok {
		seeker.Seek(prefix)
	}
	return it, nil
}
`, m[1], m[2], m[1])
		if err := os.WriteFile(file, []byte(src+addition), 0o644); err == nil {
			_ = exec.Command("gofmt", "-w", file).Run()
			return 1
		}
	}
	return 0
}

func appendGoIteratorAuxMethods(dir string) int {
	files := goFilesInDir(dir)
	changed := 0
	for _, file := range files {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		if !strings.Contains(src, "type Iterator struct") {
			continue
		}
		var additions []string
		if !regexp.MustCompile(`func\s*\([^)]*\*Iterator[^)]*\)\s+Error\s*\(\s*\)\s+error`).MatchString(src) {
			additions = append(additions, "\nfunc (it *Iterator) Error() error { return nil }\n")
		}
		if !regexp.MustCompile(`func\s*\([^)]*\*Iterator[^)]*\)\s+Close\s*\(\s*\)\s+error`).MatchString(src) {
			additions = append(additions, "\nfunc (it *Iterator) Close() error { return nil }\n")
		}
		if !regexp.MustCompile(`func\s*\([^)]*\*Iterator[^)]*\)\s+Seek\s*\(\s*prefix\s+\[\]byte\s*\)`).MatchString(src) {
			additions = append(additions, "\nfunc (it *Iterator) Seek(prefix []byte) {}\n")
		}
		if len(additions) == 0 {
			continue
		}
		if err := os.WriteFile(file, []byte(src+strings.Join(additions, "")), 0o644); err == nil {
			changed += len(additions)
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func interfaceHasMethod(iface *ast.InterfaceType, method string) bool {
	if iface == nil || iface.Methods == nil {
		return false
	}
	for _, field := range iface.Methods.List {
		for _, name := range field.Names {
			if name != nil && name.Name == method {
				return true
			}
		}
	}
	return false
}

func goInterfaceExistsInDir(dir, typeName string) bool {
	return goTypeKindExistsInDir(dir, typeName, "interface")
}

func goStructExistsInDir(dir, typeName string) bool {
	return goTypeKindExistsInDir(dir, typeName, "struct")
}

func goTypeKindExistsInDir(dir, typeName, kind string) bool {
	for _, file := range goFilesInDir(dir) {
		parsed, parseErr := parser.ParseFile(token.NewFileSet(), file, nil, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.TYPE {
				continue
			}
			for _, spec := range gen.Specs {
				ts, ok := spec.(*ast.TypeSpec)
				if !ok || ts.Name == nil || ts.Name.Name != typeName {
					continue
				}
				switch kind {
				case "interface":
					_, ok = ts.Type.(*ast.InterfaceType)
				case "struct":
					_, ok = ts.Type.(*ast.StructType)
				}
				if ok {
					return true
				}
			}
		}
	}
	return false
}

func goMethodSignatureInDir(dir, method string) string {
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			fn, ok := decl.(*ast.FuncDecl)
			if !ok || fn.Recv == nil || fn.Name == nil || fn.Name.Name != method {
				continue
			}
			start := fset.Position(fn.Name.End()).Offset
			end := fset.Position(fn.Type.End()).Offset
			if start <= 0 || end <= start || end > len(data) {
				continue
			}
			return method + strings.TrimSpace(string(data[start:end]))
		}
	}
	return ""
}

func goInterfaceMethodSignatureInDir(dir, ifaceName, method string) string {
	if ifaceName == "" || method == "" {
		return ""
	}
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.TYPE {
				continue
			}
			for _, spec := range gen.Specs {
				ts, ok := spec.(*ast.TypeSpec)
				if !ok || ts.Name == nil || ts.Name.Name != ifaceName {
					continue
				}
				iface, ok := ts.Type.(*ast.InterfaceType)
				if !ok || iface.Methods == nil {
					continue
				}
				for _, field := range iface.Methods.List {
					if len(field.Names) == 0 || field.Names[0] == nil || field.Names[0].Name != method {
						continue
					}
					var buf bytes.Buffer
					if err := printer.Fprint(&buf, fset, field.Type); err != nil {
						continue
					}
					sig := strings.TrimSpace(buf.String())
					sig = strings.TrimPrefix(sig, "func")
					return method + strings.TrimSpace(sig)
				}
			}
		}
	}
	return ""
}

func appendGoFieldToStructInDir(dir, typeName, fieldName, fieldType string) int {
	if fieldType == "" {
		fieldType = "any"
	}
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.TYPE {
				continue
			}
			for _, spec := range gen.Specs {
				ts, ok := spec.(*ast.TypeSpec)
				if !ok || ts.Name == nil || ts.Name.Name != typeName {
					continue
				}
				st, ok := ts.Type.(*ast.StructType)
				if !ok || st.Fields == nil {
					continue
				}
				if structHasField(st, fieldName) {
					return 0
				}
				insertAt := fset.Position(st.Fields.Closing).Offset
				if insertAt <= 0 || insertAt > len(data) {
					continue
				}
				updated := string(data[:insertAt]) + "\t" + fieldName + " " + fieldType + "\n" + string(data[insertAt:])
				updated = ensureImportIfUsed(updated, "time", "time.")
				if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
					_ = exec.Command("gofmt", "-w", file).Run()
					return 1
				}
			}
		}
	}
	return 0
}

func structHasField(st *ast.StructType, fieldName string) bool {
	if st == nil || st.Fields == nil {
		return false
	}
	for _, field := range st.Fields.List {
		for _, name := range field.Names {
			if name != nil && name.Name == fieldName {
				return true
			}
		}
	}
	return false
}

func goStructFieldNamesInDir(dir, typeName string) []string {
	if typeName == "" {
		return nil
	}
	var out []string
	for _, file := range goFilesInDir(dir) {
		parsed, parseErr := parser.ParseFile(token.NewFileSet(), file, nil, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.TYPE {
				continue
			}
			for _, spec := range gen.Specs {
				ts, ok := spec.(*ast.TypeSpec)
				if !ok || ts.Name == nil || ts.Name.Name != typeName {
					continue
				}
				st, ok := ts.Type.(*ast.StructType)
				if !ok || st.Fields == nil {
					continue
				}
				for _, field := range st.Fields.List {
					for _, name := range field.Names {
						if name != nil && name.Name != "" {
							out = append(out, name.Name)
						}
					}
				}
			}
		}
	}
	return uniqueStrings(out)
}

func goReceiverTypeAtLine(file, recvName string, line int) string {
	data, err := os.ReadFile(file)
	if err != nil {
		return ""
	}
	fset := token.NewFileSet()
	parsed, parseErr := parser.ParseFile(fset, file, data, 0)
	if parseErr != nil {
		return ""
	}
	for _, decl := range parsed.Decls {
		fn, ok := decl.(*ast.FuncDecl)
		if !ok || fn.Recv == nil || len(fn.Recv.List) == 0 {
			continue
		}
		start := fset.Position(fn.Pos()).Line
		end := fset.Position(fn.End()).Line
		if line < start || line > end {
			continue
		}
		field := fn.Recv.List[0]
		for _, name := range field.Names {
			if name != nil && name.Name == recvName {
				return receiverTypeName(field.Type)
			}
		}
	}
	return ""
}

func closestGoFieldName(bad string, fields []string) string {
	return closestGoFieldNameExcluding(bad, fields, "")
}

func closestGoFieldNameExcluding(bad string, fields []string, excluded string) string {
	best := ""
	bestDist := 3
	bestSuffix := -1
	for _, field := range fields {
		if field == excluded {
			continue
		}
		dist := levenshteinDistance(strings.ToLower(bad), strings.ToLower(field))
		suffix := commonSuffixLen(strings.ToLower(bad), strings.ToLower(field))
		if dist < bestDist || (dist == bestDist && suffix > bestSuffix) {
			bestDist = dist
			bestSuffix = suffix
			best = field
		}
	}
	return best
}

func commonSuffixLen(a, b string) int {
	i, j := len(a)-1, len(b)-1
	n := 0
	for i >= 0 && j >= 0 && a[i] == b[j] {
		n++
		i--
		j--
	}
	return n
}

func inferredGoFieldType(field string) string {
	lower := strings.ToLower(field)
	switch {
	case strings.Contains(lower, "time"):
		return "time.Time"
	case lower == "key" || strings.HasSuffix(lower, "key") || lower == "value" || strings.HasSuffix(lower, "value"):
		return "[]byte"
	case strings.Contains(lower, "offset"):
		return "int64"
	case strings.Contains(lower, "level") || strings.Contains(lower, "capacity") ||
		strings.Contains(lower, "count") || strings.Contains(lower, "size") ||
		strings.HasPrefix(lower, "max") || strings.HasPrefix(lower, "min"):
		return "int"
	case strings.Contains(lower, "enabled") || strings.HasPrefix(lower, "is") || strings.HasPrefix(lower, "has"):
		return "bool"
	case strings.Contains(lower, "name") || strings.Contains(lower, "id") || strings.Contains(lower, "type"):
		return "string"
	default:
		return "any"
	}
}

func inferredGoStructFieldType(typeName, field string) string {
	lower := strings.ToLower(field)
	if typeName == "CompactionConfig" {
		switch {
		case strings.Contains(lower, "enable") || strings.Contains(lower, "enabled") || strings.HasPrefix(lower, "is") || strings.HasPrefix(lower, "has"):
			return "bool"
		case strings.Contains(lower, "ratio"):
			return "float64"
		case strings.Contains(lower, "interval") || strings.Contains(lower, "duration"):
			return "time.Duration"
		case strings.Contains(lower, "size"):
			return "int64"
		case strings.Contains(lower, "level") || strings.Contains(lower, "files") ||
			strings.Contains(lower, "concurrent") || strings.Contains(lower, "threshold") ||
			strings.Contains(lower, "multiplier"):
			return "int"
		}
	}
	switch {
	case lower == "createdat" || lower == "updatedat" || lower == "deletedat" || lower == "timestamp" || lower == "expiresat":
		return "time.Time"
	case lower == "messages":
		return "[]Message"
	case strings.Contains(lower, "metadata") || strings.Contains(lower, "attrs") || strings.Contains(lower, "attributes"):
		return "map[string]any"
	case lower == "payload" || lower == "data":
		return "[]byte"
	default:
		return inferredGoFieldType(field)
	}
}

func levenshteinDistance(a, b string) int {
	if a == b {
		return 0
	}
	if len(a) == 0 {
		return len(b)
	}
	if len(b) == 0 {
		return len(a)
	}
	prev := make([]int, len(b)+1)
	for j := range prev {
		prev[j] = j
	}
	for i := 1; i <= len(a); i++ {
		cur := make([]int, len(b)+1)
		cur[0] = i
		for j := 1; j <= len(b); j++ {
			cost := 0
			if a[i-1] != b[j-1] {
				cost = 1
			}
			cur[j] = min(prev[j]+1, min(cur[j-1]+1, prev[j-1]+cost))
		}
		prev = cur
	}
	return prev[len(b)]
}

func goTypeExistsInDir(dir, typeName string) bool {
	for _, file := range goFilesInDir(dir) {
		parsed, parseErr := parser.ParseFile(token.NewFileSet(), file, nil, 0)
		if parseErr != nil {
			continue
		}
		for _, decl := range parsed.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.TYPE {
				continue
			}
			for _, spec := range gen.Specs {
				ts, ok := spec.(*ast.TypeSpec)
				if ok && ts.Name != nil && ts.Name.Name == typeName {
					return true
				}
			}
		}
	}
	return false
}

func goFilesInDir(dir string) []string {
	entries, err := os.ReadDir(dir)
	if err != nil {
		return nil
	}
	var files []string
	for _, entry := range entries {
		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".go") {
			continue
		}
		files = append(files, filepath.Join(dir, entry.Name()))
	}
	sort.Strings(files)
	return files
}

func goDirsByPackageName(root, pkgName string) []string {
	var dirs []string
	seen := map[string]bool{}
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if !info.IsDir() {
			return nil
		}
		switch info.Name() {
		case ".git", ".claude-go", "vendor", "node_modules":
			return filepath.SkipDir
		}
		if firstGoPackageNameInDir(p) == pkgName && !seen[p] {
			seen[p] = true
			dirs = append(dirs, p)
		}
		return nil
	})
	sort.Strings(dirs)
	return dirs
}

func goDirsDefiningType(root, typeName string) []string {
	var dirs []string
	seen := map[string]bool{}
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		for _, name := range goTypeNamesInFile(p) {
			if name == typeName {
				dir := filepath.Dir(p)
				if !seen[dir] {
					seen[dir] = true
					dirs = append(dirs, dir)
				}
			}
		}
		return nil
	})
	sort.Strings(dirs)
	return dirs
}

func goTypeNamesInFile(file string) []string {
	data, err := os.ReadFile(file)
	if err != nil {
		return nil
	}
	fset := token.NewFileSet()
	parsed, err := parser.ParseFile(fset, file, data, 0)
	if err != nil {
		return nil
	}
	var names []string
	for _, decl := range parsed.Decls {
		gen, ok := decl.(*ast.GenDecl)
		if !ok || gen.Tok != token.TYPE {
			continue
		}
		for _, spec := range gen.Specs {
			ts, ok := spec.(*ast.TypeSpec)
			if ok && ts.Name != nil {
				names = append(names, ts.Name.Name)
			}
		}
	}
	return names
}

func replaceGoConstructorTypeWithFunc(dir, constructor, typeName string) int {
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		re := regexp.MustCompile(`(?m)^type\s+` + regexp.QuoteMeta(constructor) + `\s+struct\s*\{\s*\}\s*$`)
		if !re.MatchString(src) {
			continue
		}
		updated := re.ReplaceAllString(src, "func "+constructor+"() "+typeName+" { return "+typeName+"{} }")
		if updated == src {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			_ = exec.Command("gofmt", "-w", file).Run()
			return 1
		}
	}
	return 0
}

func appendGoMethodStubToTypeInDir(dir, typeName, method string) int {
	files := goFilesInDir(dir)
	if len(files) == 0 || !goStructExistsInDir(dir, typeName) {
		return 0
	}
	for _, file := range files {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		if regexp.MustCompile(`func\s*\([^)]*\*?` + regexp.QuoteMeta(typeName) + `[^)]*\)\s+` + regexp.QuoteMeta(method) + `\s*\(`).Match(data) {
			return 0
		}
	}
	target := files[0]
	addition := goMethodStubSource(typeName, method)
	if addition == "" {
		return 0
	}
	f, err := os.OpenFile(target, os.O_APPEND|os.O_WRONLY, 0o644)
	if err != nil {
		return 0
	}
	defer f.Close()
	if _, err := f.WriteString("\n" + addition + "\n"); err != nil {
		return 0
	}
	_ = exec.Command("gofmt", "-w", target).Run()
	return 1
}

func appendGoMethodStubWithSignatureToTypeInDir(dir, typeName, signature string) int {
	files := goFilesInDir(dir)
	if len(files) == 0 || !goStructExistsInDir(dir, typeName) {
		return 0
	}
	method := goMethodNameFromSignature(signature)
	if method == "" {
		return 0
	}
	for _, file := range files {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		if regexp.MustCompile(`func\s*\([^)]*\*?` + regexp.QuoteMeta(typeName) + `[^)]*\)\s+` + regexp.QuoteMeta(method) + `\s*\(`).Match(data) {
			return 0
		}
	}
	target := files[0]
	recv := strings.ToLower(typeName[:1])
	body := goMethodStubBodyForSignatureAndReceiver(signature, method, recv)
	addition := fmt.Sprintf("func (%s *%s) %s %s", recv, typeName, signature, body)
	f, err := os.OpenFile(target, os.O_APPEND|os.O_WRONLY, 0o644)
	if err != nil {
		return 0
	}
	defer f.Close()
	if _, err := f.WriteString("\n" + addition + "\n"); err != nil {
		return 0
	}
	_ = exec.Command("gofmt", "-w", target).Run()
	return 1
}

func goMethodNameFromSignature(signature string) string {
	signature = strings.TrimSpace(signature)
	if idx := strings.Index(signature, "("); idx > 0 {
		return strings.TrimSpace(signature[:idx])
	}
	return ""
}

func goMethodStubBodyForSignatureAndReceiver(signature, method, recv string) string {
	result := strings.TrimSpace(goMethodResultFromSignature(signature))
	if method == "Clone" && recv != "" && result != "" && !strings.Contains(result, ",") && !strings.HasPrefix(result, "(") {
		return "{ return " + recv + " }"
	}
	return goMethodStubBodyForSignature(signature)
}

func goMethodStubBodyForSignature(signature string) string {
	result := strings.TrimSpace(goMethodResultFromSignature(signature))
	if result == "" {
		return "{}"
	}
	if strings.HasPrefix(result, "(") && strings.HasSuffix(result, ")") {
		inner := strings.TrimSpace(strings.TrimSuffix(strings.TrimPrefix(result, "("), ")"))
		if goResultListAppearsNamed(inner) {
			return "{ return }"
		}
		parts := splitGoResultList(inner)
		zeros := make([]string, 0, len(parts))
		for _, part := range parts {
			zeros = append(zeros, zeroGoReturnValue(part))
		}
		return "{ return " + strings.Join(zeros, ", ") + " }"
	}
	return "{ return " + zeroGoReturnValue(result) + " }"
}

func goMethodResultFromSignature(signature string) string {
	idx := strings.Index(signature, "(")
	if idx < 0 {
		return ""
	}
	depth := 0
	for i := idx; i < len(signature); i++ {
		switch signature[i] {
		case '(':
			depth++
		case ')':
			depth--
			if depth == 0 {
				return strings.TrimSpace(signature[i+1:])
			}
		}
	}
	return ""
}

func goResultListAppearsNamed(result string) bool {
	for _, part := range splitGoResultList(result) {
		fields := strings.Fields(strings.TrimSpace(part))
		if len(fields) >= 2 && regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`).MatchString(fields[0]) {
			return true
		}
	}
	return false
}

func splitGoResultList(result string) []string {
	var parts []string
	depth := 0
	start := 0
	for i, r := range result {
		switch r {
		case '(', '[', '{':
			depth++
		case ')', ']', '}':
			if depth > 0 {
				depth--
			}
		case ',':
			if depth == 0 {
				parts = append(parts, strings.TrimSpace(result[start:i]))
				start = i + 1
			}
		}
	}
	if start <= len(result) {
		if tail := strings.TrimSpace(result[start:]); tail != "" {
			parts = append(parts, tail)
		}
	}
	return parts
}

func zeroGoReturnValue(resultType string) string {
	resultType = strings.TrimSpace(resultType)
	fields := strings.Fields(resultType)
	if len(fields) >= 2 && regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`).MatchString(fields[0]) {
		resultType = fields[len(fields)-1]
	}
	switch resultType {
	case "error", "any", "interface{}":
		return "nil"
	case "bool":
		return "false"
	case "string":
		return `""`
	case "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64", "uintptr", "float32", "float64", "byte", "rune":
		return "0"
	}
	if strings.HasPrefix(resultType, "*") || strings.HasPrefix(resultType, "[]") || strings.HasPrefix(resultType, "map[") ||
		strings.HasPrefix(resultType, "chan ") || strings.HasPrefix(resultType, "func(") || strings.HasPrefix(resultType, "<-chan ") {
		return "nil"
	}
	return resultType + "{}"
}

func goMethodStubSource(typeName, method string) string {
	recv := strings.ToLower(typeName[:1])
	switch method {
	case "Enqueue":
		return fmt.Sprintf("func (%s *%s) Enqueue(value any) {}", recv, typeName)
	case "Dequeue":
		return fmt.Sprintf("func (%s *%s) Dequeue() any { return nil }", recv, typeName)
	case "IsEmpty":
		return fmt.Sprintf("func (%s %s) IsEmpty() bool { return true }", recv, typeName)
	case "Len":
		return fmt.Sprintf("func (%s %s) Len() int { return 0 }", recv, typeName)
	default:
		return fmt.Sprintf("func (%s *%s) %s() {}", recv, typeName, method)
	}
}

func removeGoFuncAtLine(file string, line int, name string) bool {
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	fset := token.NewFileSet()
	parsed, parseErr := parser.ParseFile(fset, file, data, 0)
	if parseErr != nil {
		return false
	}
	for _, decl := range parsed.Decls {
		fn, ok := decl.(*ast.FuncDecl)
		if !ok || fn.Name == nil || fn.Name.Name != name {
			continue
		}
		if fset.Position(fn.Pos()).Line != line {
			continue
		}
		updated := removeTextRanges(data, []textRange{expandTextRangeToLine(data, fset.Position(fn.Pos()).Offset, fset.Position(fn.End()).Offset)})
		if string(updated) == string(data) {
			return false
		}
		if err := os.WriteFile(file, updated, 0o644); err != nil {
			return false
		}
		_ = exec.Command("gofmt", "-w", file).Run()
		return true
	}
	return false
}

func removeGoMethodFromTypeInDir(dir, typeName, method string) int {
	changed := 0
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		var ranges []textRange
		for _, decl := range parsed.Decls {
			fn, ok := decl.(*ast.FuncDecl)
			if !ok || fn.Recv == nil || len(fn.Recv.List) == 0 || fn.Name == nil || fn.Name.Name != method {
				continue
			}
			if goReceiverBaseTypeName(fn.Recv.List[0].Type) != typeName {
				continue
			}
			ranges = append(ranges, expandTextRangeToLine(data, fset.Position(fn.Pos()).Offset, fset.Position(fn.End()).Offset))
		}
		if len(ranges) == 0 {
			continue
		}
		updated := removeTextRanges(data, ranges)
		if string(updated) == string(data) {
			continue
		}
		if err := os.WriteFile(file, updated, 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func resolveGoBuildErrorPath(root, file string) string {
	file = strings.TrimSpace(file)
	if file == "" {
		return ""
	}
	file = filepath.FromSlash(file)
	if filepath.IsAbs(file) {
		return file
	}
	return filepath.Join(root, file)
}

func repairGoMissingReceiverTypes(root string) int {
	byDir := map[string][]string{}
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if strings.HasSuffix(info.Name(), ".go") {
			byDir[filepath.Dir(p)] = append(byDir[filepath.Dir(p)], p)
		}
		return nil
	})
	changed := 0
	var changedFiles []string
	for _, files := range byDir {
		sort.Strings(files)
		defined := map[string]bool{}
		type receiverInfo struct {
			file    string
			varName string
			fields  map[string]bool
			methods map[string]bool
		}
		receivers := map[string]*receiverInfo{}
		for _, file := range files {
			data, err := os.ReadFile(file)
			if err != nil {
				continue
			}
			parsed, parseErr := parser.ParseFile(token.NewFileSet(), file, data, 0)
			if parseErr != nil {
				continue
			}
			for _, decl := range parsed.Decls {
				if gen, ok := decl.(*ast.GenDecl); ok && gen.Tok == token.TYPE {
					for _, spec := range gen.Specs {
						if ts, ok := spec.(*ast.TypeSpec); ok && ts.Name != nil {
							defined[ts.Name.Name] = true
						}
					}
				}
			}
			for _, decl := range parsed.Decls {
				fn, ok := decl.(*ast.FuncDecl)
				if !ok || fn.Recv == nil || len(fn.Recv.List) == 0 || fn.Name == nil {
					continue
				}
				recvType := receiverTypeName(fn.Recv.List[0].Type)
				if recvType == "" {
					continue
				}
				info := receivers[recvType]
				if info == nil {
					info = &receiverInfo{file: file, fields: map[string]bool{}, methods: map[string]bool{}}
					receivers[recvType] = info
				}
				if info.file == "" {
					info.file = file
				}
				if len(fn.Recv.List[0].Names) > 0 && fn.Recv.List[0].Names[0] != nil {
					info.varName = fn.Recv.List[0].Names[0].Name
				}
				info.methods[fn.Name.Name] = true
			}
		}
		for _, file := range files {
			data, err := os.ReadFile(file)
			if err != nil {
				continue
			}
			parsed, parseErr := parser.ParseFile(token.NewFileSet(), file, data, 0)
			if parseErr != nil {
				continue
			}
			for _, decl := range parsed.Decls {
				fn, ok := decl.(*ast.FuncDecl)
				if !ok || fn.Recv == nil || len(fn.Recv.List) == 0 || fn.Body == nil {
					continue
				}
				recvType := receiverTypeName(fn.Recv.List[0].Type)
				info := receivers[recvType]
				if info == nil || defined[recvType] || info.varName == "" {
					continue
				}
				ast.Inspect(fn.Body, func(n ast.Node) bool {
					sel, ok := n.(*ast.SelectorExpr)
					if !ok || sel.Sel == nil {
						return true
					}
					if ident, ok := sel.X.(*ast.Ident); ok && ident.Name == info.varName && !info.methods[sel.Sel.Name] {
						info.fields[sel.Sel.Name] = true
					}
					return true
				})
			}
		}
		for name, info := range receivers {
			if defined[name] || info == nil || info.file == "" {
				continue
			}
			body := renderMissingReceiverType(name, info.fields, defined)
			if body == "" {
				continue
			}
			data, err := os.ReadFile(info.file)
			if err != nil || strings.Contains(string(data), "type "+name+" struct") {
				continue
			}
			updated := strings.TrimRight(string(data), "\n") + "\n\n" + body + "\n"
			if err := os.WriteFile(info.file, []byte(updated), 0644); err == nil {
				changed++
				changedFiles = append(changedFiles, info.file)
			}
		}
	}
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func receiverTypeName(expr ast.Expr) string {
	switch t := expr.(type) {
	case *ast.Ident:
		return t.Name
	case *ast.StarExpr:
		return receiverTypeName(t.X)
	default:
		return ""
	}
}

func renderMissingReceiverType(name string, fields map[string]bool, defined map[string]bool) string {
	fieldNames := make([]string, 0, len(fields))
	for field := range fields {
		fieldNames = append(fieldNames, field)
	}
	sort.Strings(fieldNames)
	var b strings.Builder
	b.WriteString("// " + name + " is a minimal receiver state synthesized from existing methods.\n")
	b.WriteString("type " + name + " struct {\n")
	if len(fieldNames) == 0 {
		b.WriteString("}\n")
		return b.String()
	}
	for _, field := range fieldNames {
		b.WriteString("\t" + field + " " + inferredReceiverFieldType(field, defined) + "\n")
	}
	b.WriteString("}\n")
	return b.String()
}

func inferredReceiverFieldType(field string, defined map[string]bool) string {
	lower := strings.ToLower(field)
	switch {
	case lower == "mu" || strings.HasSuffix(lower, "mu") || strings.Contains(lower, "mutex"):
		return "sync.RWMutex"
	case lower == "path" || strings.HasSuffix(lower, "path") || strings.Contains(lower, "dir"):
		return "string"
	case lower == "lockfile":
		return "*os.File"
	case lower == "manifest" && defined["Manifest"]:
		return "*Manifest"
	case lower == "state" && defined["BootstrapState"]:
		return "BootstrapState"
	case lower == "engine":
		return "bootstrapStorageEngine"
	case lower == "wal":
		return "bootstrapWAL"
	case lower == "indexer":
		return "bootstrapIndexer"
	case lower == "stats":
		return "*DatabaseStats"
	case strings.Contains(lower, "level") || strings.Contains(lower, "ef") || strings.Contains(lower, "count") || strings.Contains(lower, "size") || strings.Contains(lower, "capacity"):
		return "int"
	case (strings.Contains(lower, "entry") || strings.Contains(lower, "enterpoint") || strings.Contains(lower, "node")) && defined["hnswNode"]:
		return "*hnswNode"
	default:
		return "any"
	}
}

type textRange struct {
	start int
	end   int
}

func expandTextRangeToLine(data []byte, start, end int) textRange {
	if start < 0 {
		start = 0
	}
	if end < start {
		end = start
	}
	if end > len(data) {
		end = len(data)
	}
	for start > 0 && data[start-1] != '\n' {
		start--
	}
	for end < len(data) && data[end] != '\n' {
		end++
	}
	if end < len(data) {
		end++
	}
	return textRange{start: start, end: end}
}

func removeTextRanges(data []byte, ranges []textRange) []byte {
	sort.Slice(ranges, func(i, j int) bool { return ranges[i].start > ranges[j].start })
	out := append([]byte(nil), data...)
	for _, r := range ranges {
		if r.start < 0 || r.end > len(out) || r.start >= r.end {
			continue
		}
		out = append(out[:r.start], out[r.end:]...)
	}
	return out
}

func applyGoLocalTypeAliasRepairs(root string) int {
	modulePath, _ := readGoModModuleAndRequires(filepath.Join(root, "go.mod"))
	modulePath = strings.TrimSpace(modulePath)
	if modulePath == "" {
		return 0
	}
	typeCache := map[string]map[string]bool{}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") || strings.HasSuffix(info.Name(), "_test.go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		fset := token.NewFileSet()
		file, parseErr := parser.ParseFile(fset, p, data, parser.ParseComments)
		if parseErr != nil {
			return nil
		}
		type importInfo struct {
			alias string
			path  string
		}
		var imports []importInfo
		for _, spec := range file.Imports {
			importPath, _ := strconv.Unquote(spec.Path.Value)
			if !strings.HasPrefix(importPath, modulePath+"/") {
				continue
			}
			alias := pathBase(importPath)
			if spec.Name != nil {
				alias = spec.Name.Name
			}
			if alias == "." || alias == "_" || alias == "" {
				continue
			}
			imports = append(imports, importInfo{alias: alias, path: importPath})
		}
		if len(imports) == 0 {
			return nil
		}
		type replacement struct {
			start int
			end   int
			text  string
		}
		var replacements []replacement
		for _, decl := range file.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.TYPE {
				continue
			}
			for _, spec := range gen.Specs {
				ts, ok := spec.(*ast.TypeSpec)
				if !ok || !ts.Name.IsExported() || ts.Assign.IsValid() {
					continue
				}
				var candidates []string
				for _, imp := range imports {
					types := typeCache[imp.path]
					if types == nil {
						types = exportedTypesForImport(root, modulePath, imp.path)
						typeCache[imp.path] = types
					}
					if types[ts.Name.Name] {
						candidates = append(candidates, imp.alias)
					}
				}
				if len(candidates) != 1 {
					continue
				}
				start := fset.Position(ts.Pos()).Offset
				end := fset.Position(ts.End()).Offset
				replacements = append(replacements, replacement{
					start: start,
					end:   end,
					text:  fmt.Sprintf("%s = %s.%s", ts.Name.Name, candidates[0], ts.Name.Name),
				})
			}
		}
		if len(replacements) == 0 {
			return nil
		}
		sort.Slice(replacements, func(i, j int) bool { return replacements[i].start > replacements[j].start })
		updated := string(data)
		for _, repl := range replacements {
			if repl.start < 0 || repl.end > len(updated) || repl.start >= repl.end {
				continue
			}
			updated = updated[:repl.start] + repl.text + updated[repl.end:]
		}
		if updated == string(data) {
			return nil
		}
		if err := os.WriteFile(p, []byte(updated), info.Mode()); err == nil {
			changed += len(replacements)
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, changedFiles...)...).Run()
	}
	return changed
}

func exportedTypesForImport(root, modulePath, importPath string) map[string]bool {
	out := map[string]bool{}
	rel := strings.TrimPrefix(importPath, modulePath+"/")
	dir := filepath.Join(root, filepath.FromSlash(rel))
	entries, err := os.ReadDir(dir)
	if err != nil {
		return out
	}
	fset := token.NewFileSet()
	for _, entry := range entries {
		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".go") || strings.HasSuffix(entry.Name(), "_test.go") {
			continue
		}
		filePath := filepath.Join(dir, entry.Name())
		file, err := parser.ParseFile(fset, filePath, nil, 0)
		if err != nil {
			continue
		}
		for _, decl := range file.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.TYPE {
				continue
			}
			for _, spec := range gen.Specs {
				if ts, ok := spec.(*ast.TypeSpec); ok && ts.Name.IsExported() {
					out[ts.Name.Name] = true
				}
			}
		}
	}
	return out
}

func repairGoIntegrationTests(root string) int {
	modulePath, _ := readGoModModuleAndRequires(filepath.Join(root, "go.mod"))
	modulePath = strings.TrimSpace(modulePath)
	if modulePath == "" {
		return 0
	}
	apiImport := findGoPackageImportWithFunc(root, modulePath, "New")
	if apiImport == "" {
		return 0
	}
	testsDir := filepath.Join(root, "tests")
	entries, err := os.ReadDir(testsDir)
	if err != nil {
		return 0
	}
	changed := 0
	var changedFiles []string
	for _, entry := range entries {
		if entry.IsDir() || !strings.HasSuffix(entry.Name(), "_test.go") {
			continue
		}
		filePath := filepath.Join(testsDir, entry.Name())
		data, err := os.ReadFile(filePath)
		if err != nil {
			continue
		}
		updated := replaceFirstGoPackageName(string(data), "tests")
		updated = ensureImportAlias(updated, ".", apiImport)
		if updated == string(data) {
			continue
		}
		if err := os.WriteFile(filePath, []byte(updated), 0644); err == nil {
			changed++
			changedFiles = append(changedFiles, filePath)
		}
	}
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, changedFiles...)...).Run()
	}
	return changed
}

func findGoPackageImportWithFunc(root, modulePath, funcName string) string {
	var found string
	fset := token.NewFileSet()
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil || found != "" {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules", "tests":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") || strings.HasSuffix(info.Name(), "_test.go") {
			return nil
		}
		file, err := parser.ParseFile(fset, p, nil, 0)
		if err != nil {
			return nil
		}
		for _, decl := range file.Decls {
			fn, ok := decl.(*ast.FuncDecl)
			if ok && fn.Recv == nil && fn.Name.Name == funcName && fn.Name.IsExported() {
				rel, _ := filepath.Rel(root, filepath.Dir(p))
				if rel == "." {
					found = modulePath
				} else {
					found = modulePath + "/" + filepath.ToSlash(rel)
				}
				return filepath.SkipAll
			}
		}
		return nil
	})
	return found
}

func ensureImportAlias(src, alias, importPath string) string {
	if strings.Contains(src, strconv.Quote(importPath)) {
		return src
	}
	line := "\t" + strconv.Quote(importPath)
	if alias != "" {
		line = "\t" + alias + " " + strconv.Quote(importPath)
	}
	importBlock := regexp.MustCompile(`(?m)^import\s*\(\s*\n`)
	if loc := importBlock.FindStringIndex(src); loc != nil {
		return src[:loc[1]] + line + "\n" + src[loc[1]:]
	}
	singleImport := regexp.MustCompile(`(?m)^import\s+("[^"]+")\s*$`)
	if m := singleImport.FindStringSubmatchIndex(src); m != nil {
		existing := src[m[2]:m[3]]
		return src[:m[0]] + "import (\n\t" + existing + "\n" + line + "\n)" + src[m[1]:]
	}
	packageLine := regexp.MustCompile(`(?m)^package\s+[A-Za-z_][A-Za-z0-9_]*\s*$`)
	if loc := packageLine.FindStringIndex(src); loc != nil {
		return src[:loc[1]] + "\n\nimport (\n" + line + "\n)\n" + src[loc[1]:]
	}
	return src
}

func repairGoEmptyPackageFiles(root string) int {
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil || strings.TrimSpace(string(data)) != "" {
			return nil
		}
		pkg := inferGoPackageNameForFile(root, p)
		if pkg == "" {
			pkg = "main"
		}
		if writeErr := os.WriteFile(p, []byte("package "+pkg+"\n"), info.Mode()); writeErr == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, changedFiles...)...).Run()
	}
	return changed
}

func inferGoPackageNameForFile(root, file string) string {
	dir := filepath.Dir(file)
	if pkg := firstGoPackageNameInDir(dir); pkg != "" {
		return pkg
	}
	if rel, err := filepath.Rel(root, dir); err == nil {
		rel = filepath.ToSlash(rel)
		parts := strings.Split(strings.Trim(rel, "/"), "/")
		if len(parts) > 0 && parts[0] == "cmd" {
			return "main"
		}
	}
	base := filepath.Base(dir)
	pkg := safeGoPackageName(base)
	if pkg == "" {
		return "main"
	}
	return pkg
}

func normalizeGoPackageNames(root string) int {
	byDir := map[string][]string{}
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if strings.HasSuffix(info.Name(), ".go") {
			byDir[filepath.Dir(p)] = append(byDir[filepath.Dir(p)], p)
		}
		return nil
	})
	changed := 0
	var changedFiles []string
	for _, files := range byDir {
		target := dominantGoPackageName(files)
		if target == "" {
			continue
		}
		for _, file := range files {
			data, err := os.ReadFile(file)
			if err != nil {
				continue
			}
			current := firstGoPackageName(string(data))
			if current == "" || current == target || (strings.HasSuffix(file, "_test.go") && current == target+"_test") {
				continue
			}
			updated := replaceFirstGoPackageName(string(data), target)
			if updated == string(data) {
				continue
			}
			if err := os.WriteFile(file, []byte(updated), 0644); err == nil {
				changed++
				changedFiles = append(changedFiles, file)
			}
		}
	}
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, changedFiles...)...).Run()
	}
	return changed
}

func dominantGoPackageName(files []string) string {
	counts := map[string]int{}
	for _, file := range files {
		if strings.HasSuffix(file, "_test.go") {
			continue
		}
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		if rawPkg := firstGoPackageName(string(data)); rawPkg != "" {
			counts[safeGoPackageName(rawPkg)]++
		}
	}
	var best string
	var bestCount int
	for pkg, count := range counts {
		if count > bestCount || (count == bestCount && pkg < best) {
			best = pkg
			bestCount = count
		}
	}
	if best != "" {
		return best
	}
	for _, file := range files {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		rawPkg := firstGoPackageName(string(data))
		if rawPkg == "" {
			continue
		}
		pkg := safeGoPackageName(rawPkg)
		if strings.HasSuffix(pkg, "_test") {
			pkg = strings.TrimSuffix(pkg, "_test")
		}
		if pkg != "" {
			return pkg
		}
	}
	return ""
}

func firstGoPackageName(src string) string {
	re := regexp.MustCompile(`(?m)^\s*package\s+([A-Za-z_][A-Za-z0-9_]*)\b`)
	if m := re.FindStringSubmatch(src); len(m) == 2 {
		return m[1]
	}
	return ""
}

func replaceFirstGoPackageName(src, pkg string) string {
	re := regexp.MustCompile(`(?m)^(\s*package\s+)([A-Za-z_][A-Za-z0-9_]*)(\b)`)
	return re.ReplaceAllString(src, "${1}"+pkg+"${3}")
}

func repairTypedAtomicCalls(src string) string {
	if !strings.Contains(src, "atomic.Uint") && !strings.Contains(src, "atomic.Int") {
		return src
	}
	replacements := []struct {
		re   *regexp.Regexp
		repl string
	}{
		{regexp.MustCompile(`atomic\.Add(U?int64)\(&([A-Za-z_][A-Za-z0-9_\.]*),\s*([^)]+)\)`), `$2.Add($3)`},
		{regexp.MustCompile(`atomic\.Load(U?int64)\(&([A-Za-z_][A-Za-z0-9_\.]*)\)`), `$2.Load()`},
		{regexp.MustCompile(`atomic\.Store(U?int64)\(&([A-Za-z_][A-Za-z0-9_\.]*),\s*([^)]+)\)`), `$2.Store($3)`},
	}
	out := src
	for _, repl := range replacements {
		out = repl.re.ReplaceAllString(out, repl.repl)
	}
	return out
}

func ensureImportIfUsed(src, importPath, marker string) string {
	if !strings.Contains(src, marker) || strings.Contains(src, strconv.Quote(importPath)) {
		return src
	}
	importBlock := regexp.MustCompile(`(?m)^import\s*\(\s*\n`)
	if loc := importBlock.FindStringIndex(src); loc != nil {
		return src[:loc[1]] + "\t" + strconv.Quote(importPath) + "\n" + src[loc[1]:]
	}
	singleImport := regexp.MustCompile(`(?m)^import\s+("[^"]+")\s*$`)
	if m := singleImport.FindStringSubmatchIndex(src); m != nil {
		existing := src[m[2]:m[3]]
		return src[:m[0]] + "import (\n\t" + existing + "\n\t" + strconv.Quote(importPath) + "\n)" + src[m[1]:]
	}
	packageLine := regexp.MustCompile(`(?m)^package\s+[A-Za-z_][A-Za-z0-9_]*\s*$`)
	if loc := packageLine.FindStringIndex(src); loc != nil {
		return src[:loc[1]] + "\n\nimport " + strconv.Quote(importPath) + src[loc[1]:]
	}
	return src
}

func removeImportPathFromGoSource(src, importPath string) string {
	if importPath == "" || !strings.Contains(src, strconv.Quote(importPath)) {
		return src
	}
	quoted := regexp.QuoteMeta(strconv.Quote(importPath))
	blockLine := regexp.MustCompile(`(?m)^\s*(?:[A-Za-z_][A-Za-z0-9_]*\s+)?` + quoted + `\s*$`)
	out := blockLine.ReplaceAllString(src, "")
	single := regexp.MustCompile(`(?m)^import\s+(?:[A-Za-z_][A-Za-z0-9_]*\s+)?` + quoted + `\s*\n?`)
	out = single.ReplaceAllString(out, "")
	emptyBlock := regexp.MustCompile(`(?s)import\s*\(\s*\)\s*`)
	out = emptyBlock.ReplaceAllString(out, "")
	return out
}

func ensureNamedImportIfUsed(src, alias, importPath, marker string) string {
	if !strings.Contains(src, marker) || strings.Contains(src, strconv.Quote(importPath)) {
		return src
	}
	alias = strings.TrimSpace(alias)
	quoted := strconv.Quote(importPath)
	importLine := quoted
	if alias != "" && alias != pathBase(importPath) {
		importLine = alias + " " + quoted
	}
	importBlock := regexp.MustCompile(`(?m)^import\s*\(\s*\n`)
	if loc := importBlock.FindStringIndex(src); loc != nil {
		return src[:loc[1]] + "\t" + importLine + "\n" + src[loc[1]:]
	}
	singleImport := regexp.MustCompile(`(?m)^import\s+("[^"]+")\s*$`)
	if m := singleImport.FindStringSubmatchIndex(src); m != nil {
		existing := src[m[2]:m[3]]
		return src[:m[0]] + "import (\n\t" + existing + "\n\t" + importLine + "\n)" + src[m[1]:]
	}
	packageLine := regexp.MustCompile(`(?m)^package\s+[A-Za-z_][A-Za-z0-9_]*\s*$`)
	if loc := packageLine.FindStringIndex(src); loc != nil {
		return src[:loc[1]] + "\n\nimport " + importLine + src[loc[1]:]
	}
	return src
}

func applyGoUnusedVarRepairs(root, buildErrors string) int {
	if root == "" || buildErrors == "" {
		return 0
	}
	reLegacy := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+([A-Za-z_][A-Za-z0-9_]*) declared and not used`)
	reCurrent := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+declared and not used:\s+([A-Za-z_][A-Za-z0-9_]*)`)
	matches := append(reLegacy.FindAllStringSubmatch(buildErrors, -1), reCurrent.FindAllStringSubmatch(buildErrors, -1)...)
	if len(matches) == 0 {
		return 0
	}
	type insertion struct {
		line int
		name string
	}
	byFile := map[string][]insertion{}
	for _, m := range matches {
		line, _ := strconv.Atoi(m[2])
		if line <= 0 || m[3] == "" {
			continue
		}
		file := m[1]
		if !filepath.IsAbs(file) {
			file = filepath.Join(root, filepath.FromSlash(file))
		}
		byFile[file] = append(byFile[file], insertion{line: line, name: m[3]})
	}
	changed := 0
	for file, inserts := range byFile {
		var remaining []insertion
		for _, ins := range inserts {
			if insertGoUnusedVarMarkerInBlock(file, ins.line, ins.name) {
				changed++
				continue
			}
			if insertGoUnusedVarMarkerAfterCompositeLiteral(file, ins.line, ins.name) {
				changed++
				continue
			}
			remaining = append(remaining, ins)
		}
		inserts = remaining
		if len(inserts) == 0 {
			continue
		}
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		sort.Slice(inserts, func(i, j int) bool { return inserts[i].line > inserts[j].line })
		touched := false
		for _, ins := range inserts {
			idx := ins.line - 1
			if idx < 0 || idx >= len(lines) {
				continue
			}
			indent := leadingWhitespace(lines[idx])
			insertLine := indent + "_ = " + ins.name
			if idx+1 < len(lines) && strings.TrimSpace(lines[idx+1]) == strings.TrimSpace(insertLine) {
				continue
			}
			lines = append(lines[:idx+1], append([]string{insertLine}, lines[idx+1:]...)...)
			touched = true
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoMisplacedUnusedMarkersFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "unexpected = in composite literal") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+syntax error: unexpected = in composite literal`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || seen[file] {
			continue
		}
		seen[file] = true
		if moveMisplacedUnusedMarkersAfterCompositeLiterals(file) {
			changed++
		}
	}
	return changed
}

func insertGoUnusedVarMarkerAfterCompositeLiteral(file string, line int, name string) bool {
	if file == "" || line <= 0 || name == "" {
		return false
	}
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	lines := strings.Split(string(data), "\n")
	idx := line - 1
	if idx < 0 || idx >= len(lines) {
		return false
	}
	assignRe := regexp.MustCompile(`^\s*` + regexp.QuoteMeta(name) + `\s*:=\s*&?[A-Za-z_][A-Za-z0-9_\.]*(?:\[[^\]]*\])?\s*\{`)
	if !assignRe.MatchString(lines[idx]) {
		return false
	}
	insertAt := matchingCompositeLiteralEndLine(lines, idx)
	if insertAt < idx || insertAt >= len(lines) {
		return false
	}
	indent := leadingWhitespace(lines[idx])
	marker := indent + "_ = " + name
	if insertAt+1 < len(lines) && strings.TrimSpace(lines[insertAt+1]) == strings.TrimSpace(marker) {
		return true
	}
	lines = append(lines[:insertAt+1], append([]string{marker}, lines[insertAt+1:]...)...)
	if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", file).Run()
	return true
}

func moveMisplacedUnusedMarkersAfterCompositeLiterals(file string) bool {
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	lines := strings.Split(string(data), "\n")
	touched := false
	for i := 1; i < len(lines); i++ {
		marker := strings.TrimSpace(lines[i])
		if !strings.HasPrefix(marker, "_ = ") {
			continue
		}
		name := strings.TrimSpace(strings.TrimPrefix(marker, "_ = "))
		if name == "" || strings.ContainsAny(name, " \t") {
			continue
		}
		assignRe := regexp.MustCompile(`^\s*` + regexp.QuoteMeta(name) + `\s*:=\s*&?[A-Za-z_][A-Za-z0-9_\.]*(?:\[[^\]]*\])?\s*\{`)
		if !assignRe.MatchString(lines[i-1]) {
			continue
		}
		markerLine := lines[i]
		lines = append(lines[:i], lines[i+1:]...)
		end := matchingCompositeLiteralEndLine(lines, i-1)
		if end < i-1 || end >= len(lines) {
			lines = append(lines[:i], append([]string{markerLine}, lines[i:]...)...)
			continue
		}
		lines = append(lines[:end+1], append([]string{markerLine}, lines[end+1:]...)...)
		touched = true
	}
	if !touched {
		return false
	}
	if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", file).Run()
	return true
}

func matchingCompositeLiteralEndLine(lines []string, start int) int {
	depth := 0
	for i := start; i < len(lines) && i < start+300; i++ {
		line := stripGoLineComment(lines[i])
		depth += strings.Count(line, "{")
		depth -= strings.Count(line, "}")
		if i > start && depth <= 0 {
			return i
		}
	}
	return -1
}

func stripGoLineComment(line string) string {
	if idx := strings.Index(line, "//"); idx >= 0 {
		return line[:idx]
	}
	return line
}

func insertGoUnusedVarMarkerInBlock(file string, line int, name string) bool {
	if file == "" || line <= 0 || name == "" {
		return false
	}
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	fset := token.NewFileSet()
	parsed, parseErr := parser.ParseFile(fset, file, data, 0)
	if parseErr != nil {
		return false
	}
	var replaceStart int
	var replaceEnd int
	replacement := "_"
	ast.Inspect(parsed, func(n ast.Node) bool {
		if replaceStart > 0 || n == nil {
			return false
		}
		rangeStmt, ok := n.(*ast.RangeStmt)
		if !ok || rangeStmt.Body == nil {
			return true
		}
		stmtLine := fset.Position(rangeStmt.Pos()).Line
		keyLine := 0
		if rangeStmt.Key != nil {
			keyLine = fset.Position(rangeStmt.Key.Pos()).Line
		}
		valueLine := 0
		if rangeStmt.Value != nil {
			valueLine = fset.Position(rangeStmt.Value.Pos()).Line
		}
		if rangeIdentMatches(rangeStmt.Key, name) {
			if !goLineNear(line, stmtLine, keyLine, valueLine) {
				return true
			}
			if rangeStmt.Value == nil {
				replaceStart = fset.Position(rangeStmt.Key.Pos()).Offset
				replaceEnd = fset.Position(rangeStmt.TokPos).Offset + len(rangeStmt.Tok.String())
				replacement = ""
			} else {
				replaceStart = fset.Position(rangeStmt.Key.Pos()).Offset
				replaceEnd = fset.Position(rangeStmt.Key.End()).Offset
			}
			return false
		}
		if rangeIdentMatches(rangeStmt.Value, name) {
			if !goLineNear(line, stmtLine, keyLine, valueLine) {
				return true
			}
			if rangeIdentMatches(rangeStmt.Key, "_") {
				replaceStart = fset.Position(rangeStmt.Key.Pos()).Offset
				replaceEnd = fset.Position(rangeStmt.TokPos).Offset + len(rangeStmt.Tok.String())
				replacement = ""
			} else {
				replaceStart = fset.Position(rangeStmt.Value.Pos()).Offset
				replaceEnd = fset.Position(rangeStmt.Value.End()).Offset
			}
			return false
		}
		return true
	})
	if replaceStart < 0 || replaceEnd <= replaceStart || replaceEnd > len(data) {
		return false
	}
	updated := string(data[:replaceStart]) + replacement + string(data[replaceEnd:])
	if updated == string(data) {
		return false
	}
	if err := os.WriteFile(file, []byte(updated), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", file).Run()
	return true
}

func goLineNear(line int, candidates ...int) bool {
	for _, candidate := range candidates {
		if candidate <= 0 {
			continue
		}
		delta := line - candidate
		if delta < 0 {
			delta = -delta
		}
		if delta <= 5 {
			return true
		}
	}
	return false
}

func insertGoUnusedVarMarkerInBlockLegacy(file string, line int, name string) bool {
	if file == "" || line <= 0 || name == "" {
		return false
	}
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	fset := token.NewFileSet()
	parsed, parseErr := parser.ParseFile(fset, file, data, 0)
	if parseErr != nil {
		return false
	}
	var insertAt int
	var indent string
	ast.Inspect(parsed, func(n ast.Node) bool {
		if insertAt > 0 || n == nil {
			return false
		}
		rangeStmt, ok := n.(*ast.RangeStmt)
		if !ok || rangeStmt.Body == nil {
			return true
		}
		stmtLine := fset.Position(rangeStmt.Pos()).Line
		keyLine := 0
		if rangeStmt.Key != nil {
			keyLine = fset.Position(rangeStmt.Key.Pos()).Line
		}
		valueLine := 0
		if rangeStmt.Value != nil {
			valueLine = fset.Position(rangeStmt.Value.Pos()).Line
		}
		if line != stmtLine && line != keyLine && line != valueLine {
			return true
		}
		if !rangeIdentMatches(rangeStmt.Key, name) && !rangeIdentMatches(rangeStmt.Value, name) {
			return true
		}
		insertAt = fset.Position(rangeStmt.Body.Lbrace).Offset + 1
		stmtOffset := fset.Position(rangeStmt.Pos()).Offset
		indent = leadingWhitespace(lineAtOffset(string(data), stmtOffset)) + "\t"
		return false
	})
	if insertAt <= 0 || insertAt > len(data) {
		return false
	}
	marker := "\n" + indent + "_ = " + name
	if strings.Contains(string(data), marker) {
		return false
	}
	updated := string(data[:insertAt]) + marker + string(data[insertAt:])
	if updated == string(data) {
		return false
	}
	if err := os.WriteFile(file, []byte(updated), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", file).Run()
	return true
}

func rangeIdentMatches(expr ast.Expr, name string) bool {
	ident, ok := expr.(*ast.Ident)
	return ok && ident.Name == name
}

func lineAtOffset(src string, offset int) string {
	if offset < 0 {
		offset = 0
	}
	if offset > len(src) {
		offset = len(src)
	}
	start := offset
	for start > 0 && src[start-1] != '\n' {
		start--
	}
	end := offset
	for end < len(src) && src[end] != '\n' {
		end++
	}
	return src[start:end]
}

func leadingWhitespace(s string) string {
	for i, r := range s {
		if r != ' ' && r != '\t' {
			return s[:i]
		}
	}
	return s
}

func ensureGoModuleDependencies(cwd, lang string, tc *LanguageToolchain) string {
	if cwd == "" || tc == nil || tc.Language != "go" {
		return ""
	}
	if _, err := os.Stat(filepath.Join(cwd, "go.mod")); err != nil {
		return ""
	}
	modulePath, _ := readGoModModuleAndRequires(filepath.Join(cwd, "go.mod"))
	if modulePath != "" {
		_ = repairGoExternalLocalModuleImports(cwd, modulePath)
		_ = rewriteLocalGoModuleImports(cwd, modulePath)
		_ = repairGoMissingLocalImportPaths(cwd, modulePath)
	}
	if undeclared := undeclaredGoExternalImports(cwd); len(undeclared) > 0 {
		return "Go 外部依赖未声明且默认禁止自动引入。请优先改为标准库/本项目内实现；如确需第三方依赖，必须在同一 Leaf 明确修改 go.mod 并说明原因。\n未声明依赖: " + strings.Join(undeclared, ", ")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 45*time.Second)
	defer cancel()
	out, err := runLimitedCommand(ctx, cwd, []string{"go", "mod", "tidy"}, tc.MemoryMaxMB, tc.CPUQuotaPercent)
	if err == nil {
		return ""
	}
	result := "go mod tidy 失败:\n" + string(out)
	if len(result) > 3000 {
		result = result[:3000] + "\n...(截断)"
	}
	return result
}

func rewriteLocalGoModuleImports(cwd, modulePath string) error {
	modulePath = strings.TrimSpace(modulePath)
	if cwd == "" || modulePath == "" {
		return nil
	}
	moduleBase := filepath.Base(cwd)
	aliases := map[string]bool{}
	for _, candidate := range []string{
		moduleBase,
		strings.ToLower(moduleBase),
		safeProjectIdentifier(moduleBase, ""),
		safeProjectIdentifier(moduleBase, "-"),
		safeProjectIdentifier(moduleBase, "_"),
		pathBase(modulePath),
	} {
		candidate = strings.TrimSpace(candidate)
		if candidate != "" && candidate != "." {
			aliases[candidate] = true
			aliases[strings.ToLower(candidate)] = true
		}
	}
	return filepath.Walk(cwd, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		original := string(data)
		updated := original
		f, parseErr := parser.ParseFile(token.NewFileSet(), p, nil, parser.ImportsOnly)
		if parseErr != nil {
			return nil
		}
		for _, imp := range f.Imports {
			importPath, unquoteErr := strconv.Unquote(imp.Path.Value)
			if unquoteErr != nil || importPath == "" || strings.HasPrefix(importPath, modulePath+"/") {
				continue
			}
			if strings.HasPrefix(importPath, "internal/") && directoryHasGoFiles(filepath.Join(cwd, filepath.FromSlash(importPath))) {
				updated = strings.ReplaceAll(updated, imp.Path.Value, strconv.Quote(modulePath+"/"+importPath))
				continue
			}
			first, rest, ok := splitFirstImportSegment(importPath)
			if !ok || !aliases[first] && !aliases[strings.ToLower(first)] {
				continue
			}
			replacement := modulePath
			if rest != "" {
				replacement += "/" + rest
			}
			updated = strings.ReplaceAll(updated, imp.Path.Value, strconv.Quote(replacement))
		}
		if updated == original {
			return nil
		}
		return os.WriteFile(p, []byte(updated), info.Mode())
	})
}

func repairGoExternalLocalModuleImports(cwd, modulePath string) int {
	modulePath = strings.TrimSpace(modulePath)
	if cwd == "" || modulePath == "" {
		return 0
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(cwd, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		f, parseErr := parser.ParseFile(token.NewFileSet(), p, data, parser.ImportsOnly)
		if parseErr != nil {
			return nil
		}
		original := string(data)
		updated := original
		for _, imp := range f.Imports {
			importPath, unquoteErr := strconv.Unquote(imp.Path.Value)
			if unquoteErr != nil || importPath == "" || isStdlibImport(importPath) {
				continue
			}
			if importPath == modulePath || strings.HasPrefix(importPath, modulePath+"/") {
				continue
			}
			replacement := goLocalImportReplacementForExternalPath(cwd, modulePath, importPath)
			if replacement == "" || replacement == importPath {
				continue
			}
			alias := goImportAliasForRelocatedFile(importPath, replacement, imp)
			updated = replaceGoImportPath(updated, imp.Path.Value, replacement, alias)
		}
		if updated == original {
			return nil
		}
		if writeErr := os.WriteFile(p, []byte(updated), info.Mode()); writeErr == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, changedFiles...)...).Run()
	}
	return changed
}

func goLocalImportReplacementForExternalPath(cwd, modulePath, importPath string) string {
	trimmed := strings.Trim(importPath, "/")
	if trimmed == "" {
		return ""
	}
	parts := strings.Split(trimmed, "/")
	for i := 0; i < len(parts); i++ {
		suffix := strings.Join(parts[i:], "/")
		if suffix == "" || suffix == "." || strings.HasPrefix(suffix, "../") {
			continue
		}
		candidate := modulePath + "/" + suffix
		if goLocalImportExists(cwd, modulePath, candidate) {
			return candidate
		}
		if parent := goLocalFileImportParent(cwd, modulePath, candidate); parent != "" {
			return parent
		}
	}
	return ""
}

func repairGoMissingLocalImportPaths(cwd, modulePath string) int {
	modulePath = strings.TrimSpace(modulePath)
	if cwd == "" || modulePath == "" {
		return 0
	}
	packages := indexGoLocalPackageImports(cwd, modulePath)
	if len(packages) == 0 {
		return 0
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(cwd, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		f, parseErr := parser.ParseFile(token.NewFileSet(), p, nil, parser.ImportsOnly)
		if parseErr != nil {
			return nil
		}
		original := string(data)
		updated := original
		for _, imp := range f.Imports {
			importPath, unquoteErr := strconv.Unquote(imp.Path.Value)
			if unquoteErr != nil || importPath == "" || importPath == modulePath {
				continue
			}
			if strings.HasPrefix(importPath, "internal/") {
				replacement := modulePath + "/" + importPath
				if goLocalImportExists(cwd, modulePath, replacement) {
					updated = strings.ReplaceAll(updated, imp.Path.Value, strconv.Quote(replacement))
				} else if parentImport := goLocalFileImportParent(cwd, modulePath, replacement); parentImport != "" {
					alias := goImportAliasForRelocatedFile(importPath, parentImport, imp)
					updated = replaceGoImportPath(updated, imp.Path.Value, parentImport, alias)
				}
				continue
			}
			if !strings.HasPrefix(importPath, modulePath+"/") {
				continue
			}
			if goLocalImportExists(cwd, modulePath, importPath) {
				continue
			}
			replacement := goLocalFileImportParent(cwd, modulePath, importPath)
			alias := goImportAliasForRelocatedFile(importPath, replacement, imp)
			if replacement == "" {
				replacement = uniqueGoLocalImportCandidate(importPath, packages)
				alias = ""
			}
			if replacement == "" || replacement == importPath {
				continue
			}
			updated = replaceGoImportPath(updated, imp.Path.Value, replacement, alias)
		}
		if updated == original {
			return nil
		}
		if writeErr := os.WriteFile(p, []byte(updated), info.Mode()); writeErr == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, changedFiles...)...).Run()
	}
	return changed
}

func indexGoLocalPackageImports(cwd, modulePath string) map[string][]string {
	out := make(map[string][]string)
	_ = filepath.Walk(cwd, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if !info.IsDir() {
			return nil
		}
		switch info.Name() {
		case ".git", ".claude-go", "vendor", "node_modules":
			return filepath.SkipDir
		}
		if !directoryHasGoFiles(p) {
			return nil
		}
		rel, relErr := filepath.Rel(cwd, p)
		if relErr != nil || rel == "." {
			return nil
		}
		importPath := modulePath + "/" + filepath.ToSlash(rel)
		keys := []string{pathBase(importPath)}
		if pkg := firstGoPackageNameInDir(p); pkg != "" {
			keys = append(keys, pkg)
		}
		parts := strings.Split(strings.Trim(filepath.ToSlash(rel), "/"), "/")
		if len(parts) >= 2 {
			keys = append(keys, strings.Join(parts[len(parts)-2:], "/"))
		}
		for _, key := range keys {
			key = strings.ToLower(strings.TrimSpace(key))
			if key == "" {
				continue
			}
			out[key] = uniqueStrings(append(out[key], importPath))
		}
		return nil
	})
	return out
}

func firstGoPackageNameInDir(dir string) string {
	entries, err := os.ReadDir(dir)
	if err != nil {
		return ""
	}
	for _, entry := range entries {
		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".go") {
			continue
		}
		data, readErr := os.ReadFile(filepath.Join(dir, entry.Name()))
		if readErr != nil {
			continue
		}
		if rawPkg := firstGoPackageName(string(data)); rawPkg != "" {
			pkg := safeGoPackageName(rawPkg)
			if pkg != "" && !strings.HasSuffix(pkg, "_test") {
				return pkg
			}
		}
	}
	return ""
}

func goLocalImportExists(cwd, modulePath, importPath string) bool {
	rel := strings.TrimPrefix(importPath, modulePath+"/")
	if rel == importPath || rel == "" {
		return false
	}
	return directoryHasGoFiles(filepath.Join(cwd, filepath.FromSlash(rel)))
}

func goLocalFileImportParent(cwd, modulePath, importPath string) string {
	rel := strings.TrimPrefix(importPath, modulePath+"/")
	if rel == importPath || rel == "" {
		return ""
	}
	rel = strings.Trim(filepath.ToSlash(rel), "/")
	if rel == "" || strings.HasPrefix(rel, "../") {
		return ""
	}
	filePath := filepath.Join(cwd, filepath.FromSlash(rel+".go"))
	info, err := os.Stat(filePath)
	if err != nil || info.IsDir() {
		return ""
	}
	parentRel := pathDirSlash(rel)
	if parentRel == "" || parentRel == "." {
		return modulePath
	}
	if !directoryHasGoFiles(filepath.Join(cwd, filepath.FromSlash(parentRel))) {
		return ""
	}
	return modulePath + "/" + parentRel
}

func goImportAliasForRelocatedFile(originalImport, replacement string, spec *ast.ImportSpec) string {
	if replacement == "" || spec == nil || spec.Name != nil {
		return ""
	}
	originalBase := pathBase(originalImport)
	replacementBase := pathBase(replacement)
	if originalBase == "" || originalBase == replacementBase {
		return ""
	}
	return originalBase
}

func replaceGoImportPath(src, oldQuoted, replacement, alias string) string {
	newQuoted := strconv.Quote(replacement)
	if alias != "" {
		newQuoted = alias + " " + newQuoted
	}
	return strings.ReplaceAll(src, oldQuoted, newQuoted)
}

func pathDirSlash(p string) string {
	p = strings.Trim(filepath.ToSlash(p), "/")
	if p == "" {
		return ""
	}
	idx := strings.LastIndex(p, "/")
	if idx < 0 {
		return "."
	}
	return p[:idx]
}

func uniqueGoLocalImportCandidate(importPath string, packages map[string][]string) string {
	keys := []string{strings.ToLower(pathBase(importPath))}
	trimmed := strings.Trim(importPath, "/")
	parts := strings.Split(trimmed, "/")
	if len(parts) >= 2 {
		keys = append(keys, strings.ToLower(strings.Join(parts[len(parts)-2:], "/")))
	}
	for _, key := range uniqueStrings(keys) {
		candidates := uniqueStrings(packages[key])
		if len(candidates) == 1 {
			return candidates[0]
		}
	}
	return ""
}

func splitFirstImportSegment(importPath string) (first, rest string, ok bool) {
	parts := strings.SplitN(strings.Trim(importPath, "/"), "/", 2)
	if len(parts) == 0 || parts[0] == "" {
		return "", "", false
	}
	if len(parts) == 1 {
		return parts[0], "", true
	}
	return parts[0], parts[1], true
}

func pathBase(p string) string {
	p = strings.Trim(strings.TrimSpace(p), "/")
	if p == "" {
		return ""
	}
	parts := strings.Split(p, "/")
	return parts[len(parts)-1]
}

func undeclaredGoExternalImports(cwd string) []string {
	_, requires := readGoModModuleAndRequires(filepath.Join(cwd, "go.mod"))
	seen := make(map[string]bool)
	for _, importPath := range goExternalImports(cwd) {
		if isImportDeclaredByRequire(importPath, requires) {
			continue
		}
		seen[importPath] = true
	}
	if len(seen) == 0 {
		return nil
	}
	out := make([]string, 0, len(seen))
	for dep := range seen {
		out = append(out, dep)
	}
	sort.Strings(out)
	return out
}

func goExternalImports(cwd string) []string {
	modulePath, _ := readGoModModuleAndRequires(filepath.Join(cwd, "go.mod"))
	seen := make(map[string]bool)
	_ = filepath.Walk(cwd, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		f, parseErr := parser.ParseFile(token.NewFileSet(), p, nil, parser.ImportsOnly)
		if parseErr != nil {
			return nil
		}
		for _, imp := range f.Imports {
			pathValue, unquoteErr := strconv.Unquote(imp.Path.Value)
			if unquoteErr != nil || pathValue == "" {
				continue
			}
			if isStdlibImport(pathValue) {
				continue
			}
			if modulePath != "" && (pathValue == modulePath || strings.HasPrefix(pathValue, modulePath+"/")) {
				continue
			}
			seen[pathValue] = true
		}
		return nil
	})
	if len(seen) == 0 {
		return nil
	}
	out := make([]string, 0, len(seen))
	for dep := range seen {
		out = append(out, dep)
	}
	sort.Strings(out)
	return out
}

func readGoModModuleAndRequires(path string) (string, []string) {
	data, err := os.ReadFile(path)
	if err != nil {
		return "", nil
	}
	var modulePath string
	var requires []string
	inRequireBlock := false
	for _, line := range strings.Split(string(data), "\n") {
		line = strings.TrimSpace(line)
		if line == "" || strings.HasPrefix(line, "//") {
			continue
		}
		if strings.HasPrefix(line, "module ") {
			modulePath = strings.TrimSpace(strings.TrimPrefix(line, "module "))
			continue
		}
		if strings.HasPrefix(line, "require (") {
			inRequireBlock = true
			continue
		}
		if inRequireBlock && line == ")" {
			inRequireBlock = false
			continue
		}
		if strings.HasPrefix(line, "require ") {
			fields := strings.Fields(strings.TrimSpace(strings.TrimPrefix(line, "require ")))
			if len(fields) > 0 {
				requires = append(requires, fields[0])
			}
			continue
		}
		if inRequireBlock {
			fields := strings.Fields(line)
			if len(fields) > 0 {
				requires = append(requires, fields[0])
			}
		}
	}
	return modulePath, uniqueStrings(requires)
}

func isStdlibImport(importPath string) bool {
	first := importPath
	if idx := strings.Index(first, "/"); idx >= 0 {
		first = first[:idx]
	}
	return !strings.Contains(first, ".")
}

func isImportDeclaredByRequire(importPath string, requires []string) bool {
	for _, req := range requires {
		if importPath == req || strings.HasPrefix(importPath, req+"/") {
			return true
		}
	}
	return false
}

func hasPrimarySourceFiles(cwd string, tc *LanguageToolchain) bool {
	if cwd == "" || tc == nil {
		return false
	}
	primaryExts := map[string]bool{tc.FileExt: true}
	switch tc.Language {
	case "cpp":
		primaryExts[".c"] = true
		primaryExts[".cc"] = true
		primaryExts[".h"] = true
		primaryExts[".hpp"] = true
	}

	found := false
	_ = filepath.WalkDir(cwd, func(path string, d os.DirEntry, err error) error {
		if err != nil || found {
			return nil
		}
		if d.IsDir() {
			if path != cwd {
				name := d.Name()
				if name == ".git" || name == ".claude-go" || name == "vendor" || name == "node_modules" || name == "build" {
					return filepath.SkipDir
				}
				if _, err := os.Stat(filepath.Join(path, tc.ProjectFile)); err == nil {
					return filepath.SkipDir
				}
			}
			return nil
		}
		if primaryExts[filepath.Ext(path)] {
			found = true
		}
		return nil
	})
	return found
}

// runTestCheckLang 多语言版本的测试检查，运行 TestCmds 获取真实测试结果。
// MySQL/Percona 特殊处理: 单元测试已禁用，返回空（跳过测试检查）。
func runTestCheckLang(cwd, lang string) string {
	if cwd == "" {
		return ""
	}
	tc := GetToolchain(lang)
	if _, err := os.Stat(filepath.Join(cwd, tc.ProjectFile)); err != nil {
		return ""
	}
	if tc.Language == "go" && !hasPrimarySourceFiles(cwd, tc) {
		return ""
	}
	// MySQL/C++ 项目: 单元测试已禁用 (WITH_UNIT_TESTS=OFF)
	if lang == "cpp" && isMySQLProject(cwd) {
		return ""
	}
	if len(tc.TestCmds) == 0 {
		return ""
	}
	ctx, cancel := context.WithTimeout(context.Background(), tc.Timeout)
	defer cancel()

	var errors []string
	for _, args := range tc.TestCmds {
		out, err := runLimitedCommand(ctx, cwd, args, tc.MemoryMaxMB, tc.CPUQuotaPercent)
		if err != nil {
			if tc.Language == "go" && isGoNoPackagesOutput(string(out)) {
				continue
			}
			errStr := string(out)
			label := fmt.Sprintf("%s 失败:", strings.Join(args, " "))
			// 检测内存限制/OOM 相关错误, 追加明确提示
			if tc.MemoryMaxMB > 0 && (strings.Contains(errStr, "killed") || strings.Contains(errStr, "Killed") ||
				strings.Contains(errStr, "signal: killed") || strings.Contains(errStr, "OOM") ||
				strings.Contains(errStr, "out of memory") || strings.Contains(errStr, "cannot allocate memory") ||
				strings.Contains(errStr, "exited") && len(errStr) < 100) {
				label = fmt.Sprintf("%s (⚠️ 疑似内存超限, 当前限制 %dMB。请检查测试代码是否存在无限循环或未限制的数据结构增长):", strings.Join(args, " "), tc.MemoryMaxMB)
			}
			errors = append(errors, fmt.Sprintf("%s\n%s", label, errStr))
		}
	}
	if len(errors) == 0 {
		return ""
	}
	result := strings.Join(errors, "\n\n")
	if len(result) > 3000 {
		result = result[:3000] + "\n...(截断)"
	}
	return result
}

func isGoNoPackagesOutput(out string) bool {
	lower := strings.ToLower(out)
	return strings.Contains(lower, "matched no packages") || strings.Contains(lower, "no packages to")
}

// isMySQLProject 检测是否为 MySQL/Percona-Server 项目。
// 判断依据: 根目录存在 CMakeLists.txt 且包含 mysqld 相关配置。
func isMySQLProject(cwd string) bool {
	if cwd == "" {
		return false
	}
	// 检查特征文件
	features := []string{
		"sql/mysqld.cc",
		"sql/sql_parse.cc",
		"sql/sql_yacc.yy",
		"VERSION",
	}
	for _, f := range features {
		if _, err := os.Stat(filepath.Join(cwd, f)); err == nil {
			return true
		}
	}
	// 检查 CMakeCache 中是否有 mysqld 相关内容
	cacheFile := filepath.Join(cwd, "build", "CMakeCache.txt")
	if data, err := os.ReadFile(cacheFile); err == nil {
		return strings.Contains(string(data), "mysqld") ||
			strings.Contains(string(data), "MYSQLD")
	}
	return false
}

// CalcSafeMakeJobs 根据系统内存计算安全的编译并行度。
// 经验值: 每个 C++ 编译 job 约需 1.5-2GB 内存。
// MySQL/Percona 的链接阶段 (mysqld) 单个进程需要 4-8GB。
// 策略: 保留至少 4GB 给系统, 其余分配给编译, 上限 8 jobs。
func CalcSafeMakeJobs() int {
	totalMemMB := getSystemMemoryMB()

	// 保留 4GB 给系统
	reservedMB := int64(4096)
	availableMB := totalMemMB - reservedMB
	if availableMB < 2048 {
		availableMB = 2048 // 最小 2GB
	}

	// 每 job 约 2GB
	perJobMB := int64(2048)
	jobs := int(availableMB / perJobMB)

	// 上限: CPU 核心数和 8 的较小值
	cpuCount := runtime.NumCPU()
	if jobs > cpuCount {
		jobs = cpuCount
	}
	if jobs > 8 {
		jobs = 8
	}
	if jobs < 1 {
		jobs = 1
	}
	return jobs
}

func getSystemMemoryMB() int64 {
	// Linux: 读取 /proc/meminfo
	out, err := exec.Command("sh", "-c", "free -m | awk '/^Mem:/{print $2}'").Output()
	if err != nil {
		return 16384 // 兜底: 假设 16GB
	}
	mb, _ := strconv.ParseInt(strings.TrimSpace(string(out)), 10, 64)
	if mb <= 0 {
		return 16384
	}
	return mb
}

// getMySQLModifiedTargets 根据修改的文件计算最小编译目标。
// MySQL/Percona 使用增量编译: CMake 自动追踪依赖, 只重编译修改过的 .o。
// 返回最优的 cmake --build 参数。
func getMySQLModifiedTargets(changedFiles []string) []string {
	if len(changedFiles) == 0 {
		return nil // 首次构建或未知修改, 返回 nil 表示全量
	}

	// 收集被修改的 .cc/.cpp/.h 文件所在的目录
	dirs := make(map[string]bool)
	for _, f := range changedFiles {
		ext := filepath.Ext(f)
		if ext == ".cc" || ext == ".cpp" || ext == ".c" || ext == ".h" || ext == ".hpp" {
			dir := filepath.Dir(f)
			dirs[dir] = true
		}
	}

	if len(dirs) == 0 {
		return nil
	}

	// 根据修改目录映射到 CMake 子目标
	// MySQL 的关键目录 → target 映射
	targets := make([]string, 0, len(dirs))
	for dir := range dirs {
		switch {
		case strings.HasPrefix(dir, "sql/"):
			targets = append(targets, "sql_main")
		case strings.HasPrefix(dir, "storage/innobase/"):
			targets = append(targets, "innobase")
		case strings.HasPrefix(dir, "storage/myisam/"):
			targets = append(targets, "myisam")
		case strings.HasPrefix(dir, "storage/perfschema/"):
			targets = append(targets, "perfschema")
		case strings.HasPrefix(dir, "client/"):
			targets = append(targets, "client")
		case strings.HasPrefix(dir, "libmysql/"):
			targets = append(targets, "libmysql_api")
		case strings.HasPrefix(dir, "plugin/"):
			targets = append(targets, "plugin")
		case strings.HasPrefix(dir, "include/"):
			// include 目录被修改, 需要重编译所有依赖方 → 全量
			return nil
		case strings.HasPrefix(dir, "cmake/") || strings.HasSuffix(dir, "CMakeLists.txt"):
			// CMake 配置修改 → 需要重新 cmake
			return nil
		default:
			// 其他目录, 保守处理: 全量
			return nil
		}
	}

	// 去重
	seen := make(map[string]bool)
	unique := targets[:0]
	for _, t := range targets {
		if !seen[t] {
			seen[t] = true
			unique = append(unique, t)
		}
	}
	return unique
}

// BuildMySQLIncremental 执行 MySQL/Percona 增量编译。
// 策略:
//  1. 限制并行度 (基于内存)
//  2. 仅编译被修改的源码对应的子目标
//  3. 不构建完整 mysqld, 仅验证语法和链接
//  4. Phase 0 (语法验证阶段) 甚至可以不编译, 仅做语法检查
func BuildMySQLIncremental(cwd string, changedFiles []string, phase int) string {
	jobs := CalcSafeMakeJobs()

	// 确定编译策略
	var buildArgs []string
	switch phase {
	case 0:
		// Phase 0: 仅语法验证 — 编译修改过的 .o 文件, 不链接
		// 使用 cmake --build 但只编译单个文件
		if len(changedFiles) > 0 {
			for _, f := range changedFiles {
				ext := filepath.Ext(f)
				if ext == ".cc" || ext == ".cpp" || ext == ".c" {
					// 仅编译单个 .o 验证语法
					buildArgs = append(buildArgs, "--parallel", fmt.Sprintf("%d", jobs))
					break
				}
			}
		}
	default:
		// Phase 1+: 需要验证链接, 但至少构建修改的子目标
		targets := getMySQLModifiedTargets(changedFiles)
		buildArgs = append(buildArgs, "--parallel", fmt.Sprintf("%d", jobs))
		if len(targets) > 0 {
			// 仅构建特定子目标, 不构建完整的 mysqld
			for _, t := range targets {
				buildArgs = append(buildArgs, "--target", t)
			}
		}
		// 最终仍需要验证 mysqld 能否链接 (但复用已有 .o)
		// 注意: 这仅在所有子目标完成后才执行
	}

	if len(buildArgs) == 0 {
		buildArgs = []string{"--parallel", fmt.Sprintf("%d", jobs)}
	}

	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Minute)
	defer cancel()

	out, err := runLimitedCommand(ctx, cwd, append([]string{"cmake", "--build", "build"}, buildArgs...), 16384, 200)
	if err != nil {
		return fmt.Sprintf("cmake --build 失败 (jobs=%d):\n%s", jobs, string(out))
	}
	return ""
}

// MaterializeCode 从 LLM 输出中提取代码块并写入磁盘。
// 匹配 ```lang\n// File: path/to/file.ext\n...``` 或 ```lang:path/to/file.ext\n...``` 模式。
// 返回写入的文件列表。
func MaterializeCode(cwd, output, lang string) []string {
	if cwd == "" || output == "" {
		return nil
	}
	tc := GetToolchain(lang)
	ext := tc.FileExt

	var written []string
	seen := make(map[string]bool)

	reBlock := regexp.MustCompile("(?s)```(?:go|cpp|c\\+\\+|rust|rs|python|py|typescript|ts|javascript|js|h|hpp|toml|cmake|mod|makefile|txt|md|markdown|json|yaml|yml)(?::([^\\n]+))?\\n(.*?)```")
	reFilePath := regexp.MustCompile(`(?m)^(?://|#|/\*)\s*(?:File|file|PATH|path|filename|Filename):\s*(.+?)(?:\s*\*/)?$`)

	for _, match := range reBlock.FindAllStringSubmatch(output, -1) {
		block := match[2]
		var filePath string

		// 模式 1: ```lang:path/to/file
		if match[1] != "" {
			filePath = strings.TrimSpace(match[1])
		}
		// 模式 2: 代码块内 // File: path 或 # File: path
		if filePath == "" {
			if fpMatch := reFilePath.FindStringSubmatch(block); len(fpMatch) > 1 {
				filePath = strings.TrimSpace(fpMatch[1])
			}
		}
		// 模式 3: 代码块第一行就是文件路径 (e.g. "src/main.rs" 或 "include/kv.h")
		if filePath == "" {
			firstLine := strings.TrimSpace(strings.SplitN(block, "\n", 2)[0])
			if strings.Contains(firstLine, "/") && strings.Contains(firstLine, ".") && len(firstLine) < 80 && !strings.Contains(firstLine, " ") {
				filePath = firstLine
				block = strings.SplitN(block, "\n", 2)[1]
			}
		}
		if filePath == "" {
			continue
		}
		filePath = cleanMaterializeRelPathForCwd(cwd, filePath)
		if filePath == "" {
			continue
		}

		if !isRelevantFileExt(filePath, ext) {
			continue
		}
		if seen[filePath] {
			continue
		}

		full := filepath.Join(cwd, filePath)
		dir := filepath.Dir(full)
		if err := os.MkdirAll(dir, 0o755); err != nil {
			continue
		}
		cleanBlock := reFilePath.ReplaceAllString(block, "")
		content := strings.TrimSpace(cleanBlock) + "\n"
		if !canMaterializeSourceContent(full, filePath, content, tc) {
			continue
		}
		if err := os.WriteFile(full, []byte(content), 0o644); err != nil {
			continue
		}
		written = append(written, filePath)
		seen[filePath] = true
	}

	// 模式 4: markdown header "### path/to/file.ext" 后紧跟代码块
	lines := strings.Split(output, "\n")
	for i := 0; i < len(lines)-1; i++ {
		candidate := extractHeaderFilePathForCwd(cwd, lines[i], ext)
		if candidate == "" {
			continue
		}
		if !isRelevantFileExt(candidate, ext) || seen[candidate] {
			continue
		}
		for j := i + 1; j < len(lines); j++ {
			trimmed := strings.TrimSpace(lines[j])
			if trimmed == "" {
				continue
			}
			if strings.HasPrefix(trimmed, "```") {
				blockStart := j + 1
				for k := blockStart; k < len(lines); k++ {
					if strings.HasPrefix(strings.TrimSpace(lines[k]), "```") {
						block := strings.Join(lines[blockStart:k], "\n")
						full := filepath.Join(cwd, candidate)
						dir := filepath.Dir(full)
						if err := os.MkdirAll(dir, 0o755); err == nil {
							content := strings.TrimSpace(block) + "\n"
							if !canMaterializeSourceContent(full, candidate, content, tc) {
								break
							}
							if err := os.WriteFile(full, []byte(content), 0o644); err == nil {
								written = append(written, candidate)
								seen[candidate] = true
							}
						}
						break
					}
				}
			}
			break
		}
	}

	return written
}

func canMaterializeSourceContent(fullPath, relPath, content string, tc *LanguageToolchain) bool {
	if tc == nil {
		return true
	}
	ext := strings.ToLower(filepath.Ext(relPath))
	switch tc.Language {
	case "go":
		if ext != ".go" {
			return true
		}
		return canMaterializeGoSource(fullPath, content)
	default:
		return true
	}
}

func canMaterializeGoSource(fullPath, content string) bool {
	trimmed := strings.TrimSpace(content)
	if trimmed == "" {
		return false
	}
	if !goSourceHasPackageDecl(trimmed) {
		return false
	}
	newDecls := goSourceDeclCount(trimmed)
	if old, err := os.ReadFile(fullPath); err == nil {
		oldTrimmed := strings.TrimSpace(string(old))
		if oldTrimmed == "" {
			return true
		}
		oldDecls := goSourceDeclCount(oldTrimmed)
		// E2E/repair outputs must provide full file contents. Refuse obvious
		// degradations such as replacing a real source file with package-only
		// scaffolding or a tiny comment shell.
		if len(oldTrimmed) >= 240 && len(trimmed) < 120 && oldDecls > 0 {
			return false
		}
		if oldDecls > 0 && newDecls == 0 {
			return false
		}
		if len(oldTrimmed) >= 1000 && len(trimmed)*4 < len(oldTrimmed) && newDecls < oldDecls/2 {
			return false
		}
	}
	return true
}

func goSourceHasPackageDecl(src string) bool {
	for _, line := range strings.Split(src, "\n") {
		trimmed := strings.TrimSpace(line)
		if trimmed == "" || strings.HasPrefix(trimmed, "//") {
			continue
		}
		if strings.HasPrefix(trimmed, "/*") || strings.HasPrefix(trimmed, "*") {
			continue
		}
		return strings.HasPrefix(trimmed, "package ")
	}
	return false
}

func goSourceDeclCount(src string) int {
	f, err := parser.ParseFile(token.NewFileSet(), "", src, parser.ParseComments)
	if err != nil || f == nil {
		return 0
	}
	return len(f.Decls)
}

var headerFilePathRe = regexp.MustCompile(`([A-Za-z0-9._/-]+\.[A-Za-z0-9][A-Za-z0-9_-]*)`)

func extractHeaderFilePath(line, langExt string) string {
	return extractHeaderFilePathForCwd("", line, langExt)
}

func extractHeaderFilePathForCwd(cwd, line, langExt string) string {
	trimmed := strings.TrimSpace(line)
	if !strings.HasPrefix(trimmed, "##") {
		return ""
	}
	matches := headerFilePathRe.FindAllString(trimmed, -1)
	for _, match := range matches {
		candidate := cleanMaterializeRelPathForCwd(cwd, match)
		if candidate == "" || !strings.Contains(filepath.ToSlash(candidate), "/") {
			continue
		}
		if isRelevantFileExt(candidate, langExt) {
			return candidate
		}
	}
	return ""
}

func cleanMaterializeRelPath(path string) string {
	return cleanMaterializeRelPathForCwd("", path)
}

func cleanMaterializeRelPathForCwd(cwd, path string) string {
	path = strings.TrimSpace(strings.Trim(path, "`\"'"))
	path = strings.TrimPrefix(path, "path=")
	path = strings.TrimPrefix(path, "file=")
	path = strings.TrimPrefix(path, "filepath=")
	path = strings.TrimPrefix(path, "file_path=")
	path = strings.TrimSpace(strings.Trim(path, "`\"'"))
	path = strings.TrimRight(path, "。:：,，)")
	path = filepath.ToSlash(path)
	if cwd != "" && strings.HasPrefix(path, "/") {
		cleanCwd := filepath.ToSlash(filepath.Clean(cwd))
		cleanPath := filepath.ToSlash(filepath.Clean(path))
		if cleanPath == cleanCwd {
			return ""
		}
		if strings.HasPrefix(cleanPath, cleanCwd+"/") {
			path = strings.TrimPrefix(cleanPath, cleanCwd+"/")
		}
	}
	path = strings.TrimPrefix(path, "./")
	if path == "" || strings.HasPrefix(path, "/") || path == ".." || strings.HasPrefix(path, "../") || strings.Contains(path, "/../") {
		return ""
	}
	if strings.HasPrefix(path, "path=/") || strings.HasPrefix(path, "path=") {
		return ""
	}
	return filepath.FromSlash(filepath.Clean(path))
}

func outputContainsRelevantCodeBlock(output, lang string) bool {
	if output == "" {
		return false
	}
	tc := GetToolchain(lang)
	lower := strings.ToLower(output)
	switch tc.Language {
	case "go":
		return strings.Contains(lower, "```go") || strings.Contains(lower, "package ")
	case "rust":
		return strings.Contains(lower, "```rust") || strings.Contains(lower, "```rs") || strings.Contains(lower, "fn ")
	case "python":
		return strings.Contains(lower, "```python") || strings.Contains(lower, "```py")
	case "typescript":
		return strings.Contains(lower, "```typescript") || strings.Contains(lower, "```ts") || strings.Contains(lower, "export ")
	case "javascript":
		return strings.Contains(lower, "```javascript") || strings.Contains(lower, "```js") || strings.Contains(lower, "export ")
	case "cpp":
		return strings.Contains(lower, "```cpp") || strings.Contains(lower, "```c++") || strings.Contains(lower, "#include")
	default:
		return strings.Contains(lower, "```")
	}
}

// isRelevantFileExt 检查文件路径是否包含当前语言或通用配置文件扩展名
func isRelevantFileExt(filePath, langExt string) bool {
	commonExts := []string{".toml", ".cmake", ".txt", ".md", ".json", ".yaml", ".yml", ".cfg", ".ini", ".mod"}
	if strings.Contains(filePath, langExt) {
		return true
	}
	for _, ce := range commonExts {
		if strings.HasSuffix(filePath, ce) {
			return true
		}
	}
	lp := strings.ToLower(filePath)
	return strings.HasSuffix(lp, ".h") || strings.HasSuffix(lp, ".hpp") ||
		strings.HasSuffix(lp, ".c") || strings.HasSuffix(lp, ".cc")
}

// buildPrevResultsSummary 将 prevResults map 构建为 summary 字符串 (用于 E2E prompt)
func buildPrevResultsSummary(prevResults map[string]string) string {
	var b strings.Builder
	for name, output := range prevResults {
		summary := SummarizeOldOutput(output, 1000)
		b.WriteString(fmt.Sprintf("### %s:\n%s\n\nFull artifact/ref: prevResults[%q] / blackboard key `%s-result`.\n\n", name, summary, name, name))
	}
	return b.String()
}

// filterParallel 从 ready 阶段中提取可并行执行的子集。
//
// 策略 (修复原有 bug: 之前要求所有 ready 阶段依赖集完全相同才并行,
// 导致依赖不同但同时就绪的阶段无法并行):
//  1. 显式标记 Parallel=true 的阶段总是可并行
//  2. 多个 ready 阶段的依赖已全部满足 (它们才进入 ready 列表),
//     因此它们之间没有执行顺序约束, 应该可以并行
//  3. 唯一限制: 并行数由 executor 的 sem 控制
func filterParallel(stages []StageDef) []StageDef {
	if len(stages) <= 1 {
		return stages
	}

	// 优先: 如果有显式标记 Parallel 的, 全部并行
	var explicit []StageDef
	for _, s := range stages {
		if s.Parallel {
			explicit = append(explicit, s)
		}
	}
	if len(explicit) > 1 {
		return explicit
	}

	// 所有 ready 阶段的依赖已满足 → 按依赖集分组, 同组可并行
	groups := make(map[string][]StageDef)
	for _, s := range stages {
		key := strings.Join(s.DependsOn, ",")
		groups[key] = append(groups[key], s)
	}

	// 选最大的同依赖组
	var best []StageDef
	for _, g := range groups {
		if len(g) > len(best) {
			best = g
		}
	}
	if len(best) > 1 {
		return best
	}

	// 兜底: 所有 ready 阶段依赖已满足, 无执行顺序约束, 全部并行
	return stages
}
