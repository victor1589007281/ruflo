func applyGoCompileErrorRepairs(root, buildErrors string) int {
	if root == "" || strings.TrimSpace(buildErrors) == "" {
		return 0
	}
	modulePath, _ := readGoModModuleAndRequires(filepath.Join(root, "go.mod"))
	modulePath = strings.TrimSpace(modulePath)
	changed := 0
	changed += repairGoStructClosingParenFromBuildErrors(root, buildErrors)
	changed += repairGoRootMainBootstrapFromBuildErrors(root, buildErrors)
	changed += repairGoSplitIdentifierLines(root)
	changed += repairGoCStyleWhileAndAdjacentDuplicateFuncHeads(root, buildErrors)
	changed += repairGoByteRuneCallsFromBuildErrors(root, buildErrors)
	changed += repairGoInvalidMapKeyTypeFromBuildErrors(root, buildErrors)
	changed += repairGoStringMapIndexFromBuildErrors(root, buildErrors)
	changed += repairGoStringToImportedKeyCastsFromBuildErrors(root, buildErrors)
	changed += repairGoMissingLSMTreeEngineFromBuildErrors(root, buildErrors)
	changed += repairGoMisplacedUnusedMarkersFromBuildErrors(root, buildErrors)
	changed += repairGoSelfImports(root, modulePath)
	changed += repairGoSelfPackageQualifierFromBuildErrors(root, buildErrors)
	changed += repairGoDuplicateErrorsImportsFromBuildErrors(root, buildErrors)
	changed += repairGoUnusedImportsFromBuildErrors(root, buildErrors)
	changed += applyGoUnusedVarRepairs(root, buildErrors)
	changed += repairGoTypeUsedAsValueFromBuildErrors(root, buildErrors)
	changed += repairGoGenericNilComparisonsFromBuildErrors(root, buildErrors)
	changed += repairGoCloseContextContractDriftFromBuildErrors(root, buildErrors)
	changed += repairGoUndefinedStdlibImportsFromBuildErrors(root, buildErrors)
	changed += repairGoUndefinedLocalPackageImportsFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoGoogleUUIDDependency(root)
	changed += repairGoUndeclaredExternalImportsFromBuildErrors(root, buildErrors)
	changed += repairGoDuplicateFuncDeclsFromBuildErrors(root, buildErrors)
	changed += repairGoDuplicateMethodDeclsFromBuildErrors(root, buildErrors)
	changed += repairGoDuplicateTypeDeclsFromBuildErrors(root, buildErrors)
	changed += repairGoIfInitUndefinedErrConditionFromBuildErrors(root, buildErrors)
	changed += repairGoInterfaceSignatureMismatchesFromBuildErrors(root, buildErrors)
	changed += repairGoInterfaceMissingMethodsFromBuildErrors(root, buildErrors)
	changed += repairGoInterfaceReturnMissingMethodFromBuildErrors(root, buildErrors)
	changed += repairGoImportedInterfaceReturnMissingMethodFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoImportedInterfaceArgumentMissingMethodFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoAliasInterfaceImplementationFromBuildErrors(root, buildErrors)
	changed += repairGoLocalAliasMethodReceiversFromBuildErrors(root, buildErrors)
	changed += repairGoImportedInterfaceMissingMethodsFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoNonLocalTypeMethodsFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoUndefinedFieldTyposFromBuildErrors(root, buildErrors)
	changed += repairGoNonMapFieldTyposFromBuildErrors(root, buildErrors)
	changed += repairGoMethodFieldSelectorDriftFromBuildErrors(root, buildErrors)
	changed += repairGoMissingStructFieldsFromBuildErrors(root, buildErrors)
	changed += repairGoImportedPackageStructFieldsFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoImportedSelectorAssignmentFieldsFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoFloatDriftFromBuildErrors(root, buildErrors)
	changed += repairGoStringIDLookupFromBuildErrors(root, buildErrors)
	changed += repairGoInterfaceConcreteAssignmentFromBuildErrors(root, buildErrors)
	changed += repairGoSingleAssignmentMultiReturnFromBuildErrors(root, buildErrors)
	changed += repairGoErrgroupGroupFieldFromBuildErrors(root, buildErrors)
	changed += repairGoTypedSliceToInterfaceSliceCallsFromBuildErrors(root, buildErrors)
	changed += repairGoNamedUintMismatchesFromBuildErrors(root, buildErrors)
	changed += repairGoNamedUintAtomicCallsFromBuildErrors(root, buildErrors)
	changed += repairGoSamePackageEnumMismatchesFromBuildErrors(root, buildErrors)
	changed += repairGoErrorCodeAsErrorFromBuildErrors(root, buildErrors)
	changed += repairGoEmbeddedErrorFieldAsErrorFromBuildErrors(root, buildErrors)
	changed += repairGoUnsupportedAtomicAPIsFromBuildErrors(root, buildErrors)
	changed += repairGoDatabaseBootstrapContractFromBuildErrors(root, buildErrors)
	changed += repairGoPointerReturnContractDriftFromBuildErrors(root, buildErrors)
	changed += repairGoConcreteReturnForNonImplementingInterfaceFromBuildErrors(root, buildErrors)
	changed += repairGoMissingLeadingReturnValueFromBuildErrors(root, buildErrors)
	changed += repairGoTwoVarSingleReturnTaskResultFromBuildErrors(root, buildErrors)
	changed += repairGoTwoVarSingleReturnGenericFromBuildErrors(root, buildErrors)
	changed += repairGoConstructorTypeToFuncFromBuildErrors(root, buildErrors)
	changed += repairGoTooManyArgsErrorConstructorsFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoMissingMethodStubsFromBuildErrors(root, buildErrors)
	changed += repairGoImportedPackageSingleFetchAliasesFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoMissingGraphTypesFromBuildErrors(root, buildErrors)
	changed += repairGoMissingErrorCodeConstsFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoUndefinedSamePackageTypesFromBuildErrors(root, buildErrors)
	changed += repairGoWeakGeneratedEnumStubsFromBuildErrors(root, buildErrors)
	changed += repairGoInvalidConstantEnumStubsFromBuildErrors(root, buildErrors)
	changed += repairGoWeakComparatorStubsFromBuildErrors(root, buildErrors)
	changed += repairGoDuplicateErrorVarAgainstErrorCodeFromBuildErrors(root, buildErrors)
	changed += repairGoIntInt64OffsetMismatchesFromBuildErrors(root, buildErrors)
	changed += repairGoDirectionAliasesFromBuildErrors(root, buildErrors)
	changed += repairGoWeakLocalStubTypesFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoQualifiedEmptyStructTypeExpressionFromBuildErrors(root, buildErrors)
	changed += repairGoFieldMethodConflictsFromBuildErrors(root, buildErrors)
	changed += repairGoScanIteratorContractsFromBuildErrors(root, buildErrors)
	changed += repairGoSyncableWriteCloserFromBuildErrors(root, buildErrors)
	changed += repairGoSlogSyncCallsFromBuildErrors(root, buildErrors)
	changed += repairGoUndefinedSyscallMsyncFromBuildErrors(root, buildErrors)
	changed += repairGoNonFunctionFieldCallsFromBuildErrors(root, buildErrors)
	changed += repairGoMissingCategoryResourceExhaustedFromBuildErrors(root, buildErrors)
	changed += repairGoImportedLocalSelectorStubsFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoMissingUnusedLocalImportsFromBuildErrors(root, modulePath, buildErrors)
	changed += repairGoMissingLocalPackageStubsFromBuildErrors(root, modulePath, buildErrors)
	return changed
}

func repairGoInvalidMapKeyTypeFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "invalid map key type") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+invalid map key type (.+)$`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		invalidType := strings.TrimSpace(m[3])
		if file == "" || line <= 0 {
			continue
		}
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		lines := strings.Split(src, "\n")
		idx := line - 1
		if idx < 0 || idx >= len(lines) {
			continue
		}
		aliases := goSliceAliasTypes(src)
		updatedLine := replaceInvalidMapKeyTypesInLine(lines[idx], invalidType, aliases)
		if updatedLine == lines[idx] {
			continue
		}
		lines[idx] = updatedLine
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func goSliceAliasTypes(src string) map[string]bool {
	aliases := map[string]bool{}
	re := regexp.MustCompile(`(?m)^\s*type\s+([A-Za-z_][A-Za-z0-9_]*)\s*=?\s*\[\](?:byte|uint8)\b`)
	for _, m := range re.FindAllStringSubmatch(src, -1) {
		if len(m) > 1 && m[1] != "" {
			aliases[m[1]] = true
		}
	}
	return aliases
}

func replaceInvalidMapKeyTypesInLine(line, invalidType string, aliases map[string]bool) string {
	keyTypes := map[string]bool{}
	invalidType = strings.TrimSpace(invalidType)
	if invalidType != "" {
		keyTypes[invalidType] = true
		if strings.Contains(invalidType, ".") {
			keyTypes[shortGoTypeName(invalidType)] = true
		}
	}
	for alias := range aliases {
		if invalidType == "" || invalidType == "[]byte" || invalidType == "[]uint8" || invalidType == alias || strings.HasSuffix(invalidType, "."+alias) {
			keyTypes[alias] = true
		}
	}
	keyTypes["[]byte"] = true
	keyTypes["[]uint8"] = true

	re := regexp.MustCompile(`map\[([^\]]+)\]`)
	return re.ReplaceAllStringFunc(line, func(expr string) string {
		m := re.FindStringSubmatch(expr)
		if len(m) != 2 {
			return expr
		}
		key := strings.TrimSpace(m[1])
		if keyTypes[key] || aliases[key] {
			return "map[string]"
		}
		if strings.Contains(key, ".") {
			short := shortGoTypeName(key)
			if keyTypes[short] || aliases[short] {
				return "map[string]"
			}
		}
		return expr
	})
}

func shortGoTypeName(name string) string {
	name = strings.TrimSpace(name)
	if idx := strings.LastIndex(name, "."); idx >= 0 && idx < len(name)-1 {
		return name[idx+1:]
	}
	return name
}

func repairGoStringMapIndexFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "as string value in map index") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot use (.+?) \(.*?\) as string value in map index`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		expr := strings.TrimSpace(m[3])
		if file == "" || line <= 0 || expr == "" || strings.HasPrefix(expr, "string(") {
			continue
		}
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		idx := line - 1
		if idx < 0 || idx >= len(lines) {
			continue
		}
		updatedLine := replaceMapIndexExprWithString(lines[idx], expr)
		if updatedLine == lines[idx] {
			continue
		}
		lines[idx] = updatedLine
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func replaceMapIndexExprWithString(line, expr string) string {
	expr = strings.TrimSpace(expr)
	if expr == "" {
		return line
	}
	target := "[" + expr + "]"
	replacement := "[string(" + expr + ")]"
	if strings.Contains(line, target) {
		return strings.Replace(line, target, replacement, 1)
	}
	return line
}

func repairGoStringToImportedKeyCastsFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, " as ") || !strings.Contains(buildErrors, ".Key value") || !strings.Contains(buildErrors, "type string") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+cannot use ([A-Za-z_][A-Za-z0-9_]*) \(variable of type string\) as ([A-Za-z_][A-Za-z0-9_]*)\.Key value`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type target struct {
		line  int
		name  string
		alias string
	}
	byFile := map[string][]target{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		if file == "" || line <= 0 || m[3] == "" || m[4] == "" {
			continue
		}
		byFile[file] = append(byFile[file], target{line: line, name: m[3], alias: m[4]})
	}
	changed := 0
	for file, targets := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		touched := false
		for _, t := range targets {
			idx := t.line - 1
			if idx < 0 || idx >= len(lines) || t.name == "" || t.alias == "" {
				continue
			}
			updatedLine := castGoBareIdentifierInLine(lines[idx], t.name, t.alias+".Key("+t.name+")")
			if updatedLine == lines[idx] {
				continue
			}
			lines[idx] = updatedLine
			touched = true
		}
		needs := map[string]string{}
		for _, t := range targets {
			if t.name != "" && t.alias != "" {
				needs[t.name] = t.alias
			}
		}
		for i, line := range lines {
			for name, alias := range needs {
				if !goLineLikelyNeedsImportedKeyCast(line, name) {
					continue
				}
				updatedLine := castGoBareIdentifierInLine(line, name, alias+".Key("+name+")")
				if updatedLine == line {
					continue
				}
				lines[i] = updatedLine
				line = updatedLine
				touched = true
			}
		}
		if !touched {
			continue
		}
		if err := os.WriteFile(file, []byte(strings.Join(lines, "\n")), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func goLineLikelyNeedsImportedKeyCast(line, ident string) bool {
	if ident == "" || !regexp.MustCompile(`\b`+regexp.QuoteMeta(ident)+`\b`).MatchString(line) {
		return false
	}
	trimmed := strings.TrimSpace(line)
	if strings.HasPrefix(trimmed, "for "+ident+",") || strings.HasPrefix(trimmed, "for "+ident+" :=") ||
		strings.HasPrefix(trimmed, ident+" :=") || strings.HasPrefix(trimmed, "var "+ident+" ") {
		return false
	}
	for _, marker := range []string{".Acquire(", ".Release(", ".GetLatestVersion(", "Key:", ".Key ="} {
		if strings.Contains(line, marker) {
			return true
		}
	}
	return false
}

func castGoBareIdentifierInLine(line, ident, replacement string) string {
	if ident == "" || replacement == "" || strings.Contains(line, replacement) {
		return line
	}
	re := regexp.MustCompile(`\b` + regexp.QuoteMeta(ident) + `\b`)
	return re.ReplaceAllStringFunc(line, func(match string) string {
		return replacement
	})
}

func repairGoTypeUsedAsValueFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "(type) is not an expression") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+([A-Za-z_][A-Za-z0-9_]*) \(type\) is not an expression`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		name := m[2]
		if file == "" || name == "" {
			continue
		}
		dir := filepath.Dir(file)
		key := dir + "\x00" + name
		if seen[key] {
			continue
		}
		seen[key] = true
		changed += rewriteGoEmptyStructTypeToValueInDir(dir, name)
	}
	return changed
}

func rewriteGoEmptyStructTypeToValueInDir(dir, name string) int {
	if dir == "" || name == "" {
		return 0
	}
	for _, file := range goFilesInDir(dir) {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		re := regexp.MustCompile(`(?m)^type\s+` + regexp.QuoteMeta(name) + `\s+struct\s*\{\s*\}\s*$`)
		if !re.MatchString(src) {
			continue
		}
		updated := re.ReplaceAllString(src, "var "+name+" = struct{}{}")
		if updated == src {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			_ = exec.Command("gofmt", "-w", file).Run()
			return 1
		}
	}
	return 0
}

func repairGoStructClosingParenFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "expected field name or embedded type") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+syntax error: unexpected \), expected field name or embedded type`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type target struct {
		file string
		line int
	}
	var targets []target
	for _, m := range matches {
		line, _ := strconv.Atoi(m[2])
		file := resolveGoBuildErrorPath(root, m[1])
		if file != "" && line > 0 {
			targets = append(targets, target{file: file, line: line})
		}
	}
	changed := 0
	seen := map[string]bool{}
	for _, target := range targets {
		key := fmt.Sprintf("%s:%d", target.file, target.line)
		if seen[key] {
			continue
		}
		seen[key] = true
		data, err := os.ReadFile(target.file)
		if err != nil {
			continue
		}
		lines := strings.Split(string(data), "\n")
		if target.line > len(lines) || strings.TrimSpace(lines[target.line-1]) != ")" {
			continue
		}
		lines[target.line-1] = strings.Replace(lines[target.line-1], ")", "}", 1)
		updated := strings.Join(lines, "\n")
		if updated == string(data) {
			continue
		}
		if err := os.WriteFile(target.file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", target.file).Run()
		}
	}
	return changed
}

func repairGoRootMainBootstrapFromBuildErrors(root, buildErrors string) int {
	if root == "" || !strings.Contains(buildErrors, "main.go") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+main\.go):\d+:\d+:\s+`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	rootMain := filepath.Clean(filepath.Join(root, "main.go"))
	seen := map[string]bool{}
	for _, m := range matches {
		file := filepath.Clean(resolveGoBuildErrorPath(root, m[1]))
		if file == "" || file != rootMain || seen[file] {
			continue
		}
		seen[file] = true
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		if !strings.Contains(src, "package main") {
			continue
		}
		updated := `package main

import (
	"flag"
	"fmt"
)

var version = "v4.0.0"

func main() {
	showVersion := flag.Bool("version", false, "show version information")
	flag.Parse()
	if *showVersion {
		fmt.Printf("AgentDB %s\n", version)
		return
	}
	fmt.Println("AgentDB command entrypoint")
}
`
		if updated == src {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			_ = exec.Command("gofmt", "-w", file).Run()
			return 1
		}
	}
	return 0
}

func repairGoByteRuneCallsFromBuildErrors(root, buildErrors string) int {
	if root == "" || !strings.Contains(buildErrors, "as rune value") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+cannot use ([A-Za-z_][A-Za-z0-9_]*(?:\(\))?) \(.*type byte\) as rune value in argument to (unicode\.[A-Za-z_][A-Za-z0-9_]*|utf8\.RuneLen)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	byFile := map[string]map[string][]string{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		expr := strings.TrimSpace(m[2])
		fn := strings.TrimSpace(m[3])
		if file == "" || expr == "" || fn == "" {
			continue
		}
		if byFile[file] == nil {
			byFile[file] = map[string][]string{}
		}
		byFile[file][fn] = append(byFile[file][fn], expr)
	}
	changed := 0
	for file, byFunc := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		updated := string(data)
		for fn, exprs := range byFunc {
			for _, expr := range uniqueStrings(exprs) {
				callRe := regexp.MustCompile(regexp.QuoteMeta(fn) + `\(\s*` + regexp.QuoteMeta(expr) + `\s*\)`)
				updated = callRe.ReplaceAllString(updated, fn+"(rune("+expr+"))")
			}
		}
		if updated == string(data) {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoMissingLSMTreeEngineFromBuildErrors(root, buildErrors string) int {
	if root == "" || !strings.Contains(buildErrors, "undefined: newLSMTree") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+undefined:\s+newLSMTree\b`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" {
			continue
		}
		dir := filepath.Dir(file)
		if seen[dir] || !goTypeExistsInDir(dir, "Engine") {
			continue
		}
		seen[dir] = true
		if writeGoMemoryLSMTreeEngine(dir) {
			changed++
		}
	}
	return changed
}

func writeGoMemoryLSMTreeEngine(dir string) bool {
	if dir == "" {
		return false
	}
	target := filepath.Join(dir, "lsm_tree.go")
	if _, err := os.Stat(target); err == nil {
		return false
	}
	pkg := firstGoPackageNameInDir(dir)
	if pkg == "" {
		return false
	}
	src := `package ` + pkg + `

import (
	"bytes"
	"io"
	"sort"
	"sync"

	"agentdbv4/internal/types"
)

type lsmTree struct {
	mu     sync.RWMutex
	data   map[string][]byte
	keys   []string
	opened bool
	stats  Stats
}

func newLSMTree(cfg *types.DBConfig) (Engine, error) {
	e := &lsmTree{data: make(map[string][]byte)}
	if err := e.Open(cfg); err != nil {
		return nil, err
	}
	return e, nil
}

func (e *lsmTree) Open(cfg *types.DBConfig) error {
	e.mu.Lock()
	defer e.mu.Unlock()
	if e.data == nil {
		e.data = make(map[string][]byte)
	}
	e.opened = true
	return nil
}

func (e *lsmTree) Close() error {
	e.mu.Lock()
	defer e.mu.Unlock()
	e.opened = false
	return nil
}

func (e *lsmTree) Put(key, value []byte) error {
	if len(key) == 0 {
		return types.NewError(types.ErrCodeInvalidParam, "key is empty")
	}
	e.mu.Lock()
	defer e.mu.Unlock()
	k := string(key)
	if _, ok := e.data[k]; !ok {
		e.keys = append(e.keys, k)
		sort.Strings(e.keys)
	}
	e.data[k] = append([]byte(nil), value...)
	e.stats.BytesWritten += int64(len(key) + len(value))
	return nil
}

func (e *lsmTree) Get(key []byte) ([]byte, error) {
	e.mu.RLock()
	defer e.mu.RUnlock()
	value, ok := e.data[string(key)]
	if !ok {
		return nil, io.EOF
	}
	e.stats.BytesRead += int64(len(value))
	return append([]byte(nil), value...), nil
}

func (e *lsmTree) Delete(key []byte) error {
	e.mu.Lock()
	defer e.mu.Unlock()
	k := string(key)
	if _, ok := e.data[k]; !ok {
		return io.EOF
	}
	delete(e.data, k)
	for i, existing := range e.keys {
		if existing == k {
			e.keys = append(e.keys[:i], e.keys[i+1:]...)
			break
		}
	}
	return nil
}

func (e *lsmTree) Seek(key []byte) (Iterator, error) {
	it := e.NewIterator()
	it.Seek(key)
	if !it.Valid() {
		return it, io.EOF
	}
	return it, nil
}

func (e *lsmTree) NewIterator() Iterator {
	e.mu.RLock()
	defer e.mu.RUnlock()
	keys := append([]string(nil), e.keys...)
	values := make(map[string][]byte, len(e.data))
	for k, v := range e.data {
		values[k] = append([]byte(nil), v...)
	}
	return &memoryIterator{keys: keys, values: values, idx: -1}
}

func (e *lsmTree) NewTransaction() Transaction {
	var tx Transaction
	return tx
}

func (e *lsmTree) NewWriteBatch() WriteBatch {
	return &memoryWriteBatch{engine: e}
}

func (e *lsmTree) Compact() error { return nil }

func (e *lsmTree) Stats() *Stats {
	e.mu.RLock()
	defer e.mu.RUnlock()
	stats := e.stats
	stats.OpenKeyCount = len(e.data)
	return &stats
}

func (e *lsmTree) Sync() error { return nil }

type memoryIterator struct {
	keys   []string
	values map[string][]byte
	idx    int
}

func (it *memoryIterator) Seek(key []byte) bool {
	k := string(key)
	it.idx = sort.Search(len(it.keys), func(i int) bool { return it.keys[i] >= k })
	return it.Valid()
}

func (it *memoryIterator) Next() { it.idx++ }

func (it *memoryIterator) Prev() { it.idx-- }

func (it *memoryIterator) Key() []byte {
	if !it.Valid() {
		return nil
	}
	return []byte(it.keys[it.idx])
}

func (it *memoryIterator) Value() []byte {
	if !it.Valid() {
		return nil
	}
	return append([]byte(nil), it.values[it.keys[it.idx]]...)
}

func (it *memoryIterator) Valid() bool {
	return it.idx >= 0 && it.idx < len(it.keys)
}

func (it *memoryIterator) Close() error { return nil }

type memoryBatchOp struct {
	key    []byte
	value  []byte
	delete bool
}

type memoryWriteBatch struct {
	engine *lsmTree
	ops    []memoryBatchOp
}

func (b *memoryWriteBatch) Put(key, value []byte) error {
	b.ops = append(b.ops, memoryBatchOp{key: append([]byte(nil), key...), value: append([]byte(nil), value...)})
	return nil
}

func (b *memoryWriteBatch) Delete(key []byte) error {
	b.ops = append(b.ops, memoryBatchOp{key: append([]byte(nil), key...), delete: true})
	return nil
}

func (b *memoryWriteBatch) Clear() { b.ops = nil }

func (b *memoryWriteBatch) Len() int { return len(b.ops) }

func (b *memoryWriteBatch) Write() error {
	for _, op := range b.ops {
		var err error
		if op.delete {
			err = b.engine.Delete(op.key)
		} else {
			err = b.engine.Put(op.key, op.value)
		}
		if err != nil && !errorsIsEOF(err) {
			return err
		}
	}
	b.Clear()
	return nil
}

func (b *memoryWriteBatch) Close() error {
	b.Clear()
	return nil
}

func errorsIsEOF(err error) bool {
	return err == io.EOF || bytes.Equal([]byte(err.Error()), []byte(io.EOF.Error()))
}
`
	if err := os.WriteFile(target, []byte(src), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", target).Run()
	return true
}

func repairGoSplitIdentifierLines(root string) int {
	if root == "" {
		return 0
	}
	patterns := []struct {
		first  string
		second string
		join   string
	}{
		{first: "T", second: "xnID", join: "TxnID"},
		{first: "T", second: "xID", join: "TxID"},
		{first: "LS", second: "N", join: "LSN"},
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		lines := strings.Split(string(data), "\n")
		out := make([]string, 0, len(lines))
		touched := false
		for i := 0; i < len(lines); i++ {
			merged := false
			if i+1 < len(lines) {
				for _, pattern := range patterns {
					if strings.TrimSpace(lines[i]) != pattern.first {
						continue
					}
					next := strings.TrimSpace(lines[i+1])
					if next == "" || !strings.HasPrefix(next, pattern.second) {
						continue
					}
					indent := leadingWhitespace(lines[i])
					if indent == "" {
						indent = leadingWhitespace(lines[i+1])
					}
					out = append(out, indent+pattern.join+strings.TrimPrefix(next, pattern.second))
					i++
					touched = true
					merged = true
					break
				}
			}
			if !merged {
				out = append(out, lines[i])
			}
		}
		if !touched {
			return nil
		}
		if err := os.WriteFile(p, []byte(strings.Join(out, "\n")), info.Mode()); err == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, changedFiles...)...).Run()
	}
	return changed
}

func repairGoCStyleWhileAndAdjacentDuplicateFuncHeads(root, buildErrors string) int {
	if root == "" || !strings.Contains(buildErrors, "syntax error") {
		return 0
	}
	whileRe := regexp.MustCompile(`^(\s*)while\s+(.+?)\s*\{\s*$`)
	funcHeadRe := regexp.MustCompile(`^\s*func\s+(?:\([^)]*\)\s*)?[A-Za-z_][A-Za-z0-9_]*\s*\(`)
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		lines := strings.Split(string(data), "\n")
		out := make([]string, 0, len(lines))
		touched := false
		for _, line := range lines {
			if m := whileRe.FindStringSubmatch(line); len(m) == 3 {
				line = m[1] + "for " + strings.TrimSpace(m[2]) + " {"
				touched = true
			}
			trimmed := strings.TrimSpace(line)
			if len(out) > 0 && trimmed != "" && trimmed == strings.TrimSpace(out[len(out)-1]) && funcHeadRe.MatchString(trimmed) {
				touched = true
				continue
			}
			out = append(out, line)
		}
		if !touched {
			return nil
		}
		if err := os.WriteFile(p, []byte(strings.Join(out, "\n")), info.Mode()); err == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func repairGoErrgroupGroupFieldFromBuildErrors(root, buildErrors string) int {
	if root == "" || !strings.Contains(buildErrors, "golang.org/x/sync/errgroup") {
		return 0
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		src := string(data)
		if !strings.Contains(src, "errgroup.Group") {
			return nil
		}
		if strings.Count(src, "errgroup.") != strings.Count(src, "errgroup.Group") {
			return nil
		}
		updated := strings.ReplaceAll(src, "errgroup.Group", "sync.WaitGroup")
		updated = ensureImportIfUsed(updated, "sync", "sync.")
		if updated == src {
			return nil
		}
		if err := os.WriteFile(p, []byte(updated), 0o644); err != nil {
			return nil
		}
		removeGoImportByPath(p, "golang.org/x/sync/errgroup")
		changed++
		changedFiles = append(changedFiles, p)
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func repairGoSelfImports(root, modulePath string) int {
	if root == "" || modulePath == "" {
		return 0
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		relDir, relErr := filepath.Rel(root, filepath.Dir(p))
		if relErr != nil {
			return nil
		}
		relDir = filepath.ToSlash(relDir)
		importPath := modulePath
		if relDir != "." && relDir != "" {
			importPath += "/" + relDir
		}
		if rewriteGoSelfImportInFile(p, importPath) {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func rewriteGoSelfImportInFile(file, importPath string) bool {
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	fset := token.NewFileSet()
	parsed, parseErr := parser.ParseFile(fset, file, data, parser.ImportsOnly)
	if parseErr != nil {
		return false
	}
	aliases := map[string]bool{}
	for _, imp := range parsed.Imports {
		if imp.Path == nil {
			continue
		}
		got, unquoteErr := strconv.Unquote(imp.Path.Value)
		if unquoteErr != nil || got != importPath {
			continue
		}
		alias := pathBase(importPath)
		if imp.Name != nil && imp.Name.Name != "" && imp.Name.Name != "." && imp.Name.Name != "_" {
			alias = imp.Name.Name
		}
		if alias != "" {
			aliases[alias] = true
		}
	}
	if len(aliases) == 0 {
		return false
	}
	updated := string(data)
	for alias := range aliases {
		updated = regexp.MustCompile(`\b`+regexp.QuoteMeta(alias)+`\.`).ReplaceAllString(updated, "")
	}
	if updated == string(data) {
		if !removeGoImportByPath(file, importPath) {
			return false
		}
		return true
	}
	if err := os.WriteFile(file, []byte(updated), 0o644); err != nil {
		return false
	}
	if !removeGoImportByPath(file, importPath) {
		_ = exec.Command("gofmt", "-w", file).Run()
		return true
	}
	return true
}

func repairGoUnusedImportsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+"([^"]+)" imported and not used`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	byFile := map[string]map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || m[2] == "" {
			continue
		}
		if byFile[file] == nil {
			byFile[file] = map[string]bool{}
		}
		byFile[file][m[2]] = true
	}
	changed := 0
	var changedFiles []string
	for file, imports := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, parser.ImportsOnly)
		if parseErr != nil {
			continue
		}
		var removals []textRange
		for _, decl := range parsed.Decls {
			gen, ok := decl.(*ast.GenDecl)
			if !ok || gen.Tok != token.IMPORT {
				continue
			}
			for _, spec := range gen.Specs {
				imp, ok := spec.(*ast.ImportSpec)
				if !ok || imp.Path == nil {
					continue
				}
				importPath, unquoteErr := strconv.Unquote(imp.Path.Value)
				if unquoteErr != nil || !imports[importPath] {
					continue
				}
				if strings.HasSuffix(importPath, "/internal/errors") && strings.Contains(string(data), `"errors"`) &&
					strings.Contains(buildErrors, "errors redeclared in this block") {
					continue
				}
				startPos, endPos := spec.Pos(), spec.End()
				if len(gen.Specs) == 1 {
					startPos, endPos = gen.Pos(), gen.End()
				}
				start := fset.Position(startPos).Offset
				end := fset.Position(endPos).Offset
				removals = append(removals, expandTextRangeToLine(data, start, end))
			}
		}
		if len(removals) == 0 {
			continue
		}
		updated := removeTextRanges(data, removals)
		if string(updated) == string(data) {
			continue
		}
		if err := os.WriteFile(file, updated, 0o644); err == nil {
			changed += len(removals)
			changedFiles = append(changedFiles, file)
		}
	}
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func repairGoSelfPackageQualifierFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+undefined:\s+([A-Za-z_][A-Za-z0-9_]*)\b`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		qualifier := m[2]
		key := file + "\x00" + qualifier
		if file == "" || qualifier == "" || seen[key] {
			continue
		}
		pkg := inferGoPackageNameForFile(filepath.Dir(file), file)
		if pkg == "" || pkg != qualifier {
			continue
		}
		data, err := os.ReadFile(file)
		if err != nil || !strings.Contains(string(data), qualifier+".") {
			continue
		}
		updated := regexp.MustCompile(`\b`+regexp.QuoteMeta(qualifier)+`\.`).ReplaceAllString(string(data), "")
		if updated == string(data) {
			continue
		}
		seen[key] = true
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoGenericNilComparisonsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+invalid operation:\s+([A-Za-z_][A-Za-z0-9_]*)\s*==\s*nil \(mismatched types ([A-Za-z_][A-Za-z0-9_]*) and untyped nil\)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	byFile := map[string]map[int]genericNilTarget{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		line, _ := strconv.Atoi(m[2])
		name := m[3]
		typeParam := m[4]
		if file == "" || line <= 0 || name == "" || typeParam == "" {
			continue
		}
		if byFile[file] == nil {
			byFile[file] = map[int]genericNilTarget{}
		}
		byFile[file][line] = genericNilTarget{name: name, typeParam: typeParam}
	}
	for file, targets := range byFile {
		if repairGoGenericNilComparisonsInFile(file, targets) {
			changed++
		}
	}
	return changed
}

type genericNilTarget struct {
	name      string
	typeParam string
}

func repairGoGenericNilComparisonsInFile(file string, targets map[int]genericNilTarget) bool {
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	lines := strings.Split(string(data), "\n")
	touched := false
	for line, target := range targets {
		idx := line - 1
		if idx < 0 || idx >= len(lines) || target.name == "" {
			continue
		}
		re := regexp.MustCompile(`\b` + regexp.QuoteMeta(target.name) + `\s*==\s*nil\b`)
		if !re.MatchString(lines[idx]) {
			continue
		}
		lines[idx] = re.ReplaceAllString(lines[idx], "isNilValue("+target.name+")")
		touched = true
	}
	if !touched {
		return false
	}
	updated := strings.Join(lines, "\n")
	if !strings.Contains(updated, "func isNilValue[T any]") {
		updated += `

func isNilValue[T any](v T) bool {
	rv := reflect.ValueOf(v)
	switch rv.Kind() {
	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Pointer, reflect.Slice:
		return rv.IsNil()
	default:
		return false
	}
}
`
	}
	updated = ensureImportIfUsed(updated, "reflect", "reflect.")
	if updated == string(data) {
		return false
	}
	if err := os.WriteFile(file, []byte(updated), 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", file).Run()
	return true
}

func repairGoCloseContextContractDriftFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, ".Close") && !strings.Contains(buildErrors, "undefined: context") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+(?:not enough arguments in call to .+\.Close|undefined: context)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	seen := map[string]bool{}
	closeWithContext := regexp.MustCompile(`Close\(\s*(?:[A-Za-z_][A-Za-z0-9_]*\s+)?context\.Context\s*\)\s+error`)
	receiverCloseNoArgs := regexp.MustCompile(`func\s*\([^)]*\)\s*Close\(\s*\)\s+error`)
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || seen[file] {
			continue
		}
		seen[file] = true
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		if !closeWithContext.MatchString(src) || !receiverCloseNoArgs.MatchString(src) {
			continue
		}
		updated := closeWithContext.ReplaceAllString(src, "Close() error")
		if updated == src {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoUndefinedStdlibImportsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+undefined:\s+([A-Za-z_][A-Za-z0-9_]*)\b`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	stdlib := map[string]string{
		"bytes":   "bytes",
		"context": "context",
		"errors":  "errors",
		"fmt":     "fmt",
		"io":      "io",
		"math":    "math",
		"os":      "os",
		"runtime": "runtime",
		"sort":    "sort",
		"strconv": "strconv",
		"strings": "strings",
		"sync":    "sync",
		"time":    "time",
	}
	type need struct {
		name       string
		importPath string
	}
	byFile := map[string][]need{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		importPath := stdlib[m[2]]
		if file == "" || importPath == "" {
			continue
		}
		byFile[file] = append(byFile[file], need{name: m[2], importPath: importPath})
	}
	changed := 0
	for file, needs := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		updated := src
		for _, n := range needs {
			updated = ensureImportIfUsed(updated, n.importPath, n.name+".")
		}
		if updated == src {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoUndefinedLocalPackageImportsFromBuildErrors(root, modulePath, buildErrors string) int {
	if root == "" || modulePath == "" {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+undefined:\s+([a-z][A-Za-z0-9_]*)\b`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	packages := indexGoLocalPackageImports(root, modulePath)
	if len(packages) == 0 {
		return 0
	}
	byFile := map[string]map[string]string{}
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		alias := strings.TrimSpace(m[2])
		if file == "" || alias == "" || isGoBuiltinOrStdlibIdentifier(alias) {
			continue
		}
		if goImportPathForAlias(file, alias) != "" {
			continue
		}
		candidates := uniqueStrings(packages[strings.ToLower(alias)])
		if len(candidates) != 1 {
			continue
		}
		if byFile[file] == nil {
			byFile[file] = map[string]string{}
		}
		byFile[file][alias] = candidates[0]
	}
	changed := 0
	for file, imports := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		updated := string(data)
		for alias, importPath := range imports {
			updated = ensureNamedImportIfUsed(updated, alias, importPath, alias+".")
		}
		if updated == string(data) {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			_ = exec.Command("gofmt", "-w", file).Run()
		}
	}
	return changed
}

func repairGoUndeclaredExternalImportsFromBuildErrors(root, buildErrors string) int {
	if root == "" || strings.TrimSpace(buildErrors) == "" {
		return 0
	}
	modulePath, _ := readGoModModuleAndRequires(filepath.Join(root, "go.mod"))
	if changed := repairGoExternalLocalModuleImports(root, strings.TrimSpace(modulePath)); changed > 0 {
		return changed
	}
	re := regexp.MustCompile(`(?m)^([^:\n]+\.go):\d+:\d+:\s+no required module provides package ([^;\s]+)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		importPath := strings.Trim(m[2], `"`)
		if file == "" || importPath == "" {
			continue
		}
		if removeGoImportByPath(file, importPath) {
			changed++
		}
	}
	return changed
}

func repairGoGoogleUUIDDependency(root string) int {
	if root == "" {
		return 0
	}
	changed := 0
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		src := string(data)
		if !strings.Contains(src, `"github.com/google/uuid"`) {
			return nil
		}
		updated := src
		updated = strings.ReplaceAll(updated, "uuid.New().String()", "claudeGoLocalUUIDString()")
		updated = strings.ReplaceAll(updated, "uuid.NewString()", "claudeGoLocalUUIDString()")
		if removeGoImportByPath(p, "github.com/google/uuid") {
			next, nextErr := os.ReadFile(p)
			if nextErr == nil {
				updated = string(next)
				updated = strings.ReplaceAll(updated, "uuid.New().String()", "claudeGoLocalUUIDString()")
				updated = strings.ReplaceAll(updated, "uuid.NewString()", "claudeGoLocalUUIDString()")
			}
		}
		updated = ensureGoImportInSource(updated, "crypto/rand")
		updated = ensureGoImportInSource(updated, "encoding/hex")
		if !strings.Contains(updated, "func claudeGoLocalUUIDString() string") {
			updated += `

func claudeGoLocalUUIDString() string {
	var b [16]byte
	if _, err := rand.Read(b[:]); err != nil {
		return hex.EncodeToString([]byte("claude-go-local-id"))
	}
	b[6] = (b[6] & 0x0f) | 0x40
	b[8] = (b[8] & 0x3f) | 0x80
	return hex.EncodeToString(b[:])
}
`
		}
		if updated == src {
			return nil
		}
		if writeErr := os.WriteFile(p, []byte(updated), 0o644); writeErr == nil {
			_ = exec.Command("gofmt", "-w", p).Run()
			changed++
		}
		return nil
	})
	return changed
}

func removeGoImportByPath(file, importPath string) bool {
	data, err := os.ReadFile(file)
	if err != nil {
		return false
	}
	fset := token.NewFileSet()
	parsed, parseErr := parser.ParseFile(fset, file, data, parser.ImportsOnly)
	if parseErr != nil {
		return false
	}
	var ranges []textRange
	for _, decl := range parsed.Decls {
		gen, ok := decl.(*ast.GenDecl)
		if !ok || gen.Tok != token.IMPORT {
			continue
		}
		for _, spec := range gen.Specs {
			imp, ok := spec.(*ast.ImportSpec)
			if !ok || imp.Path == nil {
				continue
			}
			got, unquoteErr := strconv.Unquote(imp.Path.Value)
			if unquoteErr != nil || got != importPath {
				continue
			}
			startPos, endPos := spec.Pos(), spec.End()
			if len(gen.Specs) == 1 {
				startPos, endPos = gen.Pos(), gen.End()
			}
			ranges = append(ranges, expandTextRangeToLine(data, fset.Position(startPos).Offset, fset.Position(endPos).Offset))
		}
	}
	if len(ranges) == 0 {
		return false
	}
	updated := removeTextRanges(data, ranges)
	if string(updated) == string(data) {
		return false
	}
	if err := os.WriteFile(file, updated, 0o644); err != nil {
		return false
	}
	_ = exec.Command("gofmt", "-w", file).Run()
	return true
}

func repairGoDuplicateFuncDeclsFromBuildErrors(root, buildErrors string) int {
	re := regexp.MustCompile(`(?m)^(.+\.go):(\d+):\d+:\s+([A-Za-z_][A-Za-z0-9_]*) redeclared in this block\s*\n\s+(.+\.go):\d+:\d+:\s+other declaration of ([A-Za-z_][A-Za-z0-9_]*)`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	type duplicateFunc struct {
		file string
		line int
		name string
	}
	var duplicates []duplicateFunc
	for _, m := range matches {
		if m[3] != m[5] {
			continue
		}
		line, _ := strconv.Atoi(m[2])
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" || line <= 0 || m[3] == "" {
			continue
		}
		duplicates = append(duplicates, duplicateFunc{file: file, line: line, name: m[3]})
	}
	if len(duplicates) == 0 {
		return 0
	}
	byFile := map[string][]duplicateFunc{}
	for _, d := range duplicates {
		byFile[d.file] = append(byFile[d.file], d)
	}
	changed := 0
	var changedFiles []string
	for file, funcs := range byFile {
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		var removals []textRange
		for _, dup := range funcs {
			for _, decl := range parsed.Decls {
				fn, ok := decl.(*ast.FuncDecl)
				if !ok || fn.Recv != nil || fn.Name == nil || fn.Name.Name != dup.name {
					continue
				}
				start := fset.Position(fn.Pos())
				if start.Line != dup.line {
					continue
				}
				removals = append(removals, expandTextRangeToLine(data, fset.Position(fn.Pos()).Offset, fset.Position(fn.End()).Offset))
				break
			}
		}
		if len(removals) == 0 {
			continue
		}
		updated := removeTextRanges(data, removals)
		if string(updated) == string(data) {
			continue
		}
		if err := os.WriteFile(file, updated, 0o644); err == nil {
			changed += len(removals)
			changedFiles = append(changedFiles, file)
		}
	}
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

