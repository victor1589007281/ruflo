		fset := token.NewFileSet()
		parsed, parseErr := parser.ParseFile(fset, file, data, 0)
		if parseErr != nil {
			continue
		}
		var removals []textRange
		for _, dup := range types {
			for _, decl := range parsed.Decls {
				gen, ok := decl.(*ast.GenDecl)
				if !ok || gen.Tok != token.TYPE {
					continue
				}
				for _, spec := range gen.Specs {
					ts, ok := spec.(*ast.TypeSpec)
					if !ok || ts.Name == nil || ts.Name.Name != dup.name || fset.Position(ts.Pos()).Line != dup.line {
						continue
					}
					startPos, endPos := spec.Pos(), spec.End()
					if len(gen.Specs) == 1 {
						startPos, endPos = gen.Pos(), gen.End()
					}
					removals = append(removals, expandTextRangeToLine(data, fset.Position(startPos).Offset, fset.Position(endPos).Offset))
				}
