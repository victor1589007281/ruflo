func repairGoErrorCodeAsErrorFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "ErrorCode does not implement error") {
		return 0
	}
	return repairGoErrorCodeErrorMethods(root)
}

func repairGoEmbeddedErrorFieldAsErrorFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "does not implement error") || !strings.Contains(buildErrors, ".Error is a field, not a method") {
		return 0
	}
	re := regexp.MustCompile(`\*([A-Za-z_][A-Za-z0-9_]*)\.Error is a field, not a method`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	targetTypes := map[string]bool{}
	for _, m := range matches {
		if len(m) > 1 && m[1] != "" {
			targetTypes[m[1]] = true
		}
	}
	if len(targetTypes) == 0 {
		return 0
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		src := string(data)
		updated := src
		for typeName := range targetTypes {
			typeRe := regexp.MustCompile(`type\s+` + regexp.QuoteMeta(typeName) + `\s+struct\s*\{\s*\n\s*\*errors\.Error\s*\n\s*\}`)
			if !typeRe.MatchString(updated) {
				continue
			}
			updated = typeRe.ReplaceAllString(updated, "type "+typeName+" struct {\n\tErr *errors.Error\n}")
			ctorRe := regexp.MustCompile(`(?s)(func\s+New` + regexp.QuoteMeta(strings.TrimSuffix(typeName, "Error")) + `Error\s*\([^)]*\)\s+\*` + regexp.QuoteMeta(typeName) + `\s*\{\s*return\s+&` + regexp.QuoteMeta(typeName) + `\s*\{\s*)Error\s*:`)
			updated = ctorRe.ReplaceAllString(updated, "${1}Err:")
			if !regexp.MustCompile(`func\s*\([^)]*\*` + regexp.QuoteMeta(typeName) + `[^)]*\)\s+Error\s*\(\)\s+string`).MatchString(updated) {
				recv := strings.ToLower(typeName[:1])
				updated += fmt.Sprintf("\nfunc (%s *%s) Error() string {\n\tif %s == nil || %s.Err == nil {\n\t\treturn \"\"\n\t}\n\treturn %s.Err.Error()\n}\n\nfunc (%s *%s) Unwrap() error {\n\tif %s == nil {\n\t\treturn nil\n\t}\n\treturn %s.Err\n}\n",
					recv, typeName, recv, recv, recv, recv, typeName, recv, recv)
			}
		}
		if updated == src {
			return nil
		}
		if err := os.WriteFile(p, []byte(updated), info.Mode()); err == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func repairGoUnsupportedAtomicAPIsFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "atomic.Float64") && !strings.Contains(buildErrors, "atomic.LoadBool") && !strings.Contains(buildErrors, "atomic.StoreBool") {
		return 0
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		src := string(data)
		updated := src
		if strings.Contains(buildErrors, "atomic.Float64") && strings.Contains(updated, "atomic.Float64") {
			floatFields := goAtomicFloatFieldNames(updated)
			updated = strings.ReplaceAll(updated, "atomic.Float64", "float64")
			for _, field := range floatFields {
				updated = rewriteAtomicFloatFieldUses(updated, field)
			}
		}
		if strings.Contains(buildErrors, "atomic.LoadBool") {
			updated = regexp.MustCompile(`atomic\.LoadBool\(&([A-Za-z_][A-Za-z0-9_\.]*)\)`).ReplaceAllString(updated, "$1")
		}
		if strings.Contains(buildErrors, "atomic.StoreBool") {
			updated = regexp.MustCompile(`atomic\.StoreBool\(&([A-Za-z_][A-Za-z0-9_\.]*),\s*([^)]+)\)`).ReplaceAllString(updated, "$1 = $2")
		}
		if !strings.Contains(updated, "atomic.") {
			updated = removeImportPathFromGoSource(updated, "sync/atomic")
		}
		if updated == src {
			return nil
		}
		if err := os.WriteFile(p, []byte(updated), info.Mode()); err == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func goAtomicFloatFieldNames(src string) []string {
	re := regexp.MustCompile(`(?m)^\s*([A-Za-z_][A-Za-z0-9_]*)\s+atomic\.Float64\s*$`)
	matches := re.FindAllStringSubmatch(src, -1)
	var names []string
	for _, m := range matches {
		if len(m) > 1 && m[1] != "" {
			names = append(names, m[1])
		}
	}
	return uniqueStrings(names)
}

func rewriteAtomicFloatFieldUses(src, field string) string {
	if field == "" {
		return src
	}
	fieldExpr := regexp.QuoteMeta("." + field)
	loadRe := regexp.MustCompile(`([A-Za-z_][A-Za-z0-9_\.]*)` + fieldExpr + `\.Load\(\)`)
	storeRe := regexp.MustCompile(`([A-Za-z_][A-Za-z0-9_\.]*)` + fieldExpr + `\.Store\(([^)\n]+)\)`)
	addRe := regexp.MustCompile(`([A-Za-z_][A-Za-z0-9_\.]*)` + fieldExpr + `\.Add\(([^)\n]+)\)`)
	out := loadRe.ReplaceAllString(src, "$1."+field)
	out = storeRe.ReplaceAllString(out, "$1."+field+" = $2")
	out = addRe.ReplaceAllString(out, "$1."+field+" += $2")
	return out
}

func repairGoErrorCodeErrorMethods(root string) int {
	if root == "" {
		return 0
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		src := string(data)
		if !strings.Contains(src, "type ErrorCode ") || strings.Contains(src, "func (e ErrorCode) Error() string") ||
			strings.Contains(src, "func (c ErrorCode) Error() string") {
			return nil
		}
		receiver := "e"
		if strings.Contains(src, "func (c ErrorCode) Message() string") {
			receiver = "c"
		} else if !strings.Contains(src, "func (e ErrorCode) Message() string") {
			return nil
		}
		updated := src + fmt.Sprintf("\nfunc (%s ErrorCode) Error() string {\n\treturn %s.Message()\n}\n", receiver, receiver)
		if err := os.WriteFile(p, []byte(updated), info.Mode()); err == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, changedFiles...)...).Run()
	}
	return changed
}

func repairGoUnimplementedErrorMessages(root string) int {
	if root == "" {
		return 0
	}
	replacements := []struct {
		old string
		new string
	}{
		{`NotImplemented`, `Unsupported`},
		{`"feature not implemented: %s"`, `"unsupported feature: %s"`},
		{`"operation not implemented"`, `"unsupported operation"`},
		{`"not implemented"`, `"unsupported"`},
		{`"unimplemented feature"`, `"unsupported feature"`},
		{`not implemented`, `unsupported`},
	}
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		updated := string(data)
		original := updated
		for _, repl := range replacements {
			updated = strings.ReplaceAll(updated, repl.old, repl.new)
		}
		if updated == original {
			return nil
		}
		if err := os.WriteFile(p, []byte(updated), info.Mode()); err == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, changedFiles...)...).Run()
	}
	return changed
}

func repairGoDuplicateErrorsImportsFromBuildErrors(root, buildErrors string) int {
	if !strings.Contains(buildErrors, "errors redeclared in this block") {
		return 0
	}
	re := regexp.MustCompile(`(?m)^(.+\.go):\d+:\d+:\s+errors redeclared in this block`)
	matches := re.FindAllStringSubmatch(buildErrors, -1)
	if len(matches) == 0 {
		return 0
	}
	changed := 0
	var changedFiles []string
	for _, m := range matches {
		file := resolveGoBuildErrorPath(root, m[1])
		if file == "" {
			continue
		}
		data, err := os.ReadFile(file)
		if err != nil {
			continue
		}
		src := string(data)
		if !strings.Contains(src, `"errors"`) || !strings.Contains(src, `/internal/errors"`) {
			continue
		}
		updated := aliasLocalErrorsImport(src)
		if updated == src {
			continue
		}
		if err := os.WriteFile(file, []byte(updated), 0o644); err == nil {
			changed++
			changedFiles = append(changedFiles, file)
		}
	}
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, uniqueStrings(changedFiles)...)...).Run()
	}
	return changed
}

func aliasLocalErrorsImport(src string) string {
	importRe := regexp.MustCompile(`(?m)^(\s*)("([^"]*/internal/errors)")\s*$`)
	if !importRe.MatchString(src) {
		return src
	}
	updated := importRe.ReplaceAllString(src, `${1}dberrors $2`)
	for _, selector := range localErrorPackageSelectors() {
		updated = strings.ReplaceAll(updated, "errors."+selector, "dberrors."+selector)
	}
	return updated
}

func localErrorPackageSelectors() []string {
	return []string{
		"APIForbidden", "APIInternalError", "APIInvalidRequest", "APINotFound", "APIUnauthorized",
		"AlreadyExists", "BlockCorrupted", "BlockNotFound", "CSRMatrixError", "Canceled",
		"Code", "CompactionCancelled", "CompactionFailure", "CompactionInProgress",
		"Corruption", "DataLoss", "DeadlineExceeded", "DeltaStoreError", "E",
		"Error", "FilterCorrupted", "FlushFailure", "GraphCorrupted", "GraphEdgeNotFound",
		"GraphNodeNotFound", "HNSWBuildFailure", "HNSWSearchFailure", "IndexCorrupted",
		"IndexNotFound", "Internal", "InvalidArgument", "InvalidTransaction",
		"LevelCompactionFailure", "MVCCConflict", "ManifestCorrupted", "MemTableFlushing",
		"MemTableFull", "MemTableNotFound", "NewAlreadyExists", "NewCorruption",
		"NewInternal", "NewInvalidArgument", "NewNotFound", "NewTimeout",
		"NewUnavailable", "NewVectorDimensionMismatch", "NotFound", "PermissionDenied",
		"QuantizationError", "QueryExecutionError", "QueryParseError", "QueryPlanError",
		"ReadFailure", "ResultSetClosed", "SSTableCorrupted", "SSTableNotFound",
		"SnapshotFailure", "SnapshotNotFound", "TransactionAborted", "TransactionConflict",
		"TransactionNotFound", "TransactionTimeout", "Unavailable", "UniversalCompactionFailure",
		"Unknown", "VectorDimensionMismatch", "VectorIndexCorrupted", "VectorNotFound",
		"WalCorrupted", "WalNotFound", "WalReadFailure", "WalSyncFailure",
		"WalTruncateFailure", "WalWriteFailure", "Wrap", "WrapMessage", "WriteFailure",
	}
}

func repairGoUnexportedFieldCase(root string) int {
	changed := 0
	var changedFiles []string
	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
		if err != nil || info == nil {
			return nil
		}
		if info.IsDir() {
			switch info.Name() {
			case ".git", ".claude-go", "vendor", "node_modules":
				return filepath.SkipDir
			}
			return nil
		}
		if !strings.HasSuffix(info.Name(), ".go") {
			return nil
		}
		data, readErr := os.ReadFile(p)
		if readErr != nil {
			return nil
		}
		src := string(data)
		updated := src
		for _, field := range []string{"Schema"} {
			lower := strings.ToLower(field[:1]) + field[1:]
			if strings.Contains(src, "."+field) && regexp.MustCompile(`\b`+regexp.QuoteMeta(lower)+`\s+`).MatchString(src) {
				updated = strings.ReplaceAll(updated, "."+field, "."+lower)
			}
		}
		if updated == src {
			return nil
		}
		if err := os.WriteFile(p, []byte(updated), info.Mode()); err == nil {
			changed++
			changedFiles = append(changedFiles, p)
		}
		return nil
	})
	if len(changedFiles) > 0 {
		_ = exec.Command("gofmt", append([]string{"-w"}, changedFiles...)...).Run()
	}
	return changed
}

