{
  "model": "kimi-k2",
  "agent": "proactive-orchestrator",
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.kimi.com/coding/",
    "ANTHROPIC_MODEL": "kimi-k2",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(*)",
      "Shell(*)",
      "WebSearch",
      "WebFetch",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "LS",
      "TodoWrite",
      "Task",
      "TaskOutput",
      "TaskStop",
      "NotebookRead",
      "NotebookEdit",
      "mcp__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf /)"
    ]
  }
}