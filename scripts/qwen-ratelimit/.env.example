# Copy to .env and fill in your real key. .env should never be committed.
DASHSCOPE_API_KEY=sk-your-real-key-here

# Optional: override the default endpoint or model
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# For claude-go / coding.dashscope.aliyuncs.com endpoint (Anthropic protocol):
# DASHSCOPE_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic/v1
# QWEN_MODEL=qwen3.6-plus
# QWEN_PROTOCOL=anthropic
